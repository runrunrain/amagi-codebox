{
  "name": "amagi-codebox-mobile",
  "private": true,
  "version": "1.0.5",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-no-xterm.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/cli": "^8.2.0",
    "@capacitor/core": "^8.2.0",
    "@tanstack/vue-virtual": "3.13.35",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "html5-qrcode": "^2.3.8",
    "pinia": "3.0.4",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/compiler-sfc": "^3.5.45",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "knip": {
    "entry": [
      "scripts/audit-touch-targets.mjs",
      "scripts/audit-touch-targets.selftest.mjs",
      "scripts/check-contrast.mjs"
    ],
    "ignoreDependencies": [
      "@capacitor/android",
      "@emnapi/core",
      "@emnapi/runtime"
    ]
  }
}
