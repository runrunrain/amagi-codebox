{
  "name": "frontend",
  "private": true,
  "version": "1.3.150",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:bundle": "node scripts/check-bundle-no-xterm.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chart.js": "^4.5.1",
    "js-yaml": "^5.2.3",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "vue": "^3.2.37",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-beta.2",
    "@emnapi/runtime": "2.0.0-beta.2",
    "@eslint/js": "10.0.1",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-vue": "10.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "knip": {
    "entry": [
      "e2e/**/*.spec.ts",
      "harness/**/*.ts",
      "harness/**/*.vue",
      "playwright.stopping.config.ts",
      "harness/remote/run.playwright.mjs"
    ],
    "ignore": [
      "wailsjs/**"
    ],
    "ignoreDependencies": [
      "@playwright/test",
      "playwright",
      "@emnapi/core",
      "@emnapi/runtime"
    ]
  }
}
