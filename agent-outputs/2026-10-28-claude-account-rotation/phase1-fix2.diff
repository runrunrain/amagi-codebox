+// TestRecoverRejectsUnknownAfterClassification：R02 反例——恢复短锁内重读时
+// 某投影已被外部改为既非 before 也非 after 的值，必须拒绝、不写入任何槽位。
+func TestRecoverRejectsUnknownAfterClassification(t *testing.T) {
