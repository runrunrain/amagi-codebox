+import { describe, expect, it } from 'vitest';
+import type { ClaudeAccount, ClaudeAccountOperation, ClaudeAccountsPool } from '../../../api/claudeAccounts';
+import {
+  ENROLLMENT_STEPS,
+  accountCardActions,
