+++ b/internal/claudeaccounts/config.go
@@ -0,0 +1,91 @@
+package claudeaccounts
+
+import "fmt"
+
+// ClaudeAccountRotationConfig 是自动轮换配置值对象（design §3.2）。
+// 持久化接线（AppConfig.ClaudeAccountRotation / claude_account_rotation
+// JSON 字段、深拷贝、导入导出排除）属于后续接线任务；本文件只提供结构、
+// 默认值、区间校验与「零值 = 关闭」语义。
+type ClaudeAccountRotationConfig struct {
+	SchemaVersion           int     `json:"schema_version"`
+	Enabled                 bool    `json:"enabled"`
+	Strategy                string  `json:"strategy"`
+	ThresholdPercent        int     `json:"threshold_percent"`
+	CooldownSeconds         int     `json:"cooldown_seconds"`
+	HysteresisPoints        int     `json:"hysteresis_points"`
+	ManualRespectSeconds    int     `json:"manual_respect_seconds"`
+	AcknowledgedRiskVersion *string `json:"acknowledged_risk_version,omitempty"`
+}
+
+// 轮换策略白名单（design §6.2：v1 只做 best；未知 strategy 拒绝，不默默回退）。
+const (
+	StrategyBest            = "best"
+	rotationSchemaVersion   = 1
+	rotationMinThreshold    = 80
+	rotationMaxThreshold    = 99
+	rotationMinHysteresis   = 5
+	rotationMaxHysteresis   = 30
+	rotationMinCooldown     = 300
+	rotationMaxCooldown     = 3600
+	rotationMinRespect      = 0
+	rotationMaxRespect      = 86400
+)
+
+// DefaultRotationConfig 返回设计 §3.2 的默认值（threshold 90 / cooldown 300 /
+// hysteresis 10 / respect 3600 / strategy best / enabled false）。
+func DefaultRotationConfig() *ClaudeAccountRotationConfig {
+	return &ClaudeAccountRotationConfig{
+		SchemaVersion:        rotationSchemaVersion,
+		Enabled:              false,
+		Strategy:             StrategyBest,
+		ThresholdPercent:     90,
+		CooldownSeconds:      300,
+		HysteresisPoints:     10,
+		ManualRespectSeconds: 3600,
+	}
+}
+
+// IsZero 报告配置是否为全零值（旧配置无字段视为关闭，design §3.2/§11）。
+func (c *ClaudeAccountRotationConfig) IsZero() bool {
+	return c == nil ||
+		(c.SchemaVersion == 0 && !c.Enabled && c.Strategy == "" &&
+			c.ThresholdPercent == 0 && c.CooldownSeconds == 0 &&
+			c.HysteresisPoints == 0 && c.ManualRespectSeconds == 0 &&
+			c.AcknowledgedRiskVersion == nil)
+}
+
+// EffectiveEnabled 返回生效的启用状态：nil 或零值配置一律视为关闭。
+func (c *ClaudeAccountRotationConfig) EffectiveEnabled() bool {
+	return c != nil && !c.IsZero() && c.Enabled
+}
+
+// Validate 严格校验区间与白名单（design §3.2：后端即使前端不显示也须验证；
+// 未知 strategy 拒绝，不能默默回退）。零值配置视为「关闭」，直接通过。
+func (c *ClaudeAccountRotationConfig) Validate() error {
+	if c.IsZero() {
+		return nil
+	}
+	if c.SchemaVersion != rotationSchemaVersion {
+		return fmt.Errorf("claude_account_rotation: schema_version 必须为 %d，实际 %d", rotationSchemaVersion, c.SchemaVersion)
+	}
+	switch c.Strategy {
+	case StrategyBest:
+	case "":
+		return fmt.Errorf("claude_account_rotation: strategy 不能为空（启用前必须显式选择，白名单：%s）", StrategyBest)
+	default:
+		return fmt.Errorf("claude_account_rotation: 未知 strategy %q（白名单：%s）", c.Strategy, StrategyBest)
+	}
+	if c.ThresholdPercent < rotationMinThreshold || c.ThresholdPercent > rotationMaxThreshold {
+		return fmt.Errorf("claude_account_rotation: threshold_percent 必须在 %d..%d，实际 %d", rotationMinThreshold, rotationMaxThreshold, c.ThresholdPercent)
+	}
+	if c.HysteresisPoints < rotationMinHysteresis || c.HysteresisPoints > rotationMaxHysteresis {
+		return fmt.Errorf("claude_account_rotation: hysteresis_points 必须在 %d..%d，实际 %d", rotationMinHysteresis, rotationMaxHysteresis, c.HysteresisPoints)
+	}
+	if c.CooldownSeconds < rotationMinCooldown || c.CooldownSeconds > rotationMaxCooldown {
+		return fmt.Errorf("claude_account_rotation: cooldown_seconds 必须在 %d..%d，实际 %d", rotationMinCooldown, rotationMaxCooldown, c.CooldownSeconds)
+	}
+	if c.ManualRespectSeconds < rotationMinRespect || c.ManualRespectSeconds > rotationMaxRespect {
+		return fmt.Errorf("claude_account_rotation: manual_respect_seconds 必须在 %d..%d，实际 %d", rotationMinRespect, rotationMaxRespect, c.ManualRespectSeconds)
+	}
+	return nil
+}
diff --git a/internal/claudeaccounts/config_test.go b/internal/claudeaccounts/config_test.go
new file mode 100644
index 0000000..8a896aa
--- /dev/null
+++ b/internal/claudeaccounts/config_test.go
@@ -0,0 +1,90 @@
+package claudeaccounts
+
+import "testing"
+
+// 配置值对象（design §3.2）：字段与区间校验、策略白名单、零值=关闭。
+
+func TestDefaultRotationConfig(t *testing.T) {
+	cfg := DefaultRotationConfig()
+	if err := cfg.Validate(); err != nil {
+		t.Fatalf("默认配置应合法: %v", err)
+	}
+	if cfg.SchemaVersion != 1 || cfg.Strategy != StrategyBest || cfg.ThresholdPercent != 90 ||
+		cfg.CooldownSeconds != 300 || cfg.HysteresisPoints != 10 || cfg.ManualRespectSeconds != 3600 {
+		t.Fatalf("默认值与设计 §3.2 不符: %+v", cfg)
+	}
+	if cfg.Enabled {
+		t.Fatal("默认应为关闭")
+	}
+}
+
+func TestRotationConfigZeroMeansDisabled(t *testing.T) {
+	var nilCfg *ClaudeAccountRotationConfig
+	if !nilCfg.IsZero() || nilCfg.EffectiveEnabled() {
+		t.Fatal("nil 配置应为零值/关闭")
+	}
+	var zero ClaudeAccountRotationConfig
+	if !zero.IsZero() || zero.EffectiveEnabled() {
+		t.Fatal("全零配置应为零值/关闭")
+	}
+	if err := zero.Validate(); err != nil {
+		t.Fatalf("零值配置应直接通过（视为关闭）: %v", err)
+	}
+	enabled := DefaultRotationConfig()
+	enabled.Enabled = true
+	if !enabled.EffectiveEnabled() {
+		t.Fatal("enabled 配置应生效")
+	}
+}
+
+func TestRotationConfigRanges(t *testing.T) {
+	cases := []struct {
+		name   string
+		mutate func(*ClaudeAccountRotationConfig)
+	}{
+		{"threshold 过低", func(c *ClaudeAccountRotationConfig) { c.ThresholdPercent = 79 }},
+		{"threshold 过高", func(c *ClaudeAccountRotationConfig) { c.ThresholdPercent = 100 }},
+		{"hysteresis 过低", func(c *ClaudeAccountRotationConfig) { c.HysteresisPoints = 4 }},
+		{"hysteresis 过高", func(c *ClaudeAccountRotationConfig) { c.HysteresisPoints = 31 }},
+		{"cooldown 过低", func(c *ClaudeAccountRotationConfig) { c.CooldownSeconds = 299 }},
+		{"cooldown 过高", func(c *ClaudeAccountRotationConfig) { c.CooldownSeconds = 3601 }},
+		{"respect 负值", func(c *ClaudeAccountRotationConfig) { c.ManualRespectSeconds = -1 }},
+		{"respect 过高", func(c *ClaudeAccountRotationConfig) { c.ManualRespectSeconds = 86401 }},
+		{"未知 strategy", func(c *ClaudeAccountRotationConfig) { c.Strategy = "consume-first" }},
+		{"空 strategy", func(c *ClaudeAccountRotationConfig) { c.Strategy = "" }},
+		{"未知 schema", func(c *ClaudeAccountRotationConfig) { c.SchemaVersion = 2 }},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := DefaultRotationConfig()
+			tc.mutate(cfg)
+			if err := cfg.Validate(); err == nil {
+				t.Fatal("期望校验失败")
+			}
+		})
+	}
+	// 边界值本身合法。
+	for _, cfg := range []*ClaudeAccountRotationConfig{
+		{SchemaVersion: 1, Strategy: StrategyBest, ThresholdPercent: 80, HysteresisPoints: 5, CooldownSeconds: 300, ManualRespectSeconds: 0},
+		{SchemaVersion: 1, Strategy: StrategyBest, ThresholdPercent: 99, HysteresisPoints: 30, CooldownSeconds: 3600, ManualRespectSeconds: 86400},
+	} {
+		if err := cfg.Validate(); err != nil {
+			t.Fatalf("边界配置应合法: %v", err)
+		}
+	}
+}
+
+func TestMaskEmail(t *testing.T) {
+	cases := []struct{ in, want string }{
+		{"user@example.com", "us***@example.com"},
+		{"ab@example.com", "a***@example.com"},
+		{"x@example.com", "x***@example.com"},
+		{"not-an-email", "***"},
+		{"", ""},
+	}
+	for _, tc := range cases {
+		if got := MaskEmail(tc.in); got != tc.want {
+			t.Errorf("MaskEmail(%q) = %q, want %q", tc.in, got, tc.want)
+		}
+	}
+}
diff --git a/internal/claudeaccounts/fakes_test.go b/internal/claudeaccounts/fakes_test.go
new file mode 100644
index 0000000..284be4b
--- /dev/null
+++ b/internal/claudeaccounts/fakes_test.go
@@ -0,0 +1,527 @@
+package claudeaccounts
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+// 测试 fixture 全部使用合成字符串（design §10.1：OAuth fixture 全用合成
+// 字符串，不保存真实 token；存储与路径全部依赖注入）。
+
+const (
+	syntheticUUIDA = "11111111-1111-4111-8111-111111111111"
+	syntheticUUIDB = "22222222-2222-4222-8222-222222222222"
+	syntheticOrgA  = "org-aaaaaaaa"
+	syntheticOrgB  = "org-bbbbbbbb"
+)
+
+// syntheticKeychainItem 构造合成 Claude Code Keychain 项（含未知兄弟字段）。
+func syntheticKeychainItem(ccToken string) []byte {
+	return []byte(fmt.Sprintf(`{
+  "claudeAiOauth": {"accessToken": %q, "refreshToken": "ccr-%s"},
+  "otherSibling": {"keep": true}
+}`, ccToken, ccToken))
+}
+
+// syntheticClaudeJSON 构造合成 .claude.json（含非受管字段）。
+func syntheticClaudeJSON(accountUUID, userID, email string) []byte {
+	return []byte(fmt.Sprintf(`{
+  "oauthAccount": {"accountUuid": %q, "emailAddress": %q, "emailAddressVerified": true},
+  "userID": %q,
+  "projects": {"/tmp/demo": {"allowedTools": ["Read"]}},
+  "firstStartTime": "2026-01-01T00:00:00Z",
+  "isQualifiedForDataSharing": true
+}`, accountUUID, email, userID))
+}
+
+// syntheticPiAuth 构造合成 auth.json（anthropic + 其他 provider）。
+func syntheticPiAuth(piToken string, expiresMS int64) []byte {
+	return []byte(fmt.Sprintf(`{
+  "anthropic": {"type": "oauth", "access": %q, "refresh": "pir-%s", "expires": %d},
+  "openai": {"type": "api_key", "key": "sk-synthetic"},
+  "google": {"type": "api_key", "key": "g-synthetic"}
+}`, piToken, piToken, expiresMS))
+}
+
+func futureExpiresMS(now time.Time) int64 { return now.Add(6 * time.Hour).UnixMilli() }
+
+// ---- fake 池存储 ----
+
+type fakePoolStore struct {
+	mu        sync.Mutex
+	envelope  []byte
+	loadErr   error
+	saveErrAt int // 第 N 次 Save（1-based）失败；0=不失败
+	saveCalls int
+}
+
+func (f *fakePoolStore) Load(ctx context.Context) (*AccountPool, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.loadErr != nil {
+		return nil, f.loadErr
+	}
+	if f.envelope == nil {
+		return nil, nil // 从未创建
+	}
+	return DecodePoolEnvelope(f.envelope)
+}
+
+func (f *fakePoolStore) Save(ctx context.Context, pool *AccountPool) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.saveCalls++
+	if f.saveErrAt == f.saveCalls {
+		return NewErr(ReasonPoolCorrupt, "注入的保存失败")
+	}
+	data, err := encodePoolEnvelope(pool)
+	if err != nil {
+		return err
+	}
+	f.envelope = data
+	// 与真实 Keychain 后端一致：保存后回读验证。
+	reloaded, err := DecodePoolEnvelope(f.envelope)
+	if err != nil {
+		return err
+	}
+	return verifySavedPool(reloaded, pool)
+}
+
+func (f *fakePoolStore) Kind() string { return "memory" }
+
+func (f *fakePoolStore) saveCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.saveCalls
+}
+
+// ---- fake Claude Code Keychain ----
+
+type fakeKCItem struct {
+	account string
+	data    []byte
+}
+
+type fakeKeychain struct {
+	mu           sync.Mutex
+	items        []fakeKCItem
+	locateErr    error
+	readErr      error
+	updateErrAt  int // 第 N 次 UpdateItem 失败；0=不失败
+	updateCalls  int
+}
+
+func (f *fakeKeychain) LocateItem(ctx context.Context) (*KeychainLocator, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.locateErr != nil {
+		return nil, f.locateErr
+	}
+	switch len(f.items) {
+	case 0:
+		return nil, NewErr(ReasonNeedsLogin, "Claude Code Keychain 凭据项不存在（未登录或已登出）")
+	case 1:
+		return &KeychainLocator{Service: ClaudeKeychainServiceName, Account: f.items[0].account}, nil
+	default:
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain service 匹配 %d 项，无法唯一定位", len(f.items))
+	}
+}
+
+func (f *fakeKeychain) find(account string) *fakeKCItem {
+	for i := range f.items {
+		if f.items[i].account == account {
+			return &f.items[i]
+		}
+	}
+	return nil
+}
+
+func (f *fakeKeychain) ReadItem(ctx context.Context, loc *KeychainLocator) ([]byte, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.readErr != nil {
+		return nil, f.readErr
+	}
+	item := f.find(loc.Account)
+	if item == nil {
+		return nil, NewErr(ReasonNeedsLogin, "Claude Code Keychain 凭据项不存在")
+	}
+	return append([]byte(nil), item.data...), nil
+}
+
+func (f *fakeKeychain) UpdateItem(ctx context.Context, loc *KeychainLocator, item []byte) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.updateCalls++
+	if f.updateErrAt == f.updateCalls {
+		return NewErr(ReasonNeedsReconcile, "注入的 Keychain 更新失败")
+	}
+	target := f.find(loc.Account)
+	if target == nil {
+		return NewErr(ReasonNeedsLogin, "Claude Code Keychain 凭据项不存在")
+	}
+	target.data = append([]byte(nil), item...)
+	return nil
+}
+
+func (f *fakeKeychain) updateCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.updateCalls
+}
+
+// ---- fake admission / 静止条件 / 身份 / 时钟 ----
+
+type fakeGate struct {
+	mu   sync.Mutex
+	held int
+	deny bool
+}
+
+func (f *fakeGate) Acquire(ctx context.Context, why string) (func(), error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	if f.deny {
+		return nil, NewErr(ReasonSessionsActive, "注入：存在运行中会话")
+	}
+	f.held++
+	released := false
+	return func() {
+		if released {
+			return
+		}
+		released = true
+		f.mu.Lock()
+		f.held--
+		f.mu.Unlock()
+	}, nil
+}
+
+type fakeQuiescence struct {
+	mu  sync.Mutex
+	err error
+}
+
+func (f *fakeQuiescence) Check(ctx context.Context) error {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.err
+}
+
+type fakeIdentity struct {
+	mu        sync.Mutex
+	responses map[string]ProfileIdentity // token → 身份
+	calls     int
+}
+
+func (f *fakeIdentity) FetchProfile(ctx context.Context, accessToken string) (ProfileIdentity, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.calls++
+	if id, ok := f.responses[accessToken]; ok {
+		return id, nil
+	}
+	return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "注入：token 无已知身份")
+}
+
+func (f *fakeIdentity) callCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return f.calls
+}
+
+type fakeClock struct {
+	mu  sync.Mutex
+	now time.Time
+}
+
+func (c *fakeClock) Now() time.Time {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.now
+}
+
+// ---- 故障注入文件操作 ----
+
+type failOps struct {
+	inner    writeFileOps
+	failStep string // create-temp/chmod-temp/write-temp/sync-temp/close-temp/rename/sync-directory
+	failAt   int    // 第 N 次该步骤调用失败（跨所有步骤累计计数）；0=不失败
+	calls    map[string]int
+}
+
+func newFailOps(failStep string, failAt int) *failOps {
+	return &failOps{inner: osWriteFileOps{}, failStep: failStep, failAt: failAt, calls: map[string]int{}}
+}
+
+func (o *failOps) tick(step string) bool {
+	o.calls[step]++
+	return o.failStep == step && o.calls[step] == o.failAt
+}
+
+func (o *failOps) CreateTemp(dir, pattern string) (*os.File, error) {
+	if o.tick("create-temp") {
+		return nil, fmt.Errorf("injected create-temp failure")
+	}
+	return o.inner.CreateTemp(dir, pattern)
+}
+func (o *failOps) Sync(f *os.File) error {
+	if o.tick("sync-temp") {
+		return fmt.Errorf("injected sync failure")
+	}
+	return o.inner.Sync(f)
+}
+func (o *failOps) Close(f *os.File) error {
+	if o.tick("close-temp") {
+		return fmt.Errorf("injected close failure")
+	}
+	return o.inner.Close(f)
+}
+func (o *failOps) Rename(oldPath, newPath string) error {
+	if o.tick("rename") {
+		return fmt.Errorf("injected rename failure")
+	}
+	return o.inner.Rename(oldPath, newPath)
+}
+func (o *failOps) Remove(path string) error { return o.inner.Remove(path) }
+func (o *failOps) Chmod(path string, mode os.FileMode) error {
+	if o.tick("chmod-target") {
+		return fmt.Errorf("injected chmod failure")
+	}
+	return o.inner.Chmod(path, mode)
+}
+func (o *failOps) SyncDir(dir string) error {
+	if o.tick("sync-directory") {
+		return fmt.Errorf("injected directory sync failure")
+	}
+	return o.inner.SyncDir(dir)
+}
+
+// ---- fake HTTP transport ----
+
+type fakeTransport struct {
+	mu      sync.Mutex
+	handler func(req *http.Request) (*http.Response, error)
+	calls   []*http.Request
+}
+
+func (f *fakeTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	f.mu.Lock()
+	f.calls = append(f.calls, req)
+	handler := f.handler
+	f.mu.Unlock()
+	if handler == nil {
+		return nil, fmt.Errorf("injected transport failure")
+	}
+	return handler(req)
+}
+
+func (f *fakeTransport) callCount() int {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	return len(f.calls)
+}
+
+func httpResponse(status int, body string) *http.Response {
+	return &http.Response{
+		StatusCode: status,
+		Body:       io.NopCloser(strings.NewReader(body)),
+		Header:     make(http.Header),
+	}
+}
+
+// ---- 测试环境 ----
+
+type testEnv struct {
+	t          *testing.T
+	dir        string
+	home       string
+	pool       *fakePoolStore
+	keychain   *fakeKeychain
+	files      *FileCredentialStore
+	filesOps   writeFileOps
+	gate       *fakeGate
+	quiescence *fakeQuiescence
+	identity   IdentityProvider
+	identityFake *fakeIdentity
+	clock      *fakeClock
+	transport  *fakeTransport
+	svc        *Service
+	native     NativeCredentialStore
+	nativeOverride NativeCredentialStore
+	logs       []string
+	events     []Event
+	logMu      sync.Mutex
+}
+
+// newTestEnv 建立账号 A 的合成双端登录环境并构造 Service。
+func newTestEnv(t *testing.T) *testEnv {
+	t.Helper()
+	dir := t.TempDir()
+	env := &testEnv{
+		t:          t,
+		dir:        dir,
+		home:       filepath.Join(dir, "home"),
+		pool:       &fakePoolStore{},
+		keychain:   &fakeKeychain{},
+		gate:       &fakeGate{},
+		quiescence: &fakeQuiescence{},
+		identityFake: &fakeIdentity{responses: map[string]ProfileIdentity{}},
+		clock:      &fakeClock{now: time.Date(2026, 10, 28, 12, 0, 0, 0, time.UTC)},
+		transport:  &fakeTransport{},
+	}
+	env.identity = env.identityFake
+	env.filesOps = osWriteFileOps{}
+	env.seedAccountA()
+	env.rebuildService()
+	return env
+}
+
+// seedAccountA 写入账号 A 的三处原生投影与身份映射。
+func (e *testEnv) seedAccountA() {
+	e.t.Helper()
+	if err := os.MkdirAll(filepath.Join(e.home, ".pi", "agent"), 0o755); err != nil {
+		e.t.Fatal(err)
+	}
+	if err := os.WriteFile(e.claudeJSONPath(), syntheticClaudeJSON(syntheticUUIDA, "user-amagi-a", "a@example.com"), 0o644); err != nil {
+		e.t.Fatal(err)
+	}
+	if err := os.WriteFile(e.piAuthPath(), syntheticPiAuth("pi-a-1", futureExpiresMS(e.clock.Now())), 0o644); err != nil {
+		e.t.Fatal(err)
+	}
+	e.keychain.items = []fakeKCItem{{account: "claude", data: syntheticKeychainItem("cc-a-1")}}
+	e.identityFake.responses["cc-a-1"] = ProfileIdentity{AccountUUID: syntheticUUIDA, OrganizationUUID: syntheticOrgA, SeatTier: "max"}
+	e.identityFake.responses["pi-a-1"] = ProfileIdentity{AccountUUID: syntheticUUIDA, OrganizationUUID: syntheticOrgA, SeatTier: "max"}
+}
+
+// seedAccountB 把原生槽位整体换为账号 B（模拟外部登录 B）。
+func (e *testEnv) seedAccountB() {
+	e.t.Helper()
+	if err := os.WriteFile(e.claudeJSONPath(), syntheticClaudeJSON(syntheticUUIDB, "user-amagi-b", "b@example.com"), 0o644); err != nil {
+		e.t.Fatal(err)
+	}
+	if err := os.WriteFile(e.piAuthPath(), syntheticPiAuth("pi-b-1", futureExpiresMS(e.clock.Now())), 0o644); err != nil {
+		e.t.Fatal(err)
+	}
+	e.keychain.items = []fakeKCItem{{account: "claude", data: syntheticKeychainItem("cc-b-1")}}
+	e.identityFake.responses["cc-b-1"] = ProfileIdentity{AccountUUID: syntheticUUIDB, OrganizationUUID: syntheticOrgB, SeatTier: "pro"}
+	e.identityFake.responses["pi-b-1"] = ProfileIdentity{AccountUUID: syntheticUUIDB, OrganizationUUID: syntheticOrgB, SeatTier: "pro"}
+}
+
+// enrollAccountB 完整走一遍录入 B（capture A → begin → 换原生 → capture B）。
+func (e *testEnv) enrollAccountB() (idA, idB string) {
+	e.t.Helper()
+	ctx := context.Background()
+	dtoA, err := e.svc.CaptureFirstAccount(ctx, "account-a", 0)
+	if err != nil {
+		e.t.Fatalf("capture A: %v", err)
+	}
+	idA = dtoA.ID
+	pool, err := e.svc.LoadPool(ctx)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	enrollID, err := e.svc.BeginEnrollment(ctx, pool.Revision)
+	if err != nil {
+		e.t.Fatalf("begin enrollment: %v", err)
+	}
+	pool, err = e.svc.LoadPool(ctx)
+	if err != nil {
+		e.t.Fatal(err)
+	}
+	e.seedAccountB()
+	dtoB, err := e.svc.CaptureEnrolledAccount(ctx, enrollID, "account-b", pool.Revision)
+	if err != nil {
+		e.t.Fatalf("capture B: %v", err)
+	}
+	return idA, dtoB.ID
+}
+
+func (e *testEnv) claudeJSONPath() string { return filepath.Join(e.home, ".claude.json") }
+func (e *testEnv) piAuthPath() string    { return filepath.Join(e.home, ".pi", "agent", "auth.json") }
+
+// rebuildService 按当前注入重建 Service（文件 ops/native 变更后调用）。
+func (e *testEnv) rebuildService() {
+	e.t.Helper()
+	e.files = NewFileCredentialStore(FileCredentialPaths{ClaudeJSONPath: e.claudeJSONPath(), PiAuthPath: e.piAuthPath()}, e.filesOps)
+	native := NativeCredentialStore(NewCombinedNativeStore(e.files, e.keychain))
+	e.native = native
+	if e.nativeOverride != nil {
+		native = e.nativeOverride
+	}
+	e.logMu.Lock()
+	logs, events := e.logs, e.events
+	e.logMu.Unlock()
+	svc, err := NewService(Deps{
+		Pool:       e.pool,
+		Native:     native,
+		LockPath:   filepath.Join(e.dir, "lock", "claude-accounts.lock"),
+		PiAuthPath: e.piAuthPath(),
+		Gate:       e.gate,
+		Quiescence: e.quiescence,
+		Identity:   e.identity,
+		HTTPClient: NewConstrainedHTTPClient(e.transport),
+		Clock:      e.clock.Now,
+		Logf: func(format string, args ...any) {
+			e.logMu.Lock()
+			defer e.logMu.Unlock()
+			logs = append(logs, fmt.Sprintf(format, args...))
+			e.logs = logs
+		},
+		EmitEvent: func(ev Event) {
+			e.logMu.Lock()
+			defer e.logMu.Unlock()
+			events = append(events, ev)
+			e.events = events
+		},
+	})
+	if err != nil {
+		e.t.Fatalf("NewService: %v", err)
+	}
+	e.svc = svc
+}
+
+func (e *testEnv) allLogs() []string {
+	e.logMu.Lock()
+	defer e.logMu.Unlock()
+	return append([]string(nil), e.logs...)
+}
+
+// svcNative 返回当前底层 native 适配器。
+func (e *testEnv) svcNative() NativeCredentialStore { return e.native }
+
+// setNative 注入 native 包装器并重建 Service。
+func (e *testEnv) setNative(n NativeCredentialStore) {
+	e.nativeOverride = n
+	e.rebuildService()
+}
+
+// readJSON 读文件并校验 JSON。
+func readJSON(t *testing.T, path string) []byte {
+	t.Helper()
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+// assertReason 断言错误 reason。
+func assertReason(t *testing.T, err error, want Reason) {
+	t.Helper()
+	if err == nil {
+		t.Fatalf("期望错误 %s，实际 nil", want)
+	}
+	got := ReasonOf(err)
+	if got != want {
+		t.Fatalf("期望错误 reason %s，实际 %s（%v）", want, got, err)
+	}
+}
diff --git a/internal/claudeaccounts/harvest.go b/internal/claudeaccounts/harvest.go
new file mode 100644
index 0000000..74297c7
--- /dev/null
+++ b/internal/claudeaccounts/harvest.go
@@ -0,0 +1,419 @@
+package claudeaccounts
+
+import (
+	"context"
+	"time"
+
+	"github.com/tidwall/gjson"
+)
+
+// standbyRefreshMargin 是 standby grant 换入前的提前刷新边距（与 Pi 自身
+// 的 5 分钟安全窗一致，design §5.1）。
+const standbyRefreshMargin = 5 * time.Minute
+
+// SwapReasonRecovered 是恢复路径补记的切换原因（journal 本身不存 reason，
+// design §3.3；恢复完成不是一次新的手动切换）。
+const SwapReasonRecovered = "recovered"
+
+// HarvestActive 是“更新当前登录”入口：回收活动账号原生槽位的最新值
+// （design §7.1）。expectedRevision 用于并发防护。
+func (s *Service) HarvestActive(ctx context.Context, expectedRevision uint64) (AccountDTO, error) {
+	release, err := s.withLocks(ctx, "harvest")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	if pool == nil || pool.ActiveAccountID == "" {
+		return AccountDTO{}, NewErr(ReasonPoolMissing, "账号池未启用")
+	}
+	if pool.Transaction != nil {
+		return AccountDTO{}, NewErr(ReasonNeedsReconcile, "池存在未结事务，先完成恢复")
+	}
+	if pool.Revision != expectedRevision {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	gateRelease, err := s.acquireGate(ctx, "harvest")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer gateRelease()
+	if err := s.checkQuiescence(ctx); err != nil {
+		return AccountDTO{}, err
+	}
+	if _, _, err := s.harvestLocked(ctx, pool, pool.ActiveAccountID); err != nil {
+		return AccountDTO{}, err
+	}
+	snap := pool.Account(pool.ActiveAccountID)
+	return snap.ToDTO(pool.ActiveAccountID), nil
+}
+
+// harvestLocked 是 harvest 伪码（design §4.4）。前置：持有串行锁、mutation
+// admission、写入者静止条件（由调用方保证）。返回当前受管投影与 revision。
+func (s *Service) harvestLocked(ctx context.Context, pool *AccountPool, activeID string) (OwnedProjections, ExpectedRevisions, error) {
+	active := pool.Account(activeID)
+	if active == nil {
+		return OwnedProjections{}, ExpectedRevisions{}, NewErr(ReasonPoolCorrupt, "活动账号不存在于池")
+	}
+	current, err := s.readStableAll(ctx)
+	if err != nil {
+		return OwnedProjections{}, ExpectedRevisions{}, err
+	}
+	owned := ownedFromNative(current)
+
+	// 校验 current 的账号属于 activeId；不是则返回 EXTERNAL_ACCOUNT_CHANGE。
+	if projectionsEqual(owned, active.OwnedProjectionsOf()) {
+		// 无变化：不写池（mtime 变化可能来自 Codex 等其他条目，design §4.3）。
+		return owned, current.Revisions, nil
+	}
+	ccID, piID, err := s.fetchPairedIdentity(ctx, current)
+	if err != nil {
+		return OwnedProjections{}, ExpectedRevisions{}, err
+	}
+	if ccID.AccountUUID != active.Identity.AccountUUID || piID.AccountUUID != active.Identity.AccountUUID {
+		return OwnedProjections{}, ExpectedRevisions{}, NewErr(ReasonExternalAccountChange, "原生槽位已不属于活动账号")
+	}
+
+	// 对每个 grant 独立比较并保存新值（不拿 Pi 的 expires 与 CC 的互比）。
+	nowT := s.now()
+	if !equalJSON(current.ClaudeOAuth, active.Claude.OauthProjection) {
+		active.Claude.OauthProjection = append([]byte(nil), current.ClaudeOAuth...)
+		active.Claude.RawCredentialItem = append([]byte(nil), current.ClaudeOAuthRaw...)
+		active.Claude.StoreLocator = current.Locator
+		active.Claude.AdapterVersion = ClaudeKeychainAdapterVersion
+		active.Claude.ObservedAt = nowT
+		active.Claude.RevisionFingerprint = current.Revisions.ClaudeKeychain
+	}
+	if current.ClaudeIdentity != nil &&
+		(!equalJSON(current.ClaudeIdentity.OauthAccount, active.ClaudeIdentity.OauthAccount) ||
+			current.ClaudeIdentity.UserID != active.ClaudeIdentity.UserID) {
+		active.ClaudeIdentity = *current.ClaudeIdentity
+	}
+	if !equalJSON(current.PiAnthropic, active.Pi.Anthropic) {
+		active.Pi.Anthropic = append([]byte(nil), current.PiAnthropic...)
+		active.Pi.AdapterVersion = PiRefreshAdapterVersion
+		active.Pi.ObservedAt = nowT
+		active.Pi.SourceMtimeNS = current.Revisions.PiAuth.MtimeNS
+		active.Pi.RevisionFingerprint = current.Revisions.PiAuth
+	}
+	active.UpdatedAt = nowT
+	active.Health.IdentityStatus = "verified"
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		// 池保存失败：harvest 不写原生槽位，直接失败返回。
+		return OwnedProjections{}, ExpectedRevisions{}, err
+	}
+	s.logStep("harvest-saved", "", activeID)
+	return owned, current.Revisions, nil
+}
+
+// ownedFromNative 把原生读取结果整理为受管投影组。
+func ownedFromNative(current *NativeProjections) OwnedProjections {
+	owned := OwnedProjections{PiAnthropic: current.PiAnthropic}
+	if len(current.ClaudeOAuth) > 0 {
+		owned.ClaudeOAuth = current.ClaudeOAuth
+	}
+	if current.ClaudeIdentity != nil {
+		fields := *current.ClaudeIdentity
+		owned.ClaudeIdentity = &fields
+	}
+	return owned
+}
+
+// ensureTargetReadyLocked 准备目标：独占刷新过期的 standby grants；验证
+// 目标双端身份（design §4.4）。调用方持锁与 admission。
+func (s *Service) ensureTargetReadyLocked(ctx context.Context, pool *AccountPool, targetID string) error {
+	if pool.ActiveAccountID == targetID {
+		return nil // 切到自身无需准备
+	}
+	snap := pool.Account(targetID)
+	if snap == nil {
+		return NewErr(ReasonRevisionConflict, "目标账号不存在")
+	}
+	// 身份证据：capture 时建立的双端配对证据必须存在且自洽。
+	ev := snap.IdentityEvidence
+	if ev == nil || ev.CCAccountUUID == "" || ev.CCAccountUUID != ev.PiAccountUUID ||
+		snap.Identity.AccountUUID != ev.CCAccountUUID {
+		return NewErr(ReasonIdentityUnverified, "目标账号缺少有效的双端身份证据")
+	}
+	// 健康度门禁：needs-login / refresh-uncertain / quarantined 不做候选。
+	if err := grantHealthGate(snap.Health.ClaudeGrant, "claude"); err != nil {
+		return err
+	}
+	if err := grantHealthGate(snap.Health.PiGrant, "pi"); err != nil {
+		return err
+	}
+	// 过期 standby grant 换入前按需刷新（design §5.1）。
+	refreshed := false
+	if piGrantExpired(snap, s.now()) {
+		if err := s.refreshStandbyGrantLocked(ctx, pool, targetID, GrantPi); err != nil {
+			return err
+		}
+		refreshed = true
+	}
+	if claudeGrantExpired(snap, s.now()) {
+		if err := s.refreshStandbyGrantLocked(ctx, pool, targetID, GrantClaude); err != nil {
+			return err
+		}
+		refreshed = true
+	}
+	if refreshed {
+		snap = pool.Account(targetID)
+		if snap == nil {
+			return NewErr(ReasonPoolCorrupt, "刷新后目标账号丢失")
+		}
+		if err := grantHealthGate(snap.Health.PiGrant, "pi"); err != nil {
+			return err
+		}
+		if err := grantHealthGate(snap.Health.ClaudeGrant, "claude"); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func grantHealthGate(health GrantHealth, kind string) error {
+	switch health {
+	case HealthReady, HealthExpired:
+		return nil // expired 由刷新流程处理；刷新后仍 expired 会在刷新错误中暴露
+	case HealthNeedsLogin:
+		return NewErr(ReasonNeedsLogin, "%s grant 需要重新登录", kind)
+	case HealthRefreshUncertain, HealthQuarantined:
+		return NewErr(ReasonRefreshUncertain, "%s grant 刷新结果不确定，已退出自动候选", kind)
+	default:
+		return NewErr(ReasonIdentityUnverified, "%s grant 健康状态未知", kind)
+	}
+}
+
+// piGrantExpired 按 anthropic.expires（毫秒 epoch，已核实契约）判断。
+func piGrantExpired(snap *AccountSnapshot, now time.Time) bool {
+	ms := gjson.GetBytes(snap.Pi.Anthropic, "expires").Float()
+	if ms <= 0 {
+		return false
+	}
+	return time.UnixMilli(int64(ms)).Before(now.Add(standbyRefreshMargin))
+}
+
+// claudeGrantExpired 按 OAuth 投影内 expiresAt 判断。【待实测】字段名与
+// 单位未验证（design §5.1）；字段缺失时视为未过期，由健康度与真机验证
+// 兜底，不猜测契约。
+func claudeGrantExpired(snap *AccountSnapshot, now time.Time) bool {
+	ms := gjson.GetBytes(snap.Claude.OauthProjection, "expiresAt").Float()
+	if ms <= 0 {
+		return false
+	}
+	// 若为秒级会远小于当前毫秒，同样判定过期，由刷新流程给出明确错误。
+	return time.UnixMilli(int64(ms)).Before(now.Add(standbyRefreshMargin))
+}
+
+// RefreshStandbyGrant 独占刷新一个 standby 账号的指定 grant（design §5.1）。
+func (s *Service) RefreshStandbyGrant(ctx context.Context, accountID string, kind GrantKind) error {
+	release, err := s.withLocks(ctx, "refresh-grant")
+	if err != nil {
+		return err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return err
+	}
+	return s.refreshStandbyGrantLocked(ctx, pool, accountID, kind)
+}
+
+// refreshStandbyGrantLocked 执行 RefreshIntent → POST → 校验 → 新 grant 与
+// 清 intent 一次存池的单事务（design §5.1）。调用方持锁。
+func (s *Service) refreshStandbyGrantLocked(ctx context.Context, pool *AccountPool, accountID string, kind GrantKind) error {
+	snap := pool.Account(accountID)
+	if snap == nil {
+		return NewErr(ReasonRevisionConflict, "目标账号不存在")
+	}
+	if pool.ActiveAccountID == accountID {
+		return NewErr(ReasonSessionsActive, "活动账号 grant 由原生客户端刷新，CodeBox 不主动 refresh（design §5.1）")
+	}
+
+	var result GrantRefreshResult
+	var err error
+	requestID, idErr := newRandomID()
+	if idErr != nil {
+		return idErr
+	}
+	intent := &RefreshIntent{
+		AccountID:        accountID,
+		GrantKind:        kind,
+		ExpectedRevision: pool.Revision,
+		RequestID:        requestID,
+		StartedAt:        s.now(),
+	}
+	pool.RefreshIntent = intent
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return err // intent 尚未发出请求，保存失败即中止，无 uncertain 风险
+	}
+
+	switch kind {
+	case GrantPi:
+		refreshToken := gjson.GetBytes(snap.Pi.Anthropic, "refresh").String()
+		if refreshToken == "" {
+			return NewErr(ReasonNeedsLogin, "Pi grant 缺少 refresh token")
+		}
+		result, err = s.piRefresh.Refresh(ctx, refreshToken)
+	case GrantClaude:
+		// 【待实测】CC 投影内 refresh token 字段名未验证；适配器本身有
+		// 协议门，不猜常量（design §5.1）。
+		refreshToken := gjson.GetBytes(snap.Claude.OauthProjection, "refreshToken").String()
+		if refreshToken == "" {
+			return NewErr(ReasonUnsupportedCredentialSchema, "Claude grant 缺少可识别的 refresh token 字段（契约待验证）")
+		}
+		result, err = s.ccRefresh.Refresh(ctx, refreshToken)
+	default:
+		return NewErr(ReasonRevisionConflict, "未知 grant 类型 %q", string(kind))
+	}
+
+	if err != nil {
+		switch ReasonOf(err) {
+		case ReasonNeedsLogin:
+			// invalid_grant：确定失败，标 needs-login 并清 intent。
+			markGrantHealth(snap, kind, HealthNeedsLogin)
+			pool.RefreshIntent = nil
+			pool.Revision++
+			if saveErr := s.savePoolLocked(ctx, pool); saveErr != nil {
+				return saveErr
+			}
+			return err
+		default:
+			// 响应丢失/取消/未验证门：未结 intent 一律 refresh-uncertain
+			// 并退出自动候选（design §5.1）。
+			markGrantHealth(snap, kind, HealthRefreshUncertain)
+			pool.Revision++
+			if saveErr := s.savePoolLocked(ctx, pool); saveErr != nil {
+				return saveErr
+			}
+			return err
+		}
+	}
+
+	// 成功：新 grant 与清 intent 一次存池。
+	if aerr := s.applyRefreshResultLocked(pool, snap, kind, result); aerr != nil {
+		// 请求已发出而结果无法安全入池 → refresh-uncertain（design §5.1）。
+		markGrantHealth(snap, kind, HealthRefreshUncertain)
+		pool.Revision++
+		if saveErr := s.savePoolLocked(ctx, pool); saveErr != nil {
+			return saveErr
+		}
+		return NewErr(ReasonRefreshUncertain, "刷新结果写入池失败，结果不确定")
+	}
+	pool.RefreshIntent = nil
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		// 保存失败：token 可能已被服务器轮换 → refresh-uncertain
+		// （design §5.1）。保留 intent 标记未结状态。
+		markGrantHealth(snap, kind, HealthRefreshUncertain)
+		s.logf("[claudeaccounts] refresh 存池失败，标记 refresh-uncertain（account=%s kind=%s）", accountID, string(kind))
+		return NewErr(ReasonRefreshUncertain, "刷新成功但存池失败，结果不确定")
+	}
+	s.logStep("refresh-completed", requestID, accountID)
+	s.emitEvent(Event{Kind: EventRefreshCompleted, TxnID: requestID, AccountID: accountID})
+	return nil
+}
+
+// applyRefreshResultLocked 把刷新结果写入账号快照（Phase 1a：Pi 路径完整；
+// CC 路径的投影内字段写回契约未验证，显式拒绝而不猜测字段）。
+func (s *Service) applyRefreshResultLocked(pool *AccountPool, snap *AccountSnapshot, kind GrantKind, result GrantRefreshResult) error {
+	nowT := s.now()
+	switch kind {
+	case GrantPi:
+		entry, err := BuildPiAnthropicEntry(result)
+		if err != nil {
+			return err
+		}
+		snap.Pi.Anthropic = entry
+		snap.Pi.AdapterVersion = s.piRefresh.AdapterVersion()
+		snap.Pi.ObservedAt = nowT
+		markGrantHealth(snap, kind, HealthReady)
+		return nil
+	case GrantClaude:
+		// 写回 claudeAiOauth 内 token 字段的契约【待实测】（design §3.1/§5.1），
+		// 在真机验证前拒绝猜测字段结构。
+		return NewErr(ReasonUnsupportedCredentialSchema, "Claude grant 刷新结果写回契约待真机验证")
+	default:
+		return NewErr(ReasonRevisionConflict, "未知 grant 类型")
+	}
+}
+
+func markGrantHealth(snap *AccountSnapshot, kind GrantKind, health GrantHealth) {
+	switch kind {
+	case GrantPi:
+		snap.Health.PiGrant = health
+	case GrantClaude:
+		snap.Health.ClaudeGrant = health
+	}
+}
+
+// RemoveAccount 移除一个非活动账号（design §7.1：移除活动账号必须先切换
+// 或停止管理；未清 journal 时禁止移除）。
+func (s *Service) RemoveAccount(ctx context.Context, id string, expectedRevision uint64) error {
+	release, err := s.withLocks(ctx, "remove-account")
+	if err != nil {
+		return err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return err
+	}
+	if pool == nil || pool.Accounts[id] == nil {
+		return NewErr(ReasonRevisionConflict, "账号不存在")
+	}
+	if pool.Transaction != nil {
+		return NewErr(ReasonNeedsReconcile, "存在未结事务，禁止移除账号")
+	}
+	if pool.ActiveAccountID == id {
+		return NewErr(ReasonRevisionConflict, "活动账号须先切换到其他账号或停止管理")
+	}
+	if pool.RefreshIntent != nil && pool.RefreshIntent.AccountID == id {
+		return NewErr(ReasonRefreshUncertain, "该账号存在未结刷新意图，禁止移除")
+	}
+	delete(pool.Accounts, id)
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return err
+	}
+	s.logStep("account-removed", "", id)
+	return nil
+}
+
+// RenameAccount 修改账号别名（design §7.2：别名长度限制 1..64）。
+func (s *Service) RenameAccount(ctx context.Context, id, alias string, expectedRevision uint64) error {
+	if len(alias) < 1 || len(alias) > 64 {
+		return NewErr(ReasonRevisionConflict, "别名长度必须在 1..64")
+	}
+	release, err := s.withLocks(ctx, "rename-account")
+	if err != nil {
+		return err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return err
+	}
+	if pool == nil {
+		return NewErr(ReasonPoolMissing, "账号池未启用")
+	}
+	snap := pool.Account(id)
+	if snap == nil {
+		return NewErr(ReasonRevisionConflict, "账号不存在")
+	}
+	if pool.Revision != expectedRevision {
+		return NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	snap.Alias = alias
+	snap.UpdatedAt = s.now()
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return err
+	}
+	return nil
+}
diff --git a/internal/claudeaccounts/httpx.go b/internal/claudeaccounts/httpx.go
new file mode 100644
index 0000000..4615342
--- /dev/null
+++ b/internal/claudeaccounts/httpx.go
@@ -0,0 +1,47 @@
+package claudeaccounts
+
+import (
+	"fmt"
+	"io"
+	"net/http"
+	"time"
+)
+
+// 网络硬约束（design §5.2）：固定 HTTPS 官方 origin、10 秒超时、最多
+// 64 KiB 响应、拒绝所有 redirect；禁用请求头/响应体日志。
+const (
+	httpRequestTimeout = 10 * time.Second
+	maxResponseBytes   = 64 << 10
+)
+
+// errRedirectRefused 是拒绝 redirect 的固定错误（不含目标 URL，避免把
+// 可能携带 token 的查询参数泄漏到日志）。
+var errRedirectRefused = fmt.Errorf("redirect refused")
+
+// NewConstrainedHTTPClient 返回受约束的固定 http.Client。transport 可注入
+// （测试注入 RoundTripper / httptest），nil 时使用默认 transport。
+// 生产端点固定 HTTPS 官方 origin；不接受 provider baseURL、用户输入 URL
+// 或镜像域（design §5.2）。
+func NewConstrainedHTTPClient(transport http.RoundTripper) *http.Client {
+	return &http.Client{
+		Timeout: httpRequestTimeout,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			return errRedirectRefused
+		},
+		Transport: transport,
+	}
+}
+
+// readBoundedBody 读取不超过 maxResponseBytes 的响应体；超限报错。
+// 错误消息不含 body 内容（敏感边界：HTTP 原文不进日志/错误消息）。
+func readBoundedBody(resp *http.Response) ([]byte, error) {
+	defer resp.Body.Close()
+	data, err := io.ReadAll(io.LimitReader(resp.Body, maxResponseBytes+1))
+	if err != nil {
+		return nil, NewErr(ReasonIdentityUnverified, "网络响应读取失败")
+	}
+	if len(data) > maxResponseBytes {
+		return nil, NewErr(ReasonIdentityUnverified, "网络响应超过 %d 字节上限", maxResponseBytes)
+	}
+	return data, nil
+}
diff --git a/internal/claudeaccounts/identity.go b/internal/claudeaccounts/identity.go
new file mode 100644
index 0000000..4cff013
--- /dev/null
+++ b/internal/claudeaccounts/identity.go
@@ -0,0 +1,108 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+)
+
+// 身份校验协议（design §4.2）。
+//
+// 【待实测】profile 端点、beta 头、响应字段、两个 grant 的 scope/组织可见
+// 性尚未在本任务中验证（design §4.2 明确标注）；解析失败一律返回
+// IDENTITY_UNVERIFIED，不得用用户勾选“同一账号”代替证明。真机验证通过
+// 前不得开放生产 capture。
+const (
+	anthropicProfileURL    = "https://api.anthropic.com/api/oauth/profile"
+	anthropicOAuthBeta     = "oauth-2025-04-20"
+	IdentityAdapterVersion = "anthropic-oauth-profile-v1"
+)
+
+// ProfileIdentity 是 profile 查询的最小身份视图：账号 UUID、组织 UUID 与
+// 套餐提示（design §4.2：只解析这三项）。
+type ProfileIdentity struct {
+	AccountUUID      string
+	OrganizationUUID string
+	SeatTier         string
+}
+
+// IdentityProvider 用一份 grant 的 access token 查询其账号身份。
+// 测试注入 fake；生产为 HTTP 实现。
+type IdentityProvider interface {
+	FetchProfile(ctx context.Context, accessToken string) (ProfileIdentity, error)
+}
+
+// HTTPIdentityProvider 是 GET /api/oauth/profile 的 HTTP 实现。
+type HTTPIdentityProvider struct {
+	client *http.Client
+}
+
+// NewHTTPIdentityProvider 构造身份适配器；client 必须来自
+// NewConstrainedHTTPClient（10s 超时、64KiB 上限、拒绝 redirect）。
+func NewHTTPIdentityProvider(client *http.Client) *HTTPIdentityProvider {
+	return &HTTPIdentityProvider{client: client}
+}
+
+// profileResponse 是响应解析契约。【待实测】字段名以真机验证为准；解析
+// 失败/缺失返回 IDENTITY_UNVERIFIED，不猜测字段。
+type profileResponse struct {
+	AccountUUID      string `json:"accountUuid"`
+	OrganizationUUID string `json:"organizationUuid"`
+	SeatTier         string `json:"seatTier"`
+}
+
+// FetchProfile 执行身份查询。任何失败（网络、状态码、解析、空 UUID）都
+// 归为 IDENTITY_UNVERIFIED；错误消息不含 token 与响应原文。
+func (p *HTTPIdentityProvider) FetchProfile(ctx context.Context, accessToken string) (ProfileIdentity, error) {
+	if accessToken == "" {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "access token 为空")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, anthropicProfileURL, nil)
+	if err != nil {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "身份请求构造失败")
+	}
+	req.Header.Set("Authorization", "Bearer "+accessToken)
+	req.Header.Set("anthropic-beta", anthropicOAuthBeta)
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := p.client.Do(req)
+	if err != nil {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "身份查询失败（网络）")
+	}
+	body, err := readBoundedBody(resp)
+	if err != nil {
+		return ProfileIdentity{}, err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "身份查询失败（HTTP %d）", resp.StatusCode)
+	}
+	var parsed profileResponse
+	if err := json.Unmarshal(body, &parsed); err != nil {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "身份响应不可解析")
+	}
+	if parsed.AccountUUID == "" {
+		return ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "身份响应缺少账号 UUID")
+	}
+	return ProfileIdentity{
+		AccountUUID:      parsed.AccountUUID,
+		OrganizationUUID: parsed.OrganizationUUID,
+		SeatTier:         parsed.SeatTier,
+	}, nil
+}
+
+// VerifyPairedIdentities 做双 grant 身份配对校验（design §4.2）：两个独立
+// grant 分别查询身份后互比，并与 `.claude.json` 的 accountUuid 比较；
+// 邮箱只展示，不作主键。expectedAccountUUID 为空时跳过与本地投影的比较
+// （capture 场景本地投影本身就是被采集对象，见 service.capture）。
+func VerifyPairedIdentities(cc, pi ProfileIdentity, expectedAccountUUID string) error {
+	if cc.AccountUUID == "" || pi.AccountUUID == "" {
+		return NewErr(ReasonIdentityUnverified, "双端身份存在未验证项")
+	}
+	if cc.AccountUUID != pi.AccountUUID {
+		return NewErr(ReasonIdentityMismatch, "Claude Code 与 Pi 不是同一账号")
+	}
+	if expectedAccountUUID != "" && cc.AccountUUID != expectedAccountUUID {
+		return NewErr(ReasonIdentityMismatch, "grant 身份与 .claude.json accountUuid 不符")
+	}
+	return nil
+}
