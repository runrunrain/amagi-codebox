+//go:build !darwin || !cgo
+
+package claudeaccounts
+
+import "context"
+
+// UnsupportedPoolStore 覆盖非 darwin（及 darwin 无 cgo）平台：设计 §8 风险
+// 表规定 v1 macOS only，Windows/WSL mutation 返回 unsupported，不回退明文。
+type UnsupportedPoolStore struct{}
+
+// NewKeychainPoolStore 在本平台返回 unsupported 后端（与 darwin 构造器同名，
+// 保证调用方跨平台一致）。测试不得用它替代 fake。
+func NewKeychainPoolStore() PoolStore {
+	return UnsupportedPoolStore{}
+}
+
+// Kind 标识后端。
+func (UnsupportedPoolStore) Kind() string { return "unsupported" }
+
+// Load 一律返回 UNSUPPORTED_PLATFORM。
+func (UnsupportedPoolStore) Load(ctx context.Context) (*AccountPool, error) {
+	_ = ctx
+	return nil, NewErr(ReasonUnsupportedPlatform, "账号池 Keychain 后端仅支持 macOS（cgo）")
+}
+
+// Save 一律返回 UNSUPPORTED_PLATFORM。
+func (UnsupportedPoolStore) Save(ctx context.Context, pool *AccountPool) error {
+	_, _ = ctx, pool
+	return NewErr(ReasonUnsupportedPlatform, "账号池 Keychain 后端仅支持 macOS（cgo）")
+}
diff --git a/internal/claudeaccounts/properlock.go b/internal/claudeaccounts/properlock.go
new file mode 100644
index 0000000..b69422f
--- /dev/null
+++ b/internal/claudeaccounts/properlock.go
@@ -0,0 +1,57 @@
+package claudeaccounts
+
+import (
+	"os"
+	"path/filepath"
+	"strconv"
+	"time"
+)
+
+// ProperLock 是与 Pi proper-lockfile 兼容的原生短写锁（design §4.3）：
+// 锁形态为目标文件旁的 `<file>.lock` 目录 + 目录内 mtime 文件（内容为
+// 时间戳），realpath=false。获取 = mkdir（已存在即 busy）；释放 = 校验
+// mtime 内容后递归删除锁目录。
+//
+// 【待实测】该兼容实现与 Pi 安装版本的竞争测试属于 §10.2 真机验证项；
+// v1 不自动清理未知/过期原生锁（design §4.3）：发现锁目录一律 busy。
+type ProperLock struct {
+	dir      string
+	mtimePath string
+	token    string
+}
+
+// AcquireProperLock 尝试获取 targetFilePath 的兼容锁。
+func AcquireProperLock(targetFilePath string, now time.Time) (*ProperLock, error) {
+	dir := targetFilePath + ".lock"
+	if err := os.Mkdir(dir, 0o755); err != nil {
+		if os.IsExist(err) {
+			return nil, NewErr(ReasonNativeLockBusy, "原生写锁被占用（存在 %s）", filepath.Base(dir))
+		}
+		return nil, NewErr(ReasonNativeLockBusy, "原生写锁目录不可创建")
+	}
+	token := strconv.FormatInt(now.UnixMilli(), 10)
+	mtimePath := filepath.Join(dir, "mtime")
+	// mtime 文件内容与 proper-lockfile 同形态：十进制毫秒时间戳。
+	if err := os.WriteFile(mtimePath, []byte(token), 0o644); err != nil {
+		_ = os.RemoveAll(dir)
+		return nil, NewErr(ReasonNativeLockBusy, "原生写锁 mtime 文件不可写")
+	}
+	return &ProperLock{dir: dir, mtimePath: mtimePath, token: token}, nil
+}
+
+// Release 释放锁：只有 mtime 文件内容仍为自己写入的 token 时才删除，
+// 防止误删他人后来获取的锁；被接管时不删除并返回错误。
+func (l *ProperLock) Release() error {
+	if l == nil {
+		return nil
+	}
+	data, err := os.ReadFile(l.mtimePath)
+	if err != nil {
+		// mtime 文件缺失/不可读：锁目录可能已被外部接管，不再删除。
+		return NewErr(ReasonNativeLockBusy, "原生写锁 mtime 文件不可读，不删除锁目录")
+	}
+	if string(data) != l.token {
+		return NewErr(ReasonNativeLockBusy, "原生写锁已被外部接管，不删除锁目录")
+	}
+	return os.RemoveAll(l.dir)
+}
diff --git a/internal/claudeaccounts/reason.go b/internal/claudeaccounts/reason.go
new file mode 100644
index 0000000..6bdbdde
--- /dev/null
+++ b/internal/claudeaccounts/reason.go
@@ -0,0 +1,96 @@
+// Package claudeaccounts 实现《Claude 订阅账号轮换》设计（agent-outputs/
+// 2026-10-28-claude-account-rotation/design.md）的领域层：账号池 Keychain
+// envelope 存储、原生凭据三处投影适配器、capture/enrollment/harvest/swap/
+// reconcile 事务，以及 standby grant 的受控 OAuth 刷新与身份配对校验。
+//
+// 本包只做领域逻辑，不做 Wails facade、不做启动接线；共享 lease 与进程
+// 观察器通过 MutationGate / QuiescenceChecker 接口注入（见 design §2、§6.3）。
+//
+// 敏感边界（design §3.3 / §1.3-5）：token、完整身份快照、凭据 hash、HTTP
+// 原始响应一律不进入日志、错误消息或 DTO；日志只允许本机账号 ID 与 reason。
+package claudeaccounts
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Reason 是对外稳定的错误码（design §7.2）。新增取值必须同步设计文档。
+type Reason string
+
+const (
+	// ReasonUnsupportedPlatform 平台不支持本能力（非 macOS 的原生凭据访问等）。
+	ReasonUnsupportedPlatform Reason = "UNSUPPORTED_PLATFORM"
+	// ReasonPoolLocked 账号池跨进程锁被他人持有，或 Keychain 访问被锁定。
+	ReasonPoolLocked Reason = "POOL_LOCKED"
+	// ReasonPoolMissing 账号池从未创建（正常未启用）或已被删除。
+	ReasonPoolMissing Reason = "POOL_MISSING"
+	// ReasonPoolCorrupt 池 envelope 存在但不可解析（schema/JSON 损坏）。
+	ReasonPoolCorrupt Reason = "POOL_CORRUPT"
+	// ReasonRevisionConflict 调用方携带的期望 revision/generation 与池不符。
+	ReasonRevisionConflict Reason = "REVISION_CONFLICT"
+	// ReasonIdentityMismatch 双 grant 身份不属于同一账号，或与期望账号不符。
+	ReasonIdentityMismatch Reason = "IDENTITY_MISMATCH"
+	// ReasonIdentityUnverified 身份无法验证（端点失败、响应不可解析、未验证契约）。
+	ReasonIdentityUnverified Reason = "IDENTITY_UNVERIFIED"
+	// ReasonSessionsActive 受影响启动入口存在 pending/run lease（由注入的
+	// MutationGate/QuiescenceChecker 判定，本包不自行实现 lease）。
+	ReasonSessionsActive Reason = "SESSIONS_ACTIVE"
+	// ReasonExternalSessionUncertain 存在不可分类的外部消费进程，写入者静止条件不成立。
+	ReasonExternalSessionUncertain Reason = "EXTERNAL_SESSION_UNCERTAIN"
+	// ReasonNativeLockBusy 原生短写锁（Pi proper-lockfile 兼容锁）被占用。
+	ReasonNativeLockBusy Reason = "NATIVE_LOCK_BUSY"
+	// ReasonExternalAccountChange 原生槽位读到了与活动账号不同的账号。
+	ReasonExternalAccountChange Reason = "EXTERNAL_ACCOUNT_CHANGE"
+	// ReasonNeedsReconcile 事务恢复无法按 before/after 分类，需人工 reconcile。
+	ReasonNeedsReconcile Reason = "NEEDS_RECONCILE"
+	// ReasonRefreshUncertain 刷新请求已发出但结果不可证明（响应丢失/取消/存池失败）。
+	ReasonRefreshUncertain Reason = "REFRESH_UNCERTAIN"
+	// ReasonNeedsLogin grant 已失效（invalid_grant），需重新授权。
+	ReasonNeedsLogin Reason = "NEEDS_LOGIN"
+	// ReasonUnsupportedCredentialSchema 原生凭据 schema 未知或含无法判明归属的字段。
+	ReasonUnsupportedCredentialSchema Reason = "UNSUPPORTED_CREDENTIAL_SCHEMA"
+)
+
+// Error 是本包唯一的对外错误形态：稳定 reason code + 无敏感信息的 Message。
+// Message 不得包含 token、完整身份快照、凭据 hash 或 HTTP 原文。
+type Error struct {
+	Reason  Reason
+	Message string
+}
+
+func (e *Error) Error() string {
+	if e == nil {
+		return "<nil>"
+	}
+	if e.Message == "" {
+		return string(e.Reason)
+	}
+	return string(e.Reason) + ": " + e.Message
+}
+
+// NewErr 构造领域错误。format 只允许步骤名、reason、本机账号 ID 等无敏感信息。
+func NewErr(reason Reason, format string, args ...any) *Error {
+	return &Error{Reason: reason, Message: fmt.Sprintf(format, args...)}
+}
+
+// AsError 提取 *Error；非领域错误按原因归一为最接近的稳定码，
+// 避免把底层 IO/HTTP 细节直接透出（敏感边界）。
+func AsError(err error) (*Error, bool) {
+	if err == nil {
+		return nil, false
+	}
+	var domain *Error
+	if errors.As(err, &domain) {
+		return domain, true
+	}
+	return nil, false
+}
+
+// ReasonOf 返回错误的稳定 reason；未知错误归为 NeedsReconcile（保守停写）。
+func ReasonOf(err error) Reason {
+	if domain, ok := AsError(err); ok {
+		return domain.Reason
+	}
+	return ReasonNeedsReconcile
+}
diff --git a/internal/claudeaccounts/reconcile.go b/internal/claudeaccounts/reconcile.go
new file mode 100644
index 0000000..b329e00
--- /dev/null
+++ b/internal/claudeaccounts/reconcile.go
@@ -0,0 +1,361 @@
+package claudeaccounts
+
+import (
+	"context"
+)
+
+// ReconcileAction 是恢复决策表（design §4.5）的动作结论。
+type ReconcileAction string
+
+const (
+	// ReconcileNone 无未结 swap 事务。
+	ReconcileNone ReconcileAction = "none"
+	// ReconcileClearedJournal 全部等于 before：判定尚未应用，清 journal，
+	// 源仍活动；目标曾刷新的新快照保留。
+	ReconcileClearedJournal ReconcileAction = "cleared-journal"
+	// ReconcileCommittedAfter 全部等于 after：完成 active/generation 提交，
+	// 不重复写文件。
+	ReconcileCommittedAfter ReconcileAction = "committed-after"
+	// ReconcileRolledForward 混合但每一处都可分类：静止与锁条件重新成立后
+	// roll-forward 到 after，只补未完成投影。
+	ReconcileRolledForward ReconcileAction = "rolled-forward"
+	// ReconcileRollForwardPending 存在混合态但调用方未持有 admission：
+	// 需要带 gate 重新执行（facade action=complete-target 语义）。
+	ReconcileRollForwardPending ReconcileAction = "roll-forward-pending"
+	// ReconcileNeedsReconcile 任一投影既非 before 也非 after：停止写入，
+	// 保全当前值和已有 journal。
+	ReconcileNeedsReconcile ReconcileAction = "needs-reconcile"
+	// ReconcileBlocked Keychain 缺失/拒绝访问、JSON 坏、文件缺失：
+	// 要求修复访问或重新登录，不创建空 JSON 覆盖。
+	ReconcileBlocked ReconcileAction = "blocked"
+)
+
+// ReconcileOutcome 是一次恢复检查的结论（credential-free）。
+type ReconcileOutcome struct {
+	Action     ReconcileAction `json:"action"`
+	TxnID      string          `json:"txnId,omitempty"`
+	ActiveID   string          `json:"activeId,omitempty"`
+	Generation uint64          `json:"generation,omitempty"`
+	ReasonCode string          `json:"reasonCode,omitempty"`
+}
+
+// projectionClass 是单个投影相对 journal 的分类。
+type projectionClass string
+
+const (
+	classBefore  projectionClass = "before"
+	classAfter   projectionClass = "after"
+	classUnknown projectionClass = "unknown"
+)
+
+// classifyProjection 比较原生当前值与 journal 前后值（design §4.5；语义
+// 比较，池往返 compact 化与原生格式差异不算变化）。
+func classifyProjection(current *NativeProjections, journal *SwapJournal, key ProjectionKey) projectionClass {
+	before := journal.Before.Projection(key)
+	after := journal.After.Projection(key)
+	switch key {
+	case ProjectionCCKeychain:
+		switch {
+		case equalJSON(current.ClaudeOAuth, before):
+			return classBefore
+		case equalJSON(current.ClaudeOAuth, after):
+			return classAfter
+		}
+	case ProjectionClaudeJSON:
+		cb := current.ClaudeIdentity
+		if cb != nil && journal.Before.ClaudeIdentity != nil &&
+			cb.UserID == journal.Before.ClaudeIdentity.UserID &&
+			equalJSON(cb.OauthAccount, journal.Before.ClaudeIdentity.OauthAccount) {
+			return classBefore
+		}
+		if cb != nil && journal.After.ClaudeIdentity != nil &&
+			cb.UserID == journal.After.ClaudeIdentity.UserID &&
+			equalJSON(cb.OauthAccount, journal.After.ClaudeIdentity.OauthAccount) {
+			return classAfter
+		}
+	case ProjectionPiAuth:
+		switch {
+		case equalJSON(current.PiAnthropic, before):
+			return classBefore
+		case equalJSON(current.PiAnthropic, after):
+			return classAfter
+		}
+	}
+	return classUnknown
+}
+
+// ReconcileExistingTransaction 是外部恢复入口（design §7.2 action=inspect/
+// complete-target 的领域支撑）。不带 gate 时混合态返回 roll-forward-pending。
+func (s *Service) ReconcileExistingTransaction(ctx context.Context) (ReconcileOutcome, error) {
+	release, err := s.withLocks(ctx, "reconcile")
+	if err != nil {
+		return ReconcileOutcome{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return ReconcileOutcome{}, err
+	}
+	return s.reconcileLocked(ctx, pool, nil)
+}
+
+// reconcileLocked 按恢复决策表处理未结 swap 事务。gateRelease 非 nil 表示
+// 调用方已持有共享凭据 admission（roll-forward 允许写原生槽位）。
+func (s *Service) reconcileLocked(ctx context.Context, pool *AccountPool, gateRelease func()) (ReconcileOutcome, error) {
+	if pool == nil || pool.Transaction == nil {
+		return ReconcileOutcome{Action: ReconcileNone, ActiveID: activeIDOf(pool), Generation: generationOf(pool)}, nil
+	}
+	if pool.Transaction.Kind != TransactionSwap || pool.Transaction.Swap == nil {
+		// enrollment 事务不自动处理：由 CaptureEnrolledAccount / CancelEnrollment 走完。
+		return ReconcileOutcome{Action: ReconcileNone, ActiveID: activeIDOf(pool), Generation: generationOf(pool)}, nil
+	}
+	journal := pool.Transaction.Swap
+	current, err := s.readStableAll(ctx)
+	if err != nil {
+		// blocked：不创建空 JSON 覆盖；要求修复访问或重新登录（design §4.5）。
+		return ReconcileOutcome{Action: ReconcileBlocked, TxnID: journal.TxnID, ReasonCode: string(ReasonOf(err))}, err
+	}
+
+	classes := map[ProjectionKey]projectionClass{}
+	hasUnknown, hasBefore, hasAfter := false, false, false
+	for _, key := range AllProjections {
+		c := classifyProjection(current, journal, key)
+		classes[key] = c
+		switch c {
+		case classUnknown:
+			hasUnknown = true
+		case classBefore:
+			hasBefore = true
+		case classAfter:
+			hasAfter = true
+		}
+	}
+
+	switch {
+	case hasUnknown:
+		// 停止写入，保全当前值和已有 journal（design §4.5）。
+		return ReconcileOutcome{Action: ReconcileNeedsReconcile, TxnID: journal.TxnID, ReasonCode: string(ReasonNeedsReconcile)},
+			NewErr(ReasonNeedsReconcile, "存在无法按 before/after 分类的投影，需人工恢复")
+	case hasBefore && !hasAfter:
+		// 全部等于 before：尚未应用，清 journal；目标刷新快照保留在池中。
+		pool.Transaction = nil
+		pool.Revision++
+		if err := s.savePoolLocked(ctx, pool); err != nil {
+			return ReconcileOutcome{Action: ReconcileBlocked, TxnID: journal.TxnID, ReasonCode: string(ReasonOf(err))}, err
+		}
+		s.logStep("reconcile-cleared", journal.TxnID, journal.SourceID)
+		s.emitEvent(Event{Kind: EventReconcileCompleted, TxnID: journal.TxnID, AccountID: journal.SourceID})
+		return ReconcileOutcome{Action: ReconcileClearedJournal, TxnID: journal.TxnID, ActiveID: journal.SourceID, Generation: journal.FromGeneration}, nil
+	case hasAfter && !hasBefore:
+		// 全部等于 after：完成提交，不重复写文件。
+		if err := s.commitAfterOnlyLocked(ctx, pool, journal); err != nil {
+			return ReconcileOutcome{Action: ReconcileBlocked, TxnID: journal.TxnID, ReasonCode: string(ReasonOf(err))}, err
+		}
+		return ReconcileOutcome{Action: ReconcileCommittedAfter, TxnID: journal.TxnID, ActiveID: journal.TargetID, Generation: journal.FromGeneration + 1}, nil
+	default:
+		// 混合：每一处都能确认为 before 或 after。
+		if gateRelease == nil {
+			return ReconcileOutcome{Action: ReconcileRollForwardPending, TxnID: journal.TxnID, ActiveID: journal.SourceID, Generation: journal.FromGeneration}, nil
+		}
+		if err := s.checkQuiescence(ctx); err != nil {
+			return ReconcileOutcome{Action: ReconcileRollForwardPending, TxnID: journal.TxnID, ReasonCode: string(ReasonOf(err))}, err
+		}
+		pending := []ProjectionKey{}
+		for _, key := range AllProjections {
+			if classes[key] == classBefore {
+				pending = append(pending, key)
+			}
+		}
+		if err := s.applyAndCommitLocked(ctx, pool, journal, SwapReasonRecovered, 0, pending); err != nil {
+			return ReconcileOutcome{Action: ReconcileNeedsReconcile, TxnID: journal.TxnID, ReasonCode: string(ReasonOf(err))}, err
+		}
+		return ReconcileOutcome{Action: ReconcileRolledForward, TxnID: journal.TxnID, ActiveID: journal.TargetID, Generation: journal.FromGeneration + 1}, nil
+	}
+}
+
+// commitAfterOnlyLocked 完成全部 after 已就位的提交（不写文件）。
+func (s *Service) commitAfterOnlyLocked(ctx context.Context, pool *AccountPool, journal *SwapJournal) error {
+	pool.Transaction = nil
+	pool.ActiveAccountID = journal.TargetID
+	pool.ActiveGeneration = journal.FromGeneration + 1
+	pool.LastSwitch = &LastSwitch{
+		At:              s.now(),
+		SourceAccountID: journal.SourceID,
+		TargetAccountID: journal.TargetID,
+		Reason:          SwapReasonRecovered,
+	}
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return err
+	}
+	s.logStep("reconcile-committed", journal.TxnID, journal.TargetID)
+	s.emitEvent(Event{Kind: EventReconcileCompleted, TxnID: journal.TxnID, AccountID: journal.TargetID, Generation: pool.ActiveGeneration})
+	return nil
+}
+
+func activeIDOf(pool *AccountPool) string {
+	if pool == nil {
+		return ""
+	}
+	return pool.ActiveAccountID
+}
+
+func generationOf(pool *AccountPool) uint64 {
+	if pool == nil {
+		return 0
+	}
+	return pool.ActiveGeneration
+}
+
+// NativeStateReport 是 InspectNativeState 的只读分类报告（零写入，
+// design §7.2 action=inspect 语义）。
+type NativeStateReport struct {
+	HasJournal          bool                  `json:"hasJournal"`
+	JournalPhase        SwapPhase             `json:"journalPhase,omitempty"`
+	Classifications     map[ProjectionKey]string `json:"classifications,omitempty"`
+	MatchesActiveSnapshot bool                `json:"matchesActiveSnapshot"`
+	ExternalChangeSuspected bool              `json:"externalChangeSuspected"`
+	ActiveID            string                `json:"activeId,omitempty"`
+	Generation          uint64                `json:"generation"`
+}
+
+// InspectNativeState 零写入地分类当前原生槽位与池/事务的关系。
+func (s *Service) InspectNativeState(ctx context.Context) (*NativeStateReport, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return nil, err
+	}
+	report := &NativeStateReport{ActiveID: activeIDOf(pool), Generation: generationOf(pool)}
+	current, err := s.readStableAll(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if pool != nil && pool.Transaction != nil && pool.Transaction.Kind == TransactionSwap && pool.Transaction.Swap != nil {
+		journal := pool.Transaction.Swap
+		report.HasJournal = true
+		report.JournalPhase = journal.Phase
+		report.Classifications = map[ProjectionKey]string{}
+		for _, key := range AllProjections {
+			report.Classifications[key] = string(classifyProjection(current, journal, key))
+		}
+		return report, nil
+	}
+	if pool != nil && pool.Active() != nil {
+		report.MatchesActiveSnapshot = s.nativeMatchesOwned(current, pool.Active().OwnedProjectionsOf())
+		// 原生与活动快照不符且无 journal → 外部换号嫌疑（design §4.5 末行），
+		// 经显式采用（AdoptCurrentLogin）才更新 active。
+		report.ExternalChangeSuspected = !report.MatchesActiveSnapshot
+	}
+	return report, nil
+}
+
+// AdoptCurrentLogin 显式采用当前原生登录为活动账号（design §4.5 末行：
+// 在两个 grant 身份验证后，经显式采用才更新 active）。
+func (s *Service) AdoptCurrentLogin(ctx context.Context, expectedRevision uint64) (AccountDTO, error) {
+	release, err := s.withLocks(ctx, "adopt-current")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	if pool == nil {
+		return AccountDTO{}, NewErr(ReasonPoolMissing, "账号池未启用")
+	}
+	if pool.Transaction != nil {
+		return AccountDTO{}, NewErr(ReasonNeedsReconcile, "池存在未结事务，先完成恢复")
+	}
+	if pool.Revision != expectedRevision {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	gateRelease, err := s.acquireGate(ctx, "adopt-current")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer gateRelease()
+	if err := s.checkQuiescence(ctx); err != nil {
+		return AccountDTO{}, err
+	}
+	current, err := s.readStableAll(ctx)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	ccID, _, err := s.fetchPairedIdentity(ctx, current)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	var match *AccountSnapshot
+	for _, snap := range pool.Accounts {
+		if snap != nil && snap.Identity.AccountUUID == ccID.AccountUUID {
+			match = snap
+			break
+		}
+	}
+	if match == nil {
+		return AccountDTO{}, NewErr(ReasonExternalAccountChange, "原生登录不属于池内任何账号，请走 enrollment 录入")
+	}
+	if pool.ActiveAccountID != match.ID {
+		pool.ActiveAccountID = match.ID
+		pool.ActiveGeneration++
+		pool.Revision++
+		if err := s.savePoolLocked(ctx, pool); err != nil {
+			return AccountDTO{}, err
+		}
+	}
+	// 采用后回收当前原生值，使快照与槽位一致。
+	if _, _, err := s.harvestLocked(ctx, pool, pool.ActiveAccountID); err != nil {
+		return AccountDTO{}, err
+	}
+	s.logStep("adopt-current", "", match.ID)
+	return match.ToDTO(pool.ActiveAccountID), nil
+}
+
+// RecoverAtStartup 启动恢复（design §4.5：启动先加载池并完成恢复检查）：
+// 1) 未结 RefreshIntent → 对应 grant 标 refresh-uncertain（退出自动候选）；
+// 2) 未结 swap 事务 → 在取得 admission 后按恢复决策表处理。
+func (s *Service) RecoverAtStartup(ctx context.Context) (ReconcileOutcome, error) {
+	release, err := s.withLocks(ctx, "recover-startup")
+	if err != nil {
+		return ReconcileOutcome{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return ReconcileOutcome{}, err
+	}
+	if pool == nil {
+		return ReconcileOutcome{Action: ReconcileNone}, nil
+	}
+	if pool.RefreshIntent != nil {
+		snap := pool.Account(pool.RefreshIntent.AccountID)
+		if snap != nil {
+			// 重启发现未结 intent：一律 refresh-uncertain（design §5.1）。
+			markGrantHealth(snap, pool.RefreshIntent.GrantKind, HealthRefreshUncertain)
+			s.logf("[claudeaccounts] 启动发现未结刷新意图，标记 refresh-uncertain（account=%s kind=%s）",
+				pool.RefreshIntent.AccountID, string(pool.RefreshIntent.GrantKind))
+		}
+		pool.RefreshIntent = nil
+		pool.Revision++
+		if err := s.savePoolLocked(ctx, pool); err != nil {
+			return ReconcileOutcome{}, err
+		}
+	}
+	if pool.Transaction == nil || pool.Transaction.Kind != TransactionSwap {
+		return ReconcileOutcome{Action: ReconcileNone, ActiveID: pool.ActiveAccountID, Generation: pool.ActiveGeneration}, nil
+	}
+	// swap 事务：取得 admission 后恢复；admission 被拒时保留事务并返回
+	// pending（等待会话退出后重试）。
+	gateRelease, gerr := s.acquireGate(ctx, "recover-startup")
+	if gerr != nil {
+		return ReconcileOutcome{Action: ReconcileRollForwardPending, TxnID: pool.Transaction.Swap.TxnID, ActiveID: pool.ActiveAccountID, Generation: pool.ActiveGeneration, ReasonCode: string(ReasonOf(gerr))}, nil
+	}
+	defer gateRelease()
+	if qerr := s.checkQuiescence(ctx); qerr != nil {
+		return ReconcileOutcome{Action: ReconcileRollForwardPending, TxnID: pool.Transaction.Swap.TxnID, ActiveID: pool.ActiveAccountID, Generation: pool.ActiveGeneration, ReasonCode: string(ReasonOf(qerr))}, nil
+	}
+	return s.reconcileLocked(ctx, pool, gateRelease)
+}
diff --git a/internal/claudeaccounts/sensitive_test.go b/internal/claudeaccounts/sensitive_test.go
new file mode 100644
index 0000000..284ecb8
--- /dev/null
+++ b/internal/claudeaccounts/sensitive_test.go
@@ -0,0 +1,126 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+// 敏感边界（design §1.3-5/§3.3）：token、完整身份快照、凭据 hash、HTTP
+// 原文不进日志、错误消息、DTO。
+
+// sensitiveTokens 是全流程使用的合成敏感值集合。
+var sensitiveTokens = []string{
+	"cc-a-1", "ccr-cc-a-1", "pi-a-1", "pir-pi-a-1",
+	"cc-b-1", "ccr-cc-b-1", "pi-b-1", "pir-pi-b-1",
+	"pi-a-2", "pi-a-3", "pi-a-4", "acc-new", "ref-new", "pir-old",
+	"sk-synthetic", "g-synthetic",
+	"a@example.com", "b@example.com", // 完整邮箱也不进日志（遮罩后可以）
+	syntheticUUIDA, syntheticUUIDB, // 服务端 UUID 不进日志（本机 ID 可以）
+}
+
+// TestLogsAndEventsSensitiveScan：完整 A/B 录入+切换+harvest 流程后，
+// 日志与事件不含任何敏感值。
+func TestLogsAndEventsSensitiveScan(t *testing.T) {
+	env := newTestEnv(t)
+	idA, idB := env.enrollAccountB()
+	pool, _ := env.svc.LoadPool(context.Background())
+	if _, err := env.svc.Swap(context.Background(), SwapRequest{TargetID: idA, Reason: SwapReasonManual, ExpectedGeneration: pool.ActiveGeneration}); err != nil {
+		t.Fatalf("swap: %v", err)
+	}
+	pool, _ = env.svc.LoadPool(context.Background())
+	if _, err := env.svc.Swap(context.Background(), SwapRequest{TargetID: idB, Reason: SwapReasonManual, ExpectedGeneration: pool.ActiveGeneration}); err != nil {
+		t.Fatalf("swap back: %v", err)
+	}
+	pool, _ = env.svc.LoadPool(context.Background())
+	if _, err := env.svc.HarvestActive(context.Background(), pool.Revision); err != nil {
+		t.Fatalf("harvest: %v", err)
+	}
+
+	for _, log := range env.allLogs() {
+		for _, secret := range sensitiveTokens {
+			if strings.Contains(log, secret) {
+				t.Fatalf("日志泄漏敏感值 %q：%s", secret, log)
+			}
+		}
+	}
+	for _, ev := range env.events {
+		data, _ := json.Marshal(ev)
+		for _, secret := range sensitiveTokens {
+			if strings.Contains(string(data), secret) {
+				t.Fatalf("事件泄漏敏感值 %q：%s", secret, data)
+			}
+		}
+	}
+}
+
+// TestDTOHasNoSensitiveFields：DTO 序列化不含 token/服务端身份/邮箱原文。
+func TestDTOHasNoSensitiveFields(t *testing.T) {
+	env := newTestEnv(t)
+	dtos, err := env.svc.ListAccounts(context.Background())
+	if err != nil || len(dtos) != 0 {
+		// 空池也应正常。
+		if err != nil {
+			t.Fatal(err)
+		}
+	}
+	env.enrollAccountB()
+	dtos, err = env.svc.ListAccounts(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(dtos) != 2 {
+		t.Fatalf("期望两个账号 DTO，实际 %d", len(dtos))
+	}
+	for _, dto := range dtos {
+		data, _ := json.Marshal(dto)
+		text := string(data)
+		for _, secret := range sensitiveTokens {
+			if strings.Contains(text, secret) {
+				t.Fatalf("DTO 泄漏敏感值 %q：%s", secret, text)
+			}
+		}
+		if dto.EmailMasked != "" && !strings.Contains(dto.EmailMasked, "***") {
+			t.Fatalf("DTO 邮箱未遮罩：%s", dto.EmailMasked)
+		}
+	}
+}
+
+// TestErrorMessageNoRawContent：错误路径的错误消息不含 HTTP 原文与凭据。
+func TestErrorMessageNoRawContent(t *testing.T) {
+	env := newTestEnv(t)
+	env.identityFake.mu.Lock()
+	delete(env.identityFake.responses, "pi-a-1")
+	env.identityFake.mu.Unlock()
+	_, err := env.svc.CaptureFirstAccount(context.Background(), "a", 0)
+	if err == nil {
+		t.Fatal("期望身份失败")
+	}
+	msg := err.Error()
+	for _, secret := range sensitiveTokens {
+		if strings.Contains(msg, secret) {
+			t.Fatalf("错误消息泄漏 %q：%s", secret, msg)
+		}
+	}
+	assertReason(t, err, ReasonIdentityUnverified)
+}
+
+// TestDefaultConstructorsDontTouchRealKeychain：默认构造器只在生产平台
+// 返回后端句柄，测试内绝不调用其 Load/Save（design §10.1：不可通过默认
+// 构造器碰真实 Keychain）。这里仅验证句柄可创建且 Kind 有值，不做 IO。
+func TestDefaultConstructorsDontTouchRealKeychain(t *testing.T) {
+	store := NewKeychainPoolStore()
+	if store.Kind() == "" {
+		t.Fatal("Kind 不能为空")
+	}
+	kc := NewClaudeKeychainAccess()
+	_ = kc // 不调用其任何 IO 方法
+	paths, err := DefaultFileCredentialPaths()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasSuffix(paths.ClaudeJSONPath, ".claude.json") || !strings.Contains(paths.PiAuthPath, ".pi") {
+		t.Fatalf("canonical 路径不符: %+v", paths)
+	}
+}
diff --git a/internal/claudeaccounts/service.go b/internal/claudeaccounts/service.go
new file mode 100644
index 0000000..edfec02
--- /dev/null
+++ b/internal/claudeaccounts/service.go
@@ -0,0 +1,615 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/tidwall/gjson"
+)
+
+// MutationGate 是共享凭据 mutation admission 的注入边界（design §2/§6.3）。
+// Phase 1a 不接线真实 SharedServiceClaudeCredentials kind；接线任务负责提供
+// 实现。Acquire 返回的 release 必须幂等。
+type MutationGate interface {
+	Acquire(ctx context.Context, why string) (func(), error)
+}
+
+// QuiescenceChecker 是写入者静止条件的注入边界（design §4.3）：消费进程
+// 结束、无未清外部进程树。返回 *Error（SESSIONS_ACTIVE /
+// EXTERNAL_SESSION_UNCERTAIN 等）。
+type QuiescenceChecker interface {
+	Check(ctx context.Context) error
+}
+
+// Event 是 credential-free 的完成事件（design §4.4：发一个完成事件）。
+type Event struct {
+	Kind       string `json:"kind"`
+	TxnID      string `json:"txnId,omitempty"`
+	AccountID  string `json:"accountId,omitempty"`
+	Generation uint64 `json:"generation,omitempty"`
+}
+
+// 事件种类。
+const (
+	EventCaptureCompleted   = "capture-completed"
+	EventEnrollmentBegun    = "enrollment-begun"
+	EventEnrollmentCleared  = "enrollment-cleared"
+	EventSwapCompleted      = "swap-completed"
+	EventReconcileCompleted = "reconcile-completed"
+	EventRefreshCompleted   = "refresh-completed"
+)
+
+// Deps 是 Service 的依赖注入集合（design §2：App 向服务注入共享 lease、
+// 标准路径、固定端点 HTTP client、时钟、进程观察器）。所有路径/后端必须
+// 注入；测试使用 tempdir 与 fake，绝不触碰真实 Keychain 或真实
+// ~/.claude、~/.pi/agent（design §3.3）。
+type Deps struct {
+	Pool       PoolStore
+	Native     NativeCredentialStore
+	LockPath   string // 跨进程锁文件路径
+	PiAuthPath string // Pi auth.json 路径（proper-lockfile 兼容锁目标）
+	Gate       MutationGate
+	Quiescence QuiescenceChecker
+	Identity   IdentityProvider
+
+	HTTPClient *http.Client
+	PiRefresh  *PiRefreshAdapter
+	CCRefresh  *CCRefreshAdapter
+
+	Clock       func() time.Time
+	Logf        func(format string, args ...any)
+	EmitEvent   func(Event)
+}
+
+// Service 是 Claude 订阅账号轮换的事务服务（design §4）。进程内串行 + 跨
+// 进程锁保护 read-modify-write；所有公共方法遵循同一事务原语与门禁
+// （design §1.3-7）。
+type Service struct {
+	pool      PoolStore
+	native    NativeCredentialStore
+	lockPath  string
+	piAuthPath string
+	gate      MutationGate
+	quiescence QuiescenceChecker
+	identity  IdentityProvider
+	piRefresh *PiRefreshAdapter
+	ccRefresh *CCRefreshAdapter
+	clock     func() time.Time
+	logf      func(format string, args ...any)
+	emit      func(Event)
+
+	mu sync.Mutex
+}
+
+// NewService 构造事务服务并校验必需依赖。
+func NewService(deps Deps) (*Service, error) {
+	if deps.Pool == nil {
+		return nil, fmt.Errorf("claudeaccounts: Pool 依赖必需")
+	}
+	if deps.Native == nil {
+		return nil, fmt.Errorf("claudeaccounts: Native 依赖必需")
+	}
+	if deps.LockPath == "" {
+		return nil, fmt.Errorf("claudeaccounts: LockPath 依赖必需")
+	}
+	if deps.PiAuthPath == "" {
+		return nil, fmt.Errorf("claudeaccounts: PiAuthPath 依赖必需")
+	}
+	if deps.Gate == nil {
+		return nil, fmt.Errorf("claudeaccounts: Gate 依赖必需（共享凭据 admission 由接线层注入）")
+	}
+	if deps.Quiescence == nil {
+		return nil, fmt.Errorf("claudeaccounts: Quiescence 依赖必需（写入者静止条件由接线层注入）")
+	}
+	if deps.Identity == nil {
+		return nil, fmt.Errorf("claudeaccounts: Identity 依赖必需")
+	}
+	clock := deps.Clock
+	if clock == nil {
+		clock = time.Now
+	}
+	logf := deps.Logf
+	if logf == nil {
+		logf = func(string, ...any) {}
+	}
+	emit := deps.EmitEvent
+	if emit == nil {
+		emit = func(Event) {}
+	}
+	client := deps.HTTPClient
+	if client == nil {
+		client = NewConstrainedHTTPClient(nil)
+	}
+	piRefresh := deps.PiRefresh
+	if piRefresh == nil {
+		piRefresh = NewPiRefreshAdapter(client)
+	}
+	ccRefresh := deps.CCRefresh
+	if ccRefresh == nil {
+		ccRefresh = NewCCRefreshAdapter(client, CCRefreshProtocol{})
+	}
+	return &Service{
+		pool:       deps.Pool,
+		native:     deps.Native,
+		lockPath:   deps.LockPath,
+		piAuthPath: deps.PiAuthPath,
+		gate:       deps.Gate,
+		quiescence: deps.Quiescence,
+		identity:   deps.Identity,
+		piRefresh:  piRefresh,
+		ccRefresh:  ccRefresh,
+		clock:      clock,
+		logf:       logf,
+		emit:       emit,
+	}, nil
+}
+
+// now 返回注入时钟的当前时间。
+func (s *Service) now() time.Time { return s.clock() }
+
+// logStep 记录无敏感信息的步骤日志（只含事务/账号 ID 与 reason）。
+func (s *Service) logStep(step, txnID, accountID string) {
+	s.logf("[claudeaccounts] %s txn=%s account=%s", step, txnID, accountID)
+}
+
+func (s *Service) emitEvent(ev Event) { s.emit(ev) }
+
+// withLocks 取进程内串行锁与跨进程锁。调用方在返回的 release 内先释放跨
+// 进程锁再返回（进程内锁由 defer 释放）。
+func (s *Service) withLocks(ctx context.Context, step string) (func(), error) {
+	s.mu.Lock()
+	flock, err := acquireFileLock(s.lockPath)
+	if err != nil {
+		s.mu.Unlock()
+		return nil, err
+	}
+	released := false
+	return func() {
+		if released {
+			return
+		}
+		released = true
+		flock.release()
+		s.mu.Unlock()
+	}, nil
+}
+
+// loadPoolLocked 读取并校验池；从未创建返回 (nil, nil)。
+func (s *Service) loadPoolLocked(ctx context.Context) (*AccountPool, error) {
+	pool, err := s.pool.Load(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return pool, nil
+}
+
+// savePoolLocked 写池（Store 内部回读验证 revision）。
+func (s *Service) savePoolLocked(ctx context.Context, pool *AccountPool) error {
+	return s.pool.Save(ctx, pool)
+}
+
+// readStableAll 读取三处受管投影的稳定快照。
+func (s *Service) readStableAll(ctx context.Context) (*NativeProjections, error) {
+	return s.native.ReadStable(ctx)
+}
+
+// acquireGate 取得共享凭据 mutation admission；gate 层错误映射为
+// SESSIONS_ACTIVE（design §4.4：取得 admission 后禁止新启动）。
+func (s *Service) acquireGate(ctx context.Context, why string) (func(), error) {
+	release, err := s.gate.Acquire(ctx, why)
+	if err != nil {
+		if _, ok := AsError(err); ok {
+			return nil, err
+		}
+		return nil, NewErr(ReasonSessionsActive, "共享凭据 admission 被拒")
+	}
+	released := false
+	return func() {
+		if released {
+			return
+		}
+		released = true
+		release()
+	}, nil
+}
+
+// checkQuiescence 校验写入者静止条件（design §4.3）。
+func (s *Service) checkQuiescence(ctx context.Context) error {
+	if err := s.quiescence.Check(ctx); err != nil {
+		if _, ok := AsError(err); ok {
+			return err
+		}
+		return NewErr(ReasonExternalSessionUncertain, "写入者静止条件未确认")
+	}
+	return nil
+}
+
+// LoadPool 只读返回池快照（深拷贝，调用方不得篡改内部状态）。
+func (s *Service) LoadPool(ctx context.Context) (*AccountPool, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.loadPoolLocked(ctx)
+}
+
+// ListAccounts 返回 credential-free 的账号 DTO 列表。
+func (s *Service) ListAccounts(ctx context.Context) ([]AccountDTO, error) {
+	pool, err := s.LoadPool(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if pool == nil {
+		return nil, nil
+	}
+	out := make([]AccountDTO, 0, len(pool.Accounts))
+	for _, snap := range pool.Accounts {
+		if snap == nil {
+			continue
+		}
+		out = append(out, snap.ToDTO(pool.ActiveAccountID))
+	}
+	sortAccountDTOs(out)
+	return out, nil
+}
+
+func sortAccountDTOs(dtos []AccountDTO) {
+	for i := 1; i < len(dtos); i++ {
+		for j := i; j > 0 && dtos[j].ID < dtos[j-1].ID; j-- {
+			dtos[j], dtos[j-1] = dtos[j-1], dtos[j]
+		}
+	}
+}
+
+// ---- 身份提取辅助（字段名契约标注）----
+
+// ccOAuthAccessTokenField 是 claudeAiOauth 投影内 access token 的字段名
+// （【待实测】契约，design §3.1；缺失时身份查询返回 IDENTITY_UNVERIFIED）。
+const ccOAuthAccessTokenField = "accessToken"
+
+// claudeJSONAccountUUID 从 `.claude.json` oauthAccount 对象取 accountUuid
+// （pi-black claude-code-protocol.ts 已核实的字段）。
+func claudeJSONAccountUUID(oauthAccount json.RawMessage) string {
+	return gjson.GetBytes(oauthAccount, "accountUuid").String()
+}
+
+// claudeJSONEmail 从 oauthAccount 取展示邮箱（仅展示用，design §4.2）。
+func claudeJSONEmail(oauthAccount json.RawMessage) string {
+	return gjson.GetBytes(oauthAccount, "emailAddress").String()
+}
+
+// ccProjectionAccessToken 从 Claude OAuth 投影取 access token。
+func ccProjectionAccessToken(oauth json.RawMessage) string {
+	return gjson.GetBytes(oauth, ccOAuthAccessTokenField).String()
+}
+
+// piAnthropicAccessToken 从 anthropic 条目取 access token（已核实契约）。
+func piAnthropicAccessToken(anthropic json.RawMessage) string {
+	return gjson.GetBytes(anthropic, "access").String()
+}
+
+// fetchPairedIdentity 网络校验双 grant 身份并配对（design §4.2）。
+// expectedAccountUUID 为本地 `.claude.json` 投影的 accountUuid。
+func (s *Service) fetchPairedIdentity(ctx context.Context, native *NativeProjections) (ccID, piID ProfileIdentity, err error) {
+	ccToken := ccProjectionAccessToken(native.ClaudeOAuth)
+	piToken := piAnthropicAccessToken(native.PiAnthropic)
+	if ccToken == "" || piToken == "" {
+		return ProfileIdentity{}, ProfileIdentity{}, NewErr(ReasonIdentityUnverified, "grant 缺少可用的 access token")
+	}
+	ccID, err = s.identity.FetchProfile(ctx, ccToken)
+	if err != nil {
+		return
+	}
+	piID, err = s.identity.FetchProfile(ctx, piToken)
+	if err != nil {
+		return
+	}
+	expected := ""
+	if native.ClaudeIdentity != nil && len(native.ClaudeIdentity.OauthAccount) > 0 {
+		expected = claudeJSONAccountUUID(native.ClaudeIdentity.OauthAccount)
+	}
+	if err = VerifyPairedIdentities(ccID, piID, expected); err != nil {
+		return
+	}
+	return ccID, piID, nil
+}
+
+// ---- capture / enrollment（design §4.1/§4.4）----
+
+// CaptureFirstAccount 保存当前双端登录为首个账号并设为活动账号
+// （design §4.1 步骤 1）。expectedRevision 必须匹配当前池 revision（空池
+// 为 0）。任何错误均不写原生槽位。
+func (s *Service) CaptureFirstAccount(ctx context.Context, alias string, expectedRevision uint64) (AccountDTO, error) {
+	release, err := s.withLocks(ctx, "capture-first")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	if pool != nil && pool.ActiveAccountID != "" {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "已有活动账号，添加另一个账号走 BeginEnrollment")
+	}
+	if pool == nil {
+		pool = NewAccountPool()
+	}
+	if pool.Transaction != nil {
+		return AccountDTO{}, NewErr(ReasonNeedsReconcile, "池存在未结事务，先完成恢复")
+	}
+	if pool.Revision != expectedRevision {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	snap, err := s.captureLocked(ctx, pool, alias, "")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	return snap.ToDTO(pool.ActiveAccountID), nil
+}
+
+// BeginEnrollment 先 harvest 现有活动账号并持久化，再进入 enrolling 状态
+// （design §4.1 步骤 2）。暂停自动与受影响启动由接线层的 admission 语义
+// 承接。返回 enrollmentId（= journal TxnID）。
+func (s *Service) BeginEnrollment(ctx context.Context, expectedRevision uint64) (string, error) {
+	release, err := s.withLocks(ctx, "begin-enrollment")
+	if err != nil {
+		return "", err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return "", err
+	}
+	if pool == nil || pool.ActiveAccountID == "" {
+		return "", NewErr(ReasonPoolMissing, "尚无活动账号，首次录入走 CaptureFirstAccount")
+	}
+	if pool.Transaction != nil {
+		return "", NewErr(ReasonNeedsReconcile, "池存在未结事务，先完成恢复")
+	}
+	if pool.Revision != expectedRevision {
+		return "", NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	gateRelease, err := s.acquireGate(ctx, "begin-enrollment")
+	if err != nil {
+		return "", err
+	}
+	defer gateRelease()
+	if err := s.checkQuiescence(ctx); err != nil {
+		return "", err
+	}
+	// 先 harvest 现有账号（内部完成身份校验与池保存）。
+	if _, _, err := s.harvestLocked(ctx, pool, pool.ActiveAccountID); err != nil {
+		return "", err
+	}
+	txnID, err := newRandomID()
+	if err != nil {
+		return "", err
+	}
+	pool.Transaction = &PoolTransaction{Kind: TransactionEnrollment, Enrollment: &EnrollmentJournal{
+		TxnID: txnID, Harvested: true, StartedAt: s.now(),
+	}}
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return "", err
+	}
+	s.logStep("enrollment-begun", txnID, pool.ActiveAccountID)
+	s.emitEvent(Event{Kind: EventEnrollmentBegun, TxnID: txnID, AccountID: pool.ActiveAccountID})
+	return txnID, nil
+}
+
+// CaptureEnrolledAccount 完成第二个账号的采集（design §4.1 步骤 4-5）：
+// capture 双 grant 身份；不一致不入池、不宣布活动。通过则一次保存 B
+// 快照、active=B、generation+1、清除 enrollment。
+func (s *Service) CaptureEnrolledAccount(ctx context.Context, enrollmentID, alias string, expectedRevision uint64) (AccountDTO, error) {
+	release, err := s.withLocks(ctx, "capture-enrolled")
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	if pool == nil || pool.Transaction == nil || pool.Transaction.Kind != TransactionEnrollment || pool.Transaction.Enrollment == nil {
+		return AccountDTO{}, NewErr(ReasonNeedsReconcile, "不存在进行中的 enrollment")
+	}
+	if pool.Transaction.Enrollment.TxnID != enrollmentID {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "enrollmentId 与池记录不符")
+	}
+	if pool.Revision != expectedRevision {
+		return AccountDTO{}, NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	snap, err := s.captureLocked(ctx, pool, alias, enrollmentID)
+	if err != nil {
+		return AccountDTO{}, err
+	}
+	return snap.ToDTO(pool.ActiveAccountID), nil
+}
+
+// CancelEnrollment 取消录入（design §4.1 末段）：只清 enrollment journal；
+// 若原生槽位在录入期间被登录进程改变，不恢复旧 token 覆盖新值，保持
+// needs-reconcile 由 reconcile 分类。
+func (s *Service) CancelEnrollment(ctx context.Context, expectedRevision uint64) error {
+	release, err := s.withLocks(ctx, "cancel-enrollment")
+	if err != nil {
+		return err
+	}
+	defer release()
+	pool, err := s.loadPoolLocked(ctx)
+	if err != nil {
+		return err
+	}
+	if pool == nil || pool.Transaction == nil || pool.Transaction.Kind != TransactionEnrollment {
+		return NewErr(ReasonNeedsReconcile, "不存在进行中的 enrollment")
+	}
+	if pool.Revision != expectedRevision {
+		return NewErr(ReasonRevisionConflict, "池 revision 期望 %d，实际 %d", expectedRevision, pool.Revision)
+	}
+	txnID := pool.Transaction.Enrollment.TxnID
+	pool.Transaction = nil
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return err
+	}
+	s.logStep("enrollment-cleared", txnID, pool.ActiveAccountID)
+	s.emitEvent(Event{Kind: EventEnrollmentCleared, TxnID: txnID})
+	return nil
+}
+
+// captureLocked 是 capture 伪码（design §4.4）：调用方持锁；任何错误均不
+// 写原生槽位。
+func (s *Service) captureLocked(ctx context.Context, pool *AccountPool, alias, enrollmentID string) (*AccountSnapshot, error) {
+	gateRelease, err := s.acquireGate(ctx, "capture")
+	if err != nil {
+		return nil, err
+	}
+	defer gateRelease()
+	if err := s.checkQuiescence(ctx); err != nil {
+		return nil, err
+	}
+
+	var native *NativeProjections
+	var ccID, piID ProfileIdentity
+	// 网络身份校验结束后再 readStable；有变化则有限重试整个采集。
+	for attempt := 0; attempt < 3; attempt++ {
+		if err := ctxShort(ctx); err != nil {
+			return nil, err
+		}
+		first, err := s.readStableAll(ctx)
+		if err != nil {
+			return nil, err
+		}
+		ccID, piID, err = s.fetchPairedIdentity(ctx, first)
+		if err != nil {
+			return nil, err
+		}
+		second, err := s.readStableAll(ctx)
+		if err != nil {
+			return nil, err
+		}
+		if sameRevisions(first.Revisions, second.Revisions) {
+			native = second
+			break
+		}
+	}
+	if native == nil {
+		return nil, NewErr(ReasonNeedsReconcile, "采集期间原生槽位持续变化")
+	}
+
+	// 构建 AccountSnapshot（各 grant 保留各自原始字段与时间单位）。
+	accountID := ""
+	for id, existing := range pool.Accounts {
+		if existing != nil && existing.Identity.AccountUUID == ccID.AccountUUID &&
+			existing.Identity.OrganizationUUID == ccID.OrganizationUUID {
+			accountID = id // 已有同账号：更新登录，沿用 local ID（design §4.1）
+			break
+		}
+	}
+	if accountID == "" {
+		accountID, err = NewLocalAccountID()
+		if err != nil {
+			return nil, err
+		}
+	}
+	nowT := s.now()
+	old := pool.Accounts[accountID]
+	snap := &AccountSnapshot{
+		ID:        accountID,
+		Alias:     alias,
+		CreatedAt: nowT,
+		UpdatedAt: nowT,
+		Identity: AccountIdentity{
+			AccountUUID:      ccID.AccountUUID,
+			OrganizationUUID: ccID.OrganizationUUID,
+			Email:            claudeJSONEmail(native.ClaudeIdentity.OauthAccount),
+			SeatTier:         ccID.SeatTier,
+		},
+		Claude: ClaudeGrantState{
+			OauthProjection: append(json.RawMessage(nil), native.ClaudeOAuth...),
+			RawCredentialItem: append(json.RawMessage(nil), native.ClaudeOAuthRaw...),
+			StoreLocator:      native.Locator,
+			AdapterVersion:    ClaudeKeychainAdapterVersion,
+			ObservedAt:        nowT,
+			RevisionFingerprint: native.Revisions.ClaudeKeychain,
+		},
+		ClaudeIdentity: ClaudeIdentityFields{
+			OauthAccount: append(json.RawMessage(nil), native.ClaudeIdentity.OauthAccount...),
+			UserID:       native.ClaudeIdentity.UserID,
+		},
+		Pi: PiGrantState{
+			Anthropic:          append(json.RawMessage(nil), native.PiAnthropic...),
+			AdapterVersion:     PiRefreshAdapterVersion,
+			ObservedAt:         nowT,
+			SourceMtimeNS:      native.Revisions.PiAuth.MtimeNS,
+			RevisionFingerprint: native.Revisions.PiAuth,
+		},
+		IdentityEvidence: &IdentityEvidence{
+			CCAccountUUID:  ccID.AccountUUID,
+			PiAccountUUID:  piID.AccountUUID,
+			CheckedAt:      nowT,
+			AdapterVersion: IdentityAdapterVersion,
+		},
+		Health: AccountHealth{ClaudeGrant: HealthReady, PiGrant: HealthReady, IdentityStatus: "verified"},
+	}
+	if old != nil {
+		snap.CreatedAt = old.CreatedAt // 更新登录保留原创建时间
+	}
+	pool.Accounts[accountID] = snap
+	pool.ActiveAccountID = accountID
+	pool.ActiveGeneration++
+	pool.Transaction = nil // 清除 enrollment（design §4.1 步骤 5：一次保存）
+	pool.Revision++
+	if err := s.savePoolLocked(ctx, pool); err != nil {
+		return nil, err
+	}
+	s.logStep("capture-completed", enrollmentID, accountID)
+	s.emitEvent(Event{Kind: EventCaptureCompleted, AccountID: accountID, Generation: pool.ActiveGeneration})
+	return snap, nil
+}
+
+// sameRevisions 比较两处 revision 指纹是否一致。
+func sameRevisions(a, b ExpectedRevisions) bool {
+	return fileRevisionEqual(a.ClaudeKeychain, b.ClaudeKeychain) &&
+		fileRevisionEqual(a.ClaudeJSON, b.ClaudeJSON) &&
+		fileRevisionEqual(a.PiAuth, b.PiAuth)
+}
+
+func fileRevisionEqual(a, b *FileRevision) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	return a.SHA256Hex == b.SHA256Hex && a.ManagedHash == b.ManagedHash
+}
+
+// projectionsEqual 逐投影比较两组受管投影值（语义比较，容忍 JSON 格式
+// 差异；池 envelope 往返会 compact 化，design §4.3 的“hash 相等”以规范形
+// 态为准）。
+func projectionsEqual(a, b OwnedProjections) bool {
+	ccOK := equalJSON(a.ClaudeOAuth, b.ClaudeOAuth)
+	idOK := false
+	if a.ClaudeIdentity == nil && b.ClaudeIdentity == nil {
+		idOK = true
+	} else if a.ClaudeIdentity != nil && b.ClaudeIdentity != nil {
+		idOK = a.ClaudeIdentity.UserID == b.ClaudeIdentity.UserID &&
+			equalJSON(a.ClaudeIdentity.OauthAccount, b.ClaudeIdentity.OauthAccount)
+	}
+	return ccOK && idOK && equalJSON(a.PiAnthropic, b.PiAnthropic)
+}
+
+func bytesEqual(a, b []byte) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// newRandomID 生成随机 UUID（事务 ID 复用同一生成器）。
+func newRandomID() (string, error) { return NewLocalAccountID() }
