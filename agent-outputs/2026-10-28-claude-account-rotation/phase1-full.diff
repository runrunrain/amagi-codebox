+
+describe('遮罩邮箱显隐（credential-free 不变量）', () => {
+  it('未显隐 → 占位符；显隐 → 后端遮罩值本身（正向）', () => {
+    expect(emailMaskDisplay('wo***@example.com', false)).toBe('•••••••@—');
+    expect(emailMaskDisplay('wo***@example.com', true)).toBe('wo***@example.com');
