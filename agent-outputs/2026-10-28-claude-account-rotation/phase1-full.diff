diff --git a/internal/claudeaccounts/nativefile.go b/internal/claudeaccounts/nativefile.go
new file mode 100644
index 0000000..e34c9d5
--- /dev/null
+++ b/internal/claudeaccounts/nativefile.go
@@ -0,0 +1,242 @@
+package claudeaccounts
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+
+	"amagi-codebox/internal/platform"
+)
+
+// canonicalJSON 返回投影的规范（compact）形态。池 envelope 经
+// encoding/json 往返后 RawMessage 会被 compact 化，因此所有跨存储边界
+// 的投影比较与入库统一采用 compact 形态，避免格式差异被误判为内容变化。
+func canonicalJSON(raw []byte) []byte {
+	if len(raw) == 0 {
+		return raw
+	}
+	var buf bytes.Buffer
+	if err := json.Compact(&buf, raw); err != nil {
+		return append([]byte(nil), raw...)
+	}
+	return buf.Bytes()
+}
+
+// equalJSON 语义比较两段 JSON 投影（规范形态后字节比较）。
+func equalJSON(a, b []byte) bool {
+	if len(a) == 0 || len(b) == 0 {
+		return len(a) == len(b)
+	}
+	ca, cb := canonicalJSON(a), canonicalJSON(b)
+	return bytes.Equal(ca, cb)
+}
+
+// readStableAttempts 是 ReadStable 的有限重试次数（design §4.3）。
+const readStableAttempts = 3
+
+// readStableFile 按 lstat→读→stat→hash→重读读取一个稳定文件快照：
+// 拒绝符号链接与非普通文件；两次读取内容不一致视为写入者未静止，重试。
+// 返回字节内容与整文件 revision（受管字段 hash 由调用方补充）。
+func readStableFile(path string) ([]byte, FileRevision, error) {
+	var lastErr error
+	for attempt := 0; attempt < readStableAttempts; attempt++ {
+		linfo, err := os.Lstat(path)
+		if err != nil {
+			if os.IsNotExist(err) {
+				return nil, FileRevision{}, NewErr(ReasonNeedsReconcile, "原生文件缺失（%s）", filepath.Base(path))
+			}
+			return nil, FileRevision{}, NewErr(ReasonNeedsReconcile, "原生文件不可访问（%s）", filepath.Base(path))
+		}
+		if linfo.Mode()&os.ModeSymlink != 0 {
+			return nil, FileRevision{}, NewErr(ReasonNeedsReconcile, "原生文件是符号链接，拒绝读取（%s）", filepath.Base(path))
+		}
+		if !linfo.Mode().IsRegular() {
+			return nil, FileRevision{}, NewErr(ReasonNeedsReconcile, "原生位置不是普通文件（%s）", filepath.Base(path))
+		}
+		first, err := os.ReadFile(path)
+		if err != nil {
+			lastErr = NewErr(ReasonNeedsReconcile, "原生文件读取失败（%s）", filepath.Base(path))
+			continue
+		}
+		info, err := os.Stat(path)
+		if err != nil || !info.Mode().IsRegular() {
+			lastErr = NewErr(ReasonNeedsReconcile, "原生文件在读取中变化（%s）", filepath.Base(path))
+			continue
+		}
+		second, err := os.ReadFile(path)
+		if err != nil {
+			lastErr = NewErr(ReasonNeedsReconcile, "原生文件二次读取失败（%s）", filepath.Base(path))
+			continue
+		}
+		if HashRevision(first) != HashRevision(second) {
+			lastErr = NewErr(ReasonNeedsReconcile, "原生文件在读取期间被并发写入（%s）", filepath.Base(path))
+			continue
+		}
+		return second, FileRevision{
+			SHA256Hex: HashRevision(second),
+			MtimeNS:   info.ModTime().UnixNano(),
+			Ino:       statInode(info),
+			Size:      info.Size(),
+		}, nil
+	}
+	if lastErr == nil {
+		lastErr = NewErr(ReasonNeedsReconcile, "原生文件读取不稳定（%s）", filepath.Base(path))
+	}
+	return nil, FileRevision{}, lastErr
+}
+
+// fileRevisionWithManaged 在整文件 revision 上补充受管字段 hash。
+func fileRevisionWithManaged(rev FileRevision, managed []byte) FileRevision {
+	rev.ManagedHash = HashRevision(managed)
+	return rev
+}
+
+// AtomicWriteResult 记录原子写的结果事实（design §4.4：记录 renamed=true
+// 与目录 sync 失败的区别，恢复不得假定失败表示未改文件）。
+type AtomicWriteResult struct {
+	// Renamed 为 true 表示 rename 已完成，目标路径内容已被替换。
+	Renamed bool
+	// Step 记录失败（或成功）发生的步骤：create-temp/chmod-temp/write-temp/
+	// sync-temp/close-temp/rename/sync-directory。
+	Step string
+}
+
+// writeFileOps 抽象原子写的文件系统原语，供测试按精确步骤注入故障
+// （design §10.1：故障注入用精确步骤，不用 sleep 猜并发）。
+type writeFileOps interface {
+	CreateTemp(dir, pattern string) (*os.File, error)
+	Sync(f *os.File) error
+	Close(f *os.File) error
+	Rename(oldPath, newPath string) error
+	Remove(path string) error
+	SyncDir(dir string) error
+	Chmod(path string, mode os.FileMode) error
+}
+
+type osWriteFileOps struct{}
+
+func (osWriteFileOps) CreateTemp(dir, pattern string) (*os.File, error) {
+	return os.CreateTemp(dir, pattern)
+}
+func (osWriteFileOps) Sync(f *os.File) error { return f.Sync() }
+func (osWriteFileOps) Close(f *os.File) error { return f.Close() }
+func (osWriteFileOps) Rename(oldPath, newPath string) error { return os.Rename(oldPath, newPath) }
+func (osWriteFileOps) Remove(path string) error { return os.Remove(path) }
+func (osWriteFileOps) SyncDir(dir string) error { return platform.SyncConfigDirectory(dir) }
+func (osWriteFileOps) Chmod(path string, mode os.FileMode) error { return os.Chmod(path, mode) }
+
+// writeAtomicFile 同目录临时文件 0600→write→fsync→close→rename→父目录
+// fsync（design §4.4，语义参考 launch_executor.go:593-643）。不对已存在
+// 目录做 chmod，绝不对 HOME 做 chmod 0700；只有新建的专用子目录用 0700。
+// 失败时清理未 rename 的临时文件；崩溃残留仅在确认属于本次事务后清理
+// （见 service 恢复流程），本函数不管辖。
+func writeAtomicFile(path string, content []byte, ops writeFileOps) (AtomicWriteResult, error) {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return AtomicWriteResult{Step: "mkdir"}, NewErr(ReasonNeedsReconcile, "原生文件目录不可用")
+	}
+	// 记录原文件 mode（若存在）：rename 后恢复，避免无谓改变他人文件的
+	// 权限语义；新文件保持 0600。
+	origMode := os.FileMode(0)
+	if info, err := os.Stat(path); err == nil {
+		origMode = info.Mode().Perm()
+	}
+	tmp, err := ops.CreateTemp(dir, "."+filepath.Base(path)+".claudeaccounts-*")
+	if err != nil {
+		return AtomicWriteResult{Step: "create-temp"}, NewErr(ReasonNeedsReconcile, "临时文件创建失败")
+	}
+	tmpPath := tmp.Name()
+	closed := false
+	defer func() {
+		if !closed {
+			_ = tmp.Close()
+		}
+		_ = ops.Remove(tmpPath)
+	}()
+	if err := tmp.Chmod(0o600); err != nil {
+		return AtomicWriteResult{Step: "chmod-temp"}, NewErr(ReasonNeedsReconcile, "临时文件权限设置失败")
+	}
+	if _, err := tmp.Write(content); err != nil {
+		return AtomicWriteResult{Step: "write-temp"}, NewErr(ReasonNeedsReconcile, "临时文件写入失败")
+	}
+	if err := ops.Sync(tmp); err != nil {
+		return AtomicWriteResult{Step: "sync-temp"}, NewErr(ReasonNeedsReconcile, "临时文件 fsync 失败")
+	}
+	if err := ops.Close(tmp); err != nil {
+		closed = true
+		return AtomicWriteResult{Step: "close-temp"}, NewErr(ReasonNeedsReconcile, "临时文件关闭失败")
+	}
+	closed = true
+	if err := ops.Rename(tmpPath, path); err != nil {
+		return AtomicWriteResult{Step: "rename"}, NewErr(ReasonNeedsReconcile, "原子替换失败")
+	}
+	if origMode != 0 && origMode.Perm() != 0o600 {
+		if err := ops.Chmod(path, origMode.Perm()); err != nil {
+			return AtomicWriteResult{Renamed: true, Step: "chmod-target"}, NewErr(ReasonNeedsReconcile, "目标文件权限恢复失败（文件已替换）")
+		}
+	}
+	if err := ops.SyncDir(dir); err != nil {
+		// rename 已完成：文件已变，目录未落盘。区别记录，不回滚。
+		return AtomicWriteResult{Renamed: true, Step: "sync-directory"}, NewErr(ReasonNeedsReconcile, "目录 fsync 失败（文件已替换）")
+	}
+	return AtomicWriteResult{Renamed: true, Step: "sync-directory"}, nil
+}
+
+// sjsonSetRawBytes 用 sjson 做字段级 setRaw，保留其余字节片段。
+func sjsonSetRawBytes(jsonBytes []byte, path string, value []byte) ([]byte, error) {
+	return sjson.SetRawBytes(jsonBytes, path, value)
+}
+
+// topKeyNames 列出 JSON 对象的顶层键名（排序稳定），用于「非拥有字段未
+// 损坏」校验：只比较键名集合与值，不复制值出存储边界。
+func topKeyNames(data []byte) []string {
+	root := gjson.ParseBytes(data)
+	if !root.IsObject() {
+		return nil
+	}
+	names := make([]string, 0, len(root.Map()))
+	for name := range root.Map() {
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+// sameStringSet 报告两个有序键名切片是否为同一集合。
+func sameStringSet(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// validateJSONBytes 校验字节是合法 JSON（design §4.3：拒绝非法 JSON）。
+func validateJSONBytes(data []byte, what string) error {
+	if !gjson.ValidBytes(data) {
+		return NewErr(ReasonUnsupportedCredentialSchema, "%s 不是合法 JSON", what)
+	}
+	return nil
+}
+
+// ctxShort 检查 ctx 已取消（用于长事务各阶段入口；取消不抹除已写事实，
+// 由调用方 journal 处理，design §10.1 swap/reconcile 行）。
+func ctxShort(ctx context.Context) error {
+	if err := ctx.Err(); err != nil {
+		return NewErr(ReasonNeedsReconcile, "操作已取消（已写入内容以回读为准）: %v", ctxErrString(err))
+	}
+	return nil
+}
+
+func ctxErrString(err error) string { return fmt.Sprint(err) }
diff --git a/internal/claudeaccounts/nativefiles.go b/internal/claudeaccounts/nativefiles.go
new file mode 100644
index 0000000..f6e59e1
--- /dev/null
+++ b/internal/claudeaccounts/nativefiles.go
@@ -0,0 +1,350 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strconv"
+	"sync"
+
+	"github.com/tidwall/gjson"
+)
+
+// ClaudeKeychainAccess 是 Claude Code 凭据 Keychain 项的访问边界。
+// 生产实现为 macOS Keychain（nativecc_darwin.go）；测试注入 fake，
+// 绝不触碰真实 Keychain。
+type ClaudeKeychainAccess interface {
+	// LocateItem 按 service 查唯一匹配项；零项报缺失、多项报歧义
+	// （design §3.1）。
+	LocateItem(ctx context.Context) (*KeychainLocator, error)
+	// ReadItem 读取项完整字节。
+	ReadItem(ctx context.Context, loc *KeychainLocator) ([]byte, error)
+	// UpdateItem 原位更新项内容（保留既有 ACL，不 delete+add）。
+	UpdateItem(ctx context.Context, loc *KeychainLocator, item []byte) error
+}
+
+// FileCredentialPaths 是两处原生凭据文件的注入路径（design §10.1：测试
+// 临时目录必须通过依赖注入覆盖所有路径）。
+type FileCredentialPaths struct {
+	ClaudeJSONPath string // 默认 ~/.claude.json
+	PiAuthPath     string // 默认 ~/.pi/agent/auth.json
+}
+
+// DefaultFileCredentialPaths 返回 canonical 路径（design §4：标准 agent
+// root 固定，PI_CODING_AGENT_DIR 不参与凭据读写判断）。
+func DefaultFileCredentialPaths() (FileCredentialPaths, error) {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return FileCredentialPaths{}, err
+	}
+	return FileCredentialPaths{
+		ClaudeJSONPath: filepath.Join(home, ".claude.json"),
+		PiAuthPath:     filepath.Join(home, ".pi", "agent", "auth.json"),
+	}, nil
+}
+
+// FileCredentialStore 是 `.claude.json` 与 `~/.pi/agent/auth.json` 的字段级
+// patch 适配器。写入全部走原子写（nativefile.go），写入前后做回读验证。
+type FileCredentialStore struct {
+	paths FileCredentialPaths
+	ops   writeFileOps
+}
+
+// NewFileCredentialStore 构造文件投影适配器；ops 为 nil 时使用真实文件系统。
+func NewFileCredentialStore(paths FileCredentialPaths, ops writeFileOps) *FileCredentialStore {
+	if ops == nil {
+		ops = osWriteFileOps{}
+	}
+	return &FileCredentialStore{paths: paths, ops: ops}
+}
+
+// Paths 返回注入的路径（仅供接线层与测试）。
+func (s *FileCredentialStore) Paths() FileCredentialPaths { return s.paths }
+
+// ClaudeJSONState 是 `.claude.json` 的受管投影读取结果。
+type ClaudeJSONState struct {
+	Fields     ClaudeIdentityFields
+	Revision   FileRevision
+	OtherTopKeys []string
+}
+
+// ReadClaudeJSON 读取 `.claude.json` 的受管字段（oauthAccount + userID）。
+func (s *FileCredentialStore) ReadClaudeJSON(ctx context.Context) (*ClaudeJSONState, error) {
+	_ = ctx
+	data, rev, err := readStableFile(s.paths.ClaudeJSONPath)
+	if err != nil {
+		return nil, err
+	}
+	if err := validateJSONBytes(data, ".claude.json"); err != nil {
+		return nil, err
+	}
+	oauth := gjson.GetBytes(data, "oauthAccount")
+	userID := gjson.GetBytes(data, "userID")
+	if !oauth.Exists() || !oauth.IsObject() {
+		return nil, NewErr(ReasonNeedsLogin, ".claude.json 缺少 oauthAccount（未登录 Claude Code）")
+	}
+	if !userID.Exists() || userID.Type != gjson.String {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, ".claude.json 缺少 userID 字符串字段")
+	}
+	fields := ClaudeIdentityFields{OauthAccount: canonicalJSON([]byte(oauth.Raw)), UserID: userID.String()}
+	rev = fileRevisionWithManaged(rev, managedClaudeIdentityHash(fields))
+	return &ClaudeJSONState{
+		Fields:       fields,
+		Revision:     rev,
+		OtherTopKeys: topKeyNames(data),
+	}, nil
+}
+
+// PatchClaudeIdentity 字段级替换 oauthAccount 与 userID（design §1.3-4）。
+// 其他顶层字段与原字节片段保留（sjson 字段级 patch）；写入后回读验证。
+func (s *FileCredentialStore) PatchClaudeIdentity(ctx context.Context, fields ClaudeIdentityFields) (*FileRevision, error) {
+	_ = ctx
+	before, err := s.ReadClaudeJSON(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if len(fields.OauthAccount) == 0 || !gjson.ValidBytes(fields.OauthAccount) {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "oauthAccount 替换值不是合法 JSON 对象")
+	}
+	data, _, err := readStableFile(s.paths.ClaudeJSONPath)
+	if err != nil {
+		return nil, err
+	}
+	next, err := sjsonSetRawBytes(data, "oauthAccount", fields.OauthAccount)
+	if err != nil {
+		return nil, NewErr(ReasonNeedsReconcile, "oauthAccount 字段替换失败")
+	}
+	userQuoted, err := json.Marshal(fields.UserID)
+	if err != nil {
+		return nil, NewErr(ReasonNeedsReconcile, "userID 编码失败")
+	}
+	next, err = sjsonSetRawBytes(next, "userID", userQuoted)
+	if err != nil {
+		return nil, NewErr(ReasonNeedsReconcile, "userID 字段替换失败")
+	}
+	if _, err := writeAtomicFile(s.paths.ClaudeJSONPath, next, s.ops); err != nil {
+		return nil, err
+	}
+	return s.verifyClaudeJSON(ctx, fields, before.OtherTopKeys)
+}
+
+func (s *FileCredentialStore) verifyClaudeJSON(ctx context.Context, want ClaudeIdentityFields, beforeKeys []string) (*FileRevision, error) {
+	after, err := s.ReadClaudeJSON(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if !equalJSON(after.Fields.OauthAccount, want.OauthAccount) || after.Fields.UserID != want.UserID {
+		return nil, NewErr(ReasonNeedsReconcile, ".claude.json 回读与期望不符")
+	}
+	if !sameStringSet(beforeKeys, after.OtherTopKeys) {
+		return nil, NewErr(ReasonNeedsReconcile, ".claude.json 顶层键集合在写入后变化")
+	}
+	return &after.Revision, nil
+}
+
+// PiAuthState 是 auth.json 的受管投影读取结果。
+type PiAuthState struct {
+	Anthropic  json.RawMessage
+	Revision   FileRevision
+	OtherTopKeys []string
+}
+
+// ReadPiAuth 读取 auth.json 的 anthropic 条目（仅此一键）。
+func (s *FileCredentialStore) ReadPiAuth(ctx context.Context) (*PiAuthState, error) {
+	_ = ctx
+	data, rev, err := readStableFile(s.paths.PiAuthPath)
+	if err != nil {
+		return nil, err
+	}
+	if err := validateJSONBytes(data, "auth.json"); err != nil {
+		return nil, err
+	}
+	anthropic := gjson.GetBytes(data, "anthropic")
+	if !anthropic.Exists() || !anthropic.IsObject() {
+		return nil, NewErr(ReasonNeedsLogin, "auth.json 缺少 anthropic oauth 条目（未登录 Pi）")
+	}
+	raw := canonicalJSON([]byte(anthropic.Raw))
+	if err := ValidatePiAnthropicEntry(raw); err != nil {
+		return nil, err
+	}
+	rev = fileRevisionWithManaged(rev, raw)
+	return &PiAuthState{Anthropic: raw, Revision: rev, OtherTopKeys: topKeyNames(data)}, nil
+}
+
+// PatchPiAnthropic 仅替换 auth.json 的 anthropic 键（design §1.3-4），
+// 其他 provider 条目原样保留；写入后回读验证。
+func (s *FileCredentialStore) PatchPiAnthropic(ctx context.Context, anthropic json.RawMessage) (*FileRevision, error) {
+	_ = ctx
+	if err := ValidatePiAnthropicEntry(anthropic); err != nil {
+		return nil, err
+	}
+	before, err := s.ReadPiAuth(ctx)
+	if err != nil {
+		return nil, err
+	}
+	data, _, err := readStableFile(s.paths.PiAuthPath)
+	if err != nil {
+		return nil, err
+	}
+	next, err := sjsonSetRawBytes(data, "anthropic", anthropic)
+	if err != nil {
+		return nil, NewErr(ReasonNeedsReconcile, "auth.json anthropic 字段替换失败")
+	}
+	if _, err := writeAtomicFile(s.paths.PiAuthPath, next, s.ops); err != nil {
+		return nil, err
+	}
+	return s.verifyPiAuth(ctx, anthropic, before.OtherTopKeys)
+}
+
+func (s *FileCredentialStore) verifyPiAuth(ctx context.Context, want json.RawMessage, beforeKeys []string) (*FileRevision, error) {
+	after, err := s.ReadPiAuth(ctx)
+	if err != nil {
+		return nil, err
+	}
+	if !equalJSON(after.Anthropic, want) {
+		return nil, NewErr(ReasonNeedsReconcile, "auth.json 回读与期望不符")
+	}
+	if !sameStringSet(beforeKeys, after.OtherTopKeys) {
+		return nil, NewErr(ReasonNeedsReconcile, "auth.json 顶层键集合在写入后变化")
+	}
+	return &after.Revision, nil
+}
+
+// CombinedNativeStore 组合文件投影与 Claude Code Keychain 访问，实现
+// NativeCredentialStore 的生产形态（测试可用真实 tempdir 文件 + fake
+// Keychain 组合）。
+type CombinedNativeStore struct {
+	files    *FileCredentialStore
+	keychain ClaudeKeychainAccess
+
+	mu      sync.Mutex
+	locator *KeychainLocator
+}
+
+// NewCombinedNativeStore 构造组合适配器。
+func NewCombinedNativeStore(files *FileCredentialStore, keychain ClaudeKeychainAccess) *CombinedNativeStore {
+	return &CombinedNativeStore{files: files, keychain: keychain}
+}
+
+// Kind 返回后端标识。
+func (c *CombinedNativeStore) Kind() string { return "combined" }
+
+// locatedItem 返回缓存的 locator；缓存失效（项被删）时重新定位一次。
+func (c *CombinedNativeStore) locatedItem(ctx context.Context) (*KeychainLocator, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.locator != nil {
+		if _, err := c.keychain.ReadItem(ctx, c.locator); err == nil {
+			return c.locator, nil
+		} else if ReasonOf(err) != ReasonNeedsLogin {
+			return nil, err
+		}
+		// 项消失：重新定位（可能被外部重建为不同 account）。
+	}
+	loc, err := c.keychain.LocateItem(ctx)
+	if err != nil {
+		return nil, err
+	}
+	c.locator = loc
+	return loc, nil
+}
+
+// ReadStable 读取三处受管投影的稳定快照。
+func (c *CombinedNativeStore) ReadStable(ctx context.Context) (*NativeProjections, error) {
+	loc, err := c.locatedItem(ctx)
+	if err != nil {
+		return nil, err
+	}
+	item, err := c.keychain.ReadItem(ctx, loc)
+	if err != nil {
+		return nil, err
+	}
+	if err := validateJSONBytes(item, "Claude Code Keychain 项"); err != nil {
+		return nil, err
+	}
+	oauth, err := ExtractClaudeOAuthProjection(item)
+	if err != nil {
+		return nil, err
+	}
+	cj, err := c.files.ReadClaudeJSON(ctx)
+	if err != nil {
+		return nil, err
+	}
+	pa, err := c.files.ReadPiAuth(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &NativeProjections{
+		ClaudeOAuth:     oauth,
+		ClaudeOAuthRaw:  json.RawMessage(item),
+		Locator:         loc,
+		ClaudeIdentity:  &cj.Fields,
+		PiAnthropic:     pa.Anthropic,
+		PiOtherProviders: pa.OtherTopKeys,
+		ClaudeJSONOtherTopKeys: cj.OtherTopKeys,
+		Revisions: ExpectedRevisions{
+			ClaudeKeychain: &FileRevision{SHA256Hex: HashRevision(item), ManagedHash: HashRevision(oauth)},
+			ClaudeJSON:     &cj.Revision,
+			PiAuth:         &pa.Revision,
+		},
+	}, nil
+}
+
+// PatchClaudeKeychainOAuth 替换 Keychain 项内的 OAuth 投影，保留未知顶层
+// 兄弟字段；写入后回读验证。
+func (c *CombinedNativeStore) PatchClaudeKeychainOAuth(ctx context.Context, oauth json.RawMessage) (*FileRevision, error) {
+	loc, err := c.locatedItem(ctx)
+	if err != nil {
+		return nil, err
+	}
+	item, err := c.keychain.ReadItem(ctx, loc)
+	if err != nil {
+		return nil, err
+	}
+	next, err := PatchClaudeKeychainItemBytes(item, oauth)
+	if err != nil {
+		return nil, err
+	}
+	if err := c.keychain.UpdateItem(ctx, loc, next); err != nil {
+		return nil, err
+	}
+	reloaded, err := c.keychain.ReadItem(ctx, loc)
+	if err != nil {
+		return nil, err
+	}
+	got, err := ExtractClaudeOAuthProjection(reloaded)
+	if err != nil {
+		return nil, err
+	}
+	if !equalJSON(got, oauth) {
+		return nil, NewErr(ReasonNeedsReconcile, "Claude Code Keychain 回读投影与期望不符")
+	}
+	// 非拥有顶层兄弟字段保持不变（design §3.1：不跨账号复制未知字段）。
+	if !sameStringSet(topKeyNames(item), topKeyNames(reloaded)) {
+		return nil, NewErr(ReasonNeedsReconcile, "Claude Code Keychain 顶层字段集合在写入后变化")
+	}
+	rev := FileRevision{SHA256Hex: HashRevision(reloaded), ManagedHash: HashRevision(got)}
+	return &rev, nil
+}
+
+// PatchClaudeIdentity 代理到文件适配器。
+func (c *CombinedNativeStore) PatchClaudeIdentity(ctx context.Context, fields ClaudeIdentityFields) (*FileRevision, error) {
+	return c.files.PatchClaudeIdentity(ctx, fields)
+}
+
+// PatchPiAnthropic 代理到文件适配器。
+func (c *CombinedNativeStore) PatchPiAnthropic(ctx context.Context, anthropic json.RawMessage) (*FileRevision, error) {
+	return c.files.PatchPiAnthropic(ctx, anthropic)
+}
+
+// managedClaudeIdentityHash 计算受管身份字段的组合 hash（长度前缀消除
+// 分隔歧义，oauthAccount 与 userID 都参与）。
+func managedClaudeIdentityHash(fields ClaudeIdentityFields) []byte {
+	buf := strconv.AppendInt(make([]byte, 0, len(fields.OauthAccount)+len(fields.UserID)+32), int64(len(fields.OauthAccount)), 10)
+	buf = append(buf, ':')
+	buf = append(buf, fields.OauthAccount...)
+	buf = append(buf, '|')
+	buf = append(buf, fields.UserID...)
+	return buf
+}
diff --git a/internal/claudeaccounts/oauth.go b/internal/claudeaccounts/oauth.go
new file mode 100644
index 0000000..70e0808
--- /dev/null
+++ b/internal/claudeaccounts/oauth.go
@@ -0,0 +1,182 @@
+package claudeaccounts
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"net/http"
+	"time"
+)
+
+// Pi OAuth 刷新协议常量（design §5.1 已核实；与 pi-ai 安装源码
+// dist/auth/oauth/anthropic.js 的 CLIENT_ID/TOKEN_URL/refresh 常量一致）。
+const (
+	PiTokenURL            = "https://platform.claude.com/v1/oauth/token"
+	PiOAuthClientID        = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
+	PiRefreshAdapterVersion = "pi-oauth-refresh-v1"
+	// piRefreshExpirySafety 与 Pi 一致：expires = now + expires_in×1000 − 5min。
+	piRefreshExpirySafety = 5 * time.Minute
+)
+
+// GrantRefreshResult 是一次成功刷新得到的 token 对。
+type GrantRefreshResult struct {
+	AccessToken  string
+	RefreshToken string
+	ExpiresAt    time.Time
+}
+
+// tokenResponse 是刷新响应的最小校验视图（严格有限数值校验）。
+type tokenResponse struct {
+	AccessToken  string  `json:"access_token"`
+	RefreshToken string  `json:"refresh_token"`
+	ExpiresIn    float64 `json:"expires_in"`
+	Error        string  `json:"error"`
+}
+
+// postTokenRequest 发送刷新 POST 并返回解析结果。错误分类（design §5.1）：
+// invalid_grant → NEEDS_LOGIN；其余任何失败（网络/超时/取消/其他状态码/
+// 响应不可解析）→ REFRESH_UNCERTAIN——请求可能已被服务器处理并轮换了
+// refresh token，不可当作“凭据未动”。错误消息不含 token 与响应原文。
+func postTokenRequest(ctx context.Context, client *http.Client, tokenURL string, body map[string]string) (tokenResponse, error) {
+	payload, err := json.Marshal(body)
+	if err != nil {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新请求构造失败")
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, tokenURL, bytes.NewReader(payload))
+	if err != nil {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新请求构造失败")
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := client.Do(req)
+	if err != nil {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新请求未获响应（结果不确定）")
+	}
+	respBody, err := readBoundedBody(resp)
+	if err != nil {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新响应不可读（结果不确定）")
+	}
+	var parsed tokenResponse
+	parseErr := json.Unmarshal(respBody, &parsed)
+	if resp.StatusCode != http.StatusOK {
+		if parseErr == nil && parsed.Error == "invalid_grant" {
+			return tokenResponse{}, NewErr(ReasonNeedsLogin, "refresh token 已失效（invalid_grant）")
+		}
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新请求被拒（HTTP %d，结果不确定）", resp.StatusCode)
+	}
+	if parseErr != nil {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新响应不可解析（结果不确定）")
+	}
+	if parsed.AccessToken == "" || parsed.RefreshToken == "" {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新响应缺少 token 字段（结果不确定）")
+	}
+	if parsed.ExpiresIn <= 0 || parsed.ExpiresIn > 1e7 {
+		return tokenResponse{}, NewErr(ReasonRefreshUncertain, "刷新响应 expires_in 非有限正数（结果不确定）")
+	}
+	return parsed, nil
+}
+
+// PiRefreshAdapter 是 Pi anthropic grant 的刷新适配器（协议常量已核实）。
+type PiRefreshAdapter struct {
+	client *http.Client
+}
+
+// NewPiRefreshAdapter 构造 Pi 刷新适配器。
+func NewPiRefreshAdapter(client *http.Client) *PiRefreshAdapter {
+	return &PiRefreshAdapter{client: client}
+}
+
+// AdapterVersion 返回适配器版本标识。
+func (a *PiRefreshAdapter) AdapterVersion() string { return PiRefreshAdapterVersion }
+
+// Refresh 执行 grant_type=refresh_token 刷新并返回新 anthropic 条目 JSON
+// （type=oauth、access、refresh、expires 毫秒 epoch，与 Pi 存储一致）。
+func (a *PiRefreshAdapter) Refresh(ctx context.Context, refreshToken string) (GrantRefreshResult, error) {
+	result, err := postTokenRequest(ctx, a.client, PiTokenURL, map[string]string{
+		"grant_type":    "refresh_token",
+		"client_id":     PiOAuthClientID,
+		"refresh_token": refreshToken,
+	})
+	if err != nil {
+		return GrantRefreshResult{}, err
+	}
+	expires := time.Now().Add(time.Duration(result.ExpiresIn*1000)*time.Millisecond - piRefreshExpirySafety)
+	return GrantRefreshResult{AccessToken: result.AccessToken, RefreshToken: result.RefreshToken, ExpiresAt: expires}, nil
+}
+
+// BuildPiAnthropicEntry 用刷新结果构造 anthropic 条目 JSON（expires 为
+// 毫秒 epoch，设计 §5.1）。
+func BuildPiAnthropicEntry(result GrantRefreshResult) (json.RawMessage, error) {
+	entry := PiAnthropicEntry{
+		Type:    "oauth",
+		Access:  result.AccessToken,
+		Refresh: result.RefreshToken,
+		Expires: float64(result.ExpiresAt.UnixMilli()),
+	}
+	if err := ValidatePiAnthropicEntry(mustMarshalEntry(entry)); err != nil {
+		return nil, err
+	}
+	return mustMarshalEntry(entry), nil
+}
+
+func mustMarshalEntry(entry PiAnthropicEntry) json.RawMessage {
+	data, _ := json.Marshal(entry)
+	return data
+}
+
+// CCRefreshProtocol 描述 Claude Code 刷新协议契约。设计 §5.1：CC 对应
+// client_id、scope 和 expiresAt 单位【待实测】，与 Pi 相同也要有独立证据。
+// Verified=false 时适配器拒绝刷新——不猜常量（design §5.1）；ExpiresUnit
+// 为 "seconds"/"milliseconds"，真机验证后由接线层注入。
+type CCRefreshProtocol struct {
+	Verified    bool
+	TokenURL    string
+	ClientID    string
+	ExpiresUnit string
+}
+
+// CCRefreshAdapter 是 Claude Code grant 的刷新适配器：结构完整、协议常量
+// 留 adapterVersion 门。真机验证（design §10.2 步骤 4）通过后由接线层
+// 注入 Verified 协议常量。
+type CCRefreshAdapter struct {
+	Protocol CCRefreshProtocol
+	client   *http.Client
+}
+
+// CCRefreshAdapterVersion 返回适配器版本；未验证协议以 “unverified” 标记。
+func (a *CCRefreshAdapter) AdapterVersion() string {
+	if a.Protocol.Verified {
+		return "cc-oauth-refresh-v1"
+	}
+	return "cc-oauth-refresh-unverified"
+}
+
+// NewCCRefreshAdapter 构造 CC 刷新适配器。
+func NewCCRefreshAdapter(client *http.Client, protocol CCRefreshProtocol) *CCRefreshAdapter {
+	return &CCRefreshAdapter{client: client, Protocol: protocol}
+}
+
+// Refresh 在协议未验证时返回需验证状态（UNSUPPORTED_CREDENTIAL_SCHEMA），
+// 不执行网络请求；协议验证后行为与 Pi 适配器同构。
+func (a *CCRefreshAdapter) Refresh(ctx context.Context, refreshToken string) (GrantRefreshResult, error) {
+	if !a.Protocol.Verified || a.Protocol.TokenURL == "" || a.Protocol.ClientID == "" {
+		return GrantRefreshResult{}, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code 刷新协议未验证（adapterVersion 门），拒绝猜测常量")
+	}
+	switch a.Protocol.ExpiresUnit {
+	case "seconds", "milliseconds":
+	default:
+		// expiresAt 单位【待实测】：未注入明确单位前不推导过期时间。
+		return GrantRefreshResult{}, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code 刷新协议 expiresAt 单位未验证，拒绝猜测")
+	}
+	result, err := postTokenRequest(ctx, a.client, a.Protocol.TokenURL, map[string]string{
+		"grant_type":    "refresh_token",
+		"client_id":     a.Protocol.ClientID,
+		"refresh_token": refreshToken,
+	})
+	if err != nil {
+		return GrantRefreshResult{}, err
+	}
+	// CC 侧 expiresAt 单位待真机验证；单位注入前不换算为时间。
+	return GrantRefreshResult{AccessToken: result.AccessToken, RefreshToken: result.RefreshToken}, nil
+}
diff --git a/internal/claudeaccounts/oauth_test.go b/internal/claudeaccounts/oauth_test.go
new file mode 100644
index 0000000..4f789f8
--- /dev/null
+++ b/internal/claudeaccounts/oauth_test.go
@@ -0,0 +1,312 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+// OAuth/identity 组（design §10.1 矩阵第 5 行）：全部通过注入
+// RoundTripper 访问隔离 fake，不触网。
+
+func newRefreshAdapter(t *testing.T, handler func(*http.Request) (*http.Response, error)) (*PiRefreshAdapter, *fakeTransport) {
+	t.Helper()
+	transport := &fakeTransport{handler: handler}
+	return NewPiRefreshAdapter(NewConstrainedHTTPClient(transport)), transport
+}
+
+// TestPiRefreshProtocolConstants：已核实协议常量与请求/响应契约
+// （design §5.1：token URL、grant_type/client_id/refresh_token、
+// expires=now+expires_in×1000−5min）。
+func TestPiRefreshProtocolConstants(t *testing.T) {
+	adapter, transport := newRefreshAdapter(t, func(req *http.Request) (*http.Response, error) {
+		return httpResponse(200, `{"access_token":"new-access","refresh_token":"new-refresh","expires_in":3600}`), nil
+	})
+	result, err := adapter.Refresh(context.Background(), "old-refresh")
+	if err != nil {
+		t.Fatalf("refresh: %v", err)
+	}
+	if result.AccessToken != "new-access" || result.RefreshToken != "new-refresh" {
+		t.Fatalf("token 对不符: %+v", result)
+	}
+	// expires = now + expires_in*1000 - 5min（毫秒语义换算为时间）。
+	want := time.Now().Add(time.Duration(3600*1000)*time.Millisecond - 5*time.Minute)
+	if result.ExpiresAt.Sub(want) > 2*time.Second || want.Sub(result.ExpiresAt) > 2*time.Second {
+		t.Fatalf("ExpiresAt 偏差过大: %v vs %v", result.ExpiresAt, want)
+	}
+	// 请求契约。
+	if len(transport.calls) != 1 {
+		t.Fatalf("期望恰好一次请求，实际 %d", len(transport.calls))
+	}
+	call := transport.calls[0]
+	if call.URL.String() != PiTokenURL {
+		t.Fatalf("token URL 应为固定常量，实际 %s", call.URL.String())
+	}
+	if call.Method != http.MethodPost {
+		t.Fatal("必须 POST")
+	}
+	var body map[string]string
+	_ = json.NewDecoder(call.Body).Decode(&body)
+	if body["grant_type"] != "refresh_token" || body["client_id"] != PiOAuthClientID || body["refresh_token"] != "old-refresh" {
+		t.Fatalf("刷新请求字段不符: %+v", body)
+	}
+	// 构造 anthropic 条目并验证 schema。
+	entry, err := BuildPiAnthropicEntry(result)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := ValidatePiAnthropicEntry(entry); err != nil {
+		t.Fatalf("构造的条目应满足 schema: %v", err)
+	}
+}
