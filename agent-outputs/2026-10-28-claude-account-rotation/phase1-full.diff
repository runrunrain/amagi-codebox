new file mode 100644
index 0000000..1e8dc22
--- /dev/null
+++ b/internal/claudeaccounts/lock.go
@@ -0,0 +1,34 @@
+package claudeaccounts
+
+import (
+	"os"
+	"path/filepath"
+)
+
+// DefaultPoolLockPath 返回跨进程锁文件的默认路径
+// ~/.amagi-codebox/claude-accounts.lock（design §3.3）。锁文件不含任何秘密。
+// 生产接线可覆盖；测试必须注入 tempdir 路径。
+func DefaultPoolLockPath() (string, error) {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "", err
+	}
+	return filepath.Join(home, ".amagi-codebox", "claude-accounts.lock"), nil
+}
+
+// crossProcessLock 是进程间互斥锁句柄；获取/释放的平台实现见 lock_unix.go
+// 与 lock_windows.go。
+type crossProcessLock struct {
+	path string
+	file fileHandle
+}
+
+// release 释放跨进程锁（幂等）。
+func (l *crossProcessLock) release() {
+	if l == nil || l.file == nil {
+		return
+	}
+	_ = unlockFile(l.file)
+	_ = l.file.Close()
+	l.file = nil
+}
diff --git a/internal/claudeaccounts/lock_unix.go b/internal/claudeaccounts/lock_unix.go
new file mode 100644
index 0000000..83357fb
--- /dev/null
+++ b/internal/claudeaccounts/lock_unix.go
@@ -0,0 +1,34 @@
+//go:build !windows
+
+package claudeaccounts
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+// fileHandle 抽象平台文件句柄。
+type fileHandle = *os.File
+
+// acquireFileLock 用 flock 系统调用获取跨进程互斥锁（design §3.3：使用系统
+// 调用能力，不引第三方库）。非阻塞；被他人持有时返回 POOL_LOCKED。
+func acquireFileLock(path string) (*crossProcessLock, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return nil, NewErr(ReasonPoolLocked, "账号池锁目录不可用")
+	}
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR, 0o600)
+	if err != nil {
+		return nil, NewErr(ReasonPoolLocked, "账号池锁文件不可用")
+	}
+	if err := syscall.Flock(int(f.Fd()), syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		_ = f.Close()
+		return nil, NewErr(ReasonPoolLocked, "账号池锁被其他进程持有")
+	}
+	return &crossProcessLock{path: path, file: f}, nil
+}
+
+// unlockFile 释放 flock。
+func unlockFile(f *os.File) error {
+	return syscall.Flock(int(f.Fd()), syscall.LOCK_UN)
+}
diff --git a/internal/claudeaccounts/lock_windows.go b/internal/claudeaccounts/lock_windows.go
