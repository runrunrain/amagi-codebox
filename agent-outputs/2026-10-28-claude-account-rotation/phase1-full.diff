+	env.identityFake.responses["pi-a-3"] = ProfileIdentity{AccountUUID: syntheticUUIDA}
+	if _, err := env.svc.HarvestActive(context.Background(), rev); err != nil {
+		t.Fatalf("harvest: %v", err)
