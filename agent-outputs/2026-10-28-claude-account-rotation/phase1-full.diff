@@ -0,0 +1,21 @@
+//go:build windows
+
+package claudeaccounts
+
+import "os"
+
+// fileHandle 抽象平台文件句柄。
+type fileHandle = *os.File
+
+// acquireFileLock 在 Windows 上返回 UNSUPPORTED_PLATFORM：设计 §8 规定 v1
+// macOS only，Windows 的账号池 mutation 一律 unsupported。
+func acquireFileLock(path string) (*crossProcessLock, error) {
+	_ = path
+	return nil, NewErr(ReasonUnsupportedPlatform, "账号池跨进程锁仅支持 macOS/Unix")
+}
+
+// unlockFile 在 Windows 上不可达。
+func unlockFile(f *os.File) error {
+	_ = f
+	return NewErr(ReasonUnsupportedPlatform, "账号池跨进程锁仅支持 macOS/Unix")
+}
diff --git a/internal/claudeaccounts/native.go b/internal/claudeaccounts/native.go
new file mode 100644
index 0000000..0834bab
--- /dev/null
+++ b/internal/claudeaccounts/native.go
@@ -0,0 +1,122 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+
+	"github.com/tidwall/gjson"
+)
+
+// NativeProjections 是一次 readStable 读到的三处受管投影与其 revision。
+// ClaudeOAuthRaw 是 Claude Code Keychain 项的完整字节镜像（仅审计/恢复用，
+// 不出包边界，design §3.1）。
+type NativeProjections struct {
+	ClaudeOAuth     json.RawMessage
+	ClaudeOAuthRaw  json.RawMessage
+	Locator         *KeychainLocator
+	ClaudeIdentity  *ClaudeIdentityFields
+	PiAnthropic     json.RawMessage
+	Revisions       ExpectedRevisions
+	// PiOtherProviders 报告 auth.json 中除 anthropic 外的其他顶层键名
+	// （仅键名，不含值）：patch 前后必须保持一致（design §1.3-4）。
+	PiOtherProviders []string
+	// ClaudeJSONOtherTopKeys 报告 .claude.json 除受管两个字段外的顶层键名。
+	ClaudeJSONOtherTopKeys []string
+}
+
+// NativeCredentialStore 是三处原生凭据位置的读写边界（design §4）：
+// macOS Keychain `Claude Code-credentials`、`~/.claude.json` 的
+// oauthAccount+userID、`~/.pi/agent/auth.json` 的 anthropic 键。
+// 所有 Patch 内部必须完成写入 + 回读验证后才返回成功。
+type NativeCredentialStore interface {
+	// ReadStable 按 lstat→读→stat→hash→重读读取稳定快照（design §4.3）。
+	ReadStable(ctx context.Context) (*NativeProjections, error)
+	// PatchClaudeKeychainOAuth 更新 Keychain 项中的 OAuth 投影字段，保留
+	// 未知顶层兄弟字段，回读验证后返回新的项 revision。
+	PatchClaudeKeychainOAuth(ctx context.Context, oauth json.RawMessage) (*FileRevision, error)
+	// PatchClaudeIdentity 字段级 patch `.claude.json` 的 oauthAccount 与
+	// userID，其他字段字节片段保留，回读验证后返回新 revision。
+	PatchClaudeIdentity(ctx context.Context, fields ClaudeIdentityFields) (*FileRevision, error)
+	// PatchPiAnthropic 仅替换 auth.json 的 anthropic 键，其他 provider 条目
+	// 原样保留，回读验证后返回新 revision。
+	PatchPiAnthropic(ctx context.Context, anthropic json.RawMessage) (*FileRevision, error)
+	// Kind 返回后端标识。
+	Kind() string
+}
+
+// ClaudeKeychainServiceName 是 Claude Code 凭据项的 Keychain service
+// （任务书给定）。locator 必须先查唯一匹配项并记录 account（design §3.1）。
+const ClaudeKeychainServiceName = "Claude Code-credentials"
+
+// ClaudeKeychainAdapterVersion 标记 Keychain OAuth 投影字段契约的适配器
+// 版本。claudeAiOauth 结构为待验证的适配器契约（design §3.1），真机验证
+// 通过前不得假定字段内部结构，只做整体投影搬运。
+const ClaudeKeychainAdapterVersion = "cc-keychain-claudeAiOauth-v1"
+
+// claudeOAuthProjectionField 是 Claude Code Keychain 项内 OAuth 投影的顶层
+// 字段名（待真机契约验证，design §3.1）。
+const claudeOAuthProjectionField = "claudeAiOauth"
+
+// ExtractClaudeOAuthProjection 从 Keychain 项字节中定位 OAuth 投影。
+// 项不是对象、缺投影字段、或投影不是 JSON 对象 → UNSUPPORTED_CREDENTIAL_SCHEMA
+// （不做跨账号复制，design §3.1）。
+func ExtractClaudeOAuthProjection(item []byte) (json.RawMessage, error) {
+	if !gjson.ValidBytes(item) {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Keychain 项不是合法 JSON")
+	}
+	root := gjson.ParseBytes(item)
+	if !root.IsObject() {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Keychain 项不是 JSON 对象")
+	}
+	field := root.Get(claudeOAuthProjectionField)
+	if !field.Exists() || !field.IsObject() {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Keychain 项缺少可识别的 OAuth 投影字段")
+	}
+	// 入库采用规范形态：池 envelope 往返会 compact 化 RawMessage，统一
+	// 形态避免格式差异被误判为内容变化。
+	return canonicalJSON([]byte(field.Raw)), nil
+}
+
+// PatchClaudeKeychainItemBytes 在保留未知顶层兄弟字段的前提下替换 OAuth
+// 投影字段，返回新的项字节。输入项缺投影字段时拒绝（schema 不可识别）。
+func PatchClaudeKeychainItemBytes(item []byte, oauth json.RawMessage) (json.RawMessage, error) {
+	if _, err := ExtractClaudeOAuthProjection(item); err != nil {
+		return nil, err
+	}
+	if !gjson.ValidBytes(oauth) || !gjson.ParseBytes(oauth).IsObject() {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "OAuth 投影必须是 JSON 对象")
+	}
+	next, err := sjsonSetRawBytes(item, claudeOAuthProjectionField, oauth)
+	if err != nil {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Keychain 项投影替换失败")
+	}
+	return next, nil
+}
+
+// PiAnthropicEntry 是 Pi auth.json anthropic 条目的校验视图（design §3.1：
+// 必须满足 type=oauth、非空 access/refresh、有限数值 expires；单位毫秒）。
+type PiAnthropicEntry struct {
+	Type    string  `json:"type"`
+	Access  string  `json:"access"`
+	Refresh string  `json:"refresh"`
+	Expires float64 `json:"expires"`
+}
+
+// ValidatePiAnthropicEntry 校验 anthropic 条目结构；未知字段保留由 patch
+// 语义保证，这里只验证设计 §3.1 的必要条件。
+func ValidatePiAnthropicEntry(raw []byte) error {
+	var entry PiAnthropicEntry
+	if err := json.Unmarshal(raw, &entry); err != nil {
+		return NewErr(ReasonUnsupportedCredentialSchema, "Pi anthropic 条目不是合法 JSON")
+	}
+	if entry.Type != "oauth" {
+		return NewErr(ReasonUnsupportedCredentialSchema, "Pi anthropic 条目 type 不是 oauth")
+	}
+	if entry.Access == "" || entry.Refresh == "" {
+		return NewErr(ReasonUnsupportedCredentialSchema, "Pi anthropic 条目缺少 access/refresh")
+	}
+	if entry.Expires == 0 || entry.Expires != entry.Expires || entry.Expires > 1e15 {
+		return NewErr(ReasonUnsupportedCredentialSchema, "Pi anthropic 条目 expires 非有限毫秒数值")
+	}
+	return nil
+}
diff --git a/internal/claudeaccounts/nativecc_darwin.go b/internal/claudeaccounts/nativecc_darwin.go
new file mode 100644
index 0000000..563d247
--- /dev/null
+++ b/internal/claudeaccounts/nativecc_darwin.go
@@ -0,0 +1,175 @@
+//go:build darwin && cgo
+
+package claudeaccounts
+
+/*
+Claude Code 原生凭据 Keychain 访问（design §3.1/§4）：
+locator 先按 service 查唯一匹配项并记录 account；零项报缺失（未登录）、
+多项报歧义，禁止更新第一个模糊结果、枚举整库或删除后重建以绕过 ACL
+（design §3.1）。
+*/
+
+/*
+#cgo LDFLAGS: -framework Security -framework CoreFoundation
+#include <Security/Security.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <stdlib.h>
+#include <string.h>
+
+// amagi_cc_locate 按 service 枚举 generic password 项的属性字典数组。
+// 调用方负责 CFRelease(outAttrs)。*outCount 为匹配数（无匹配时为 0 且
+// outAttrs 为 NULL）。
+OSStatus amagi_cc_locate(const char* service, CFArrayRef* outAttrs, CFIndex* outCount) {
+	CFStringRef svc = CFStringCreateWithCString(NULL, service, kCFStringEncodingUTF8);
+	if (svc == NULL) { return errSecAllocate; }
+	CFMutableDictionaryRef query = CFDictionaryCreateMutable(NULL, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+	if (query == NULL) { CFRelease(svc); return errSecAllocate; }
+	CFDictionarySetValue(query, kSecClass, kSecClassGenericPassword);
+	CFDictionarySetValue(query, kSecAttrService, svc);
+	CFDictionarySetValue(query, kSecMatchLimit, kSecMatchLimitAll);
+	CFDictionarySetValue(query, kSecReturnAttributes, kCFBooleanTrue);
+	*outAttrs = NULL;
+	*outCount = 0;
+	OSStatus status = SecItemCopyMatching((CFDictionaryRef)query, (CFTypeRef*)outAttrs);
+	CFRelease(query);
+	CFRelease(svc);
+	if (status == errSecSuccess && *outAttrs != NULL) {
+		*outCount = CFArrayGetCount(*outAttrs);
+	}
+	return status;
+}
+
+void amagi_cc_release(CFTypeRef ref) {
+	if (ref != NULL) { CFRelease(ref); }
+}
+
+// amagi_cc_account_at 把第 idx 个属性字典的 kSecAttrAccount 拷贝到 out
+// （容量 cap 字节）。返回是否取得非空 account。
+Boolean amagi_cc_account_at(CFArrayRef attrs, CFIndex idx, char* out, CFIndex cap) {
+	out[0] = '\0';
+	CFDictionaryRef dict = (CFDictionaryRef)CFArrayGetValueAtIndex(attrs, idx);
+	if (dict == NULL) { return false; }
+	CFStringRef account = (CFStringRef)CFDictionaryGetValue(dict, kSecAttrAccount);
+	if (account == NULL || CFGetTypeID(account) != CFStringGetTypeID()) { return false; }
+	if (!CFStringGetCString(account, out, cap, kCFStringEncodingUTF8)) { return false; }
+	return out[0] != '\0';
+}
+
+// amagi_cc_read 按 service+account 读取项内容（与 internal/secrets 同原语）。
+OSStatus amagi_cc_read(const char* service, const char* account, void** data, UInt32* length) {
+	return SecKeychainFindGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, length, data, NULL);
+}
+
+void amagi_cc_free(void* data) {
+	if (data != NULL) { SecKeychainItemFreeContent(NULL, data); }
+}
+
+// amagi_cc_update 按 service+account 原位更新项内容（保留既有 ACL；
+// design §4.4：使用更新现有 item 的 API，不 delete+add）。
+OSStatus amagi_cc_update(const char* service, const char* account, const void* data, UInt32 length) {
+	SecKeychainItemRef item = NULL;
+	UInt32 existingLength = 0;
+	void* existingData = NULL;
+	OSStatus status = SecKeychainFindGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, &existingLength, &existingData, &item);
+	if (status == errSecSuccess) {
+		if (existingData != NULL) { SecKeychainItemFreeContent(NULL, existingData); }
+		OSStatus updateStatus = SecKeychainItemModifyAttributesAndData(item, NULL, length, data);
+		CFRelease(item);
+		return updateStatus;
+	}
+	if (item != NULL) { CFRelease(item); }
+	if (status == errSecItemNotFound) {
+		return SecKeychainAddGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, length, data, NULL);
+	}
+	return status;
+}
+*/
+import "C"
+
+import (
+	"context"
+	"unsafe"
+)
+
+// DarwinClaudeKeychain 是 Claude Code 凭据项的 macOS Keychain 访问实现。
+type DarwinClaudeKeychain struct{}
+
+// NewClaudeKeychainAccess 返回当前平台的 Claude Code Keychain 访问器。
+func NewClaudeKeychainAccess() ClaudeKeychainAccess {
+	return DarwinClaudeKeychain{}
+}
+
+// LocateItem 查 service 的唯一匹配项：零项报缺失（未登录）、多项报歧义
+// （design §3.1）。
+func (DarwinClaudeKeychain) LocateItem(ctx context.Context) (*KeychainLocator, error) {
+	_ = ctx
+	service := C.CString(ClaudeKeychainServiceName)
+	defer C.free(unsafe.Pointer(service))
+
+	var attrs C.CFArrayRef
+	var count C.CFIndex
+	status := C.amagi_cc_locate(service, &attrs, &count)
+	if status != C.errSecSuccess {
+		return nil, NewErr(ReasonNeedsReconcile, "Claude Code Keychain 查询被拒（osstatus=%d）", int(status))
+	}
+	defer C.amagi_cc_release(C.CFTypeRef(attrs))
+	switch {
+	case count == 0:
+		return nil, NewErr(ReasonNeedsLogin, "Claude Code Keychain 凭据项不存在（未登录或已登出）")
+	case count > 1:
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain service 匹配 %d 项，无法唯一定位", int(count))
+	}
+	var buf [256]C.char
+	if C.amagi_cc_account_at(attrs, 0, &buf[0], C.CFIndex(len(buf))) == 0 {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain 匹配项缺少 account 属性")
+	}
+	account := C.GoString(&buf[0])
+	return &KeychainLocator{Service: ClaudeKeychainServiceName, Account: account}, nil
+}
+
+// ReadItem 读取项完整字节。
+func (DarwinClaudeKeychain) ReadItem(ctx context.Context, loc *KeychainLocator) ([]byte, error) {
+	_ = ctx
+	if loc == nil || loc.Account == "" {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain locator 缺少 account")
+	}
+	service := C.CString(loc.Service)
+	account := C.CString(loc.Account)
+	defer C.free(unsafe.Pointer(service))
+	defer C.free(unsafe.Pointer(account))
+
+	var data unsafe.Pointer
+	var length C.UInt32
+	status := C.amagi_cc_read(service, account, (*unsafe.Pointer)(&data), &length)
+	if status == C.errSecItemNotFound {
+		return nil, NewErr(ReasonNeedsLogin, "Claude Code Keychain 凭据项不存在")
+	}
+	if status != C.errSecSuccess {
+		return nil, NewErr(ReasonNeedsReconcile, "Claude Code Keychain 读取被拒（osstatus=%d）", int(status))
+	}
+	defer C.amagi_cc_free(data)
+	if length == 0 {
+		return nil, NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain 项内容为空")
+	}
+	return C.GoBytes(data, C.int(length)), nil
+}
+
+// UpdateItem 原位更新项内容（保留 ACL）。
+func (DarwinClaudeKeychain) UpdateItem(ctx context.Context, loc *KeychainLocator, item []byte) error {
+	_ = ctx
+	if loc == nil || loc.Account == "" {
+		return NewErr(ReasonUnsupportedCredentialSchema, "Claude Code Keychain locator 缺少 account")
+	}
+	service := C.CString(loc.Service)
+	account := C.CString(loc.Account)
+	defer C.free(unsafe.Pointer(service))
+	defer C.free(unsafe.Pointer(account))
+
+	cPayload := C.CBytes(item)
+	defer C.free(cPayload)
+	status := C.amagi_cc_update(service, account, cPayload, C.UInt32(len(item)))
+	if status != C.errSecSuccess {
+		return NewErr(ReasonNeedsReconcile, "Claude Code Keychain 更新被拒（osstatus=%d）", int(status))
+	}
+	return nil
+}
