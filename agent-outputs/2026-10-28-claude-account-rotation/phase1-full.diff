+func TestAtomicWriteFailureSteps(t *testing.T) {
+	cases := []struct {
+		step    string
+		renamed bool
+	}{
+		{"create-temp", false},
+		{"sync-temp", false},
+		{"close-temp", false},
+		{"rename", false},
+		{"sync-directory", true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.step, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, "auth.json")
+			if err := os.WriteFile(path, []byte(`{"before":1}`), 0o644); err != nil {
+				t.Fatal(err)
+			}
+			result, err := writeAtomicFile(path, []byte(`{"after":2}`), newFailOps(tc.step, 1))
+			if err == nil {
+				t.Fatal("期望注入失败")
+			}
+			if result.Renamed != tc.renamed {
+				t.Fatalf("Renamed 期望 %v，实际 %v（step=%s）", tc.renamed, result.Renamed, result.Step)
+			}
+			if result.Step != tc.step {
+				t.Fatalf("Step 期望 %s，实际 %s", tc.step, result.Step)
+			}
+			if tc.renamed {
+				// rename 已完成：内容已替换（恢复不得假定失败表示未改文件）。
+				if got := string(readJSON(t, path)); got != `{"after":2}` {
+					t.Fatalf("rename 后内容应已替换，实际 %s", got)
+				}
+			} else {
+				if got := string(readJSON(t, path)); got != `{"before":1}` {
+					t.Fatalf("rename 前失败不应改变内容，实际 %s", got)
+				}
+			}
+			// 失败后无临时文件残留。
+			entries, _ := os.ReadDir(dir)
+			for _, e := range entries {
+				if strings.HasPrefix(e.Name(), ".auth.json.claudeaccounts-") {
+					t.Fatalf("临时文件残留：%s", e.Name())
+				}
+			}
+		})
+	}
+}
+
+// TestAtomicWriteFileModes：临时文件 0600、目标保持原 mode、不对已存在
+// 目录 chmod（design §4.4：勿对 HOME chmod）。
+func TestAtomicWriteFileModes(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(dir, "auth.json")
+	if err := os.WriteFile(path, []byte(`{}`), 0o640); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := writeAtomicFile(path, []byte(`{"v":1}`), osWriteFileOps{}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0o640 {
+		t.Fatalf("目标文件 mode 应保持 0640，实际 %v", info.Mode().Perm())
+	}
+	dirInfo, err := os.Stat(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if dirInfo.Mode().Perm() != 0o755 {
+		t.Fatalf("已存在目录不应被 chmod，实际 %v", dirInfo.Mode().Perm())
+	}
+	// 无临时文件残留。
+	entries, _ := os.ReadDir(dir)
+	if len(entries) != 1 {
+		t.Fatalf("目录应只含目标文件，实际 %d 项", len(entries))
+	}
+}
+
+// TestPatchKeychainItemPreservesSiblings：Keychain 项未知顶层兄弟字段保留
+// （design §3.1：不跨账号复制未知字段；缺投影字段拒绝）。
+func TestPatchKeychainItemPreservesSiblings(t *testing.T) {
+	item := syntheticKeychainItem("cc-a-1")
+	next, err := PatchClaudeKeychainItemBytes(item, []byte(`{"accessToken":"cc-b-1"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := gjson.GetBytes(next, "claudeAiOauth.accessToken").String(); got != "cc-b-1" {
+		t.Fatalf("投影应已替换，实际 %s", got)
+	}
+	if !gjson.GetBytes(next, "otherSibling").Exists() {
+		t.Fatal("未知兄弟字段丢失")
+	}
+	// 缺投影字段 → UNSUPPORTED_CREDENTIAL_SCHEMA。
+	_, err = PatchClaudeKeychainItemBytes([]byte(`{"unrelated":true}`), []byte(`{}`))
+	assertReason(t, err, ReasonUnsupportedCredentialSchema)
+}
diff --git a/internal/claudeaccounts/poolstore.go b/internal/claudeaccounts/poolstore.go
new file mode 100644
index 0000000..f3f0607
--- /dev/null
+++ b/internal/claudeaccounts/poolstore.go
@@ -0,0 +1,101 @@
+package claudeaccounts
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+)
+
+// PoolStore 是账号池 envelope 的持久化边界（design §3.1/§3.3）。
+// 生产实现是 macOS Keychain 专用 service；测试注入 fake，绝不实例化真实
+// Keychain backend。
+type PoolStore interface {
+	// Load 读取池 envelope。从未创建返回 (nil, nil)——「正常未启用」；
+	// 被删除/损坏必须以稳定 reason 报错，不得返回空池让上层覆盖原生认证。
+	Load(ctx context.Context) (*AccountPool, error)
+	// Save 原子写入池 envelope，并在写入后立即回读验证 revision 与关键
+	// 字段（design §3.3：池写入结果必须回读验证 revision）。回读不一致
+	// 视为保存失败。
+	Save(ctx context.Context, pool *AccountPool) error
+	// Kind 返回后端标识（"keychain" / "memory" 等，仅用于日志与测试）。
+	Kind() string
+}
+
+// encodePoolEnvelope 序列化池 envelope（存 Keychain 的唯一 JSON）。
+func encodePoolEnvelope(pool *AccountPool) ([]byte, error) {
+	if pool == nil {
+		return nil, fmt.Errorf("encode pool envelope: nil pool")
+	}
+	data, err := json.Marshal(pool)
+	if err != nil {
+		return nil, fmt.Errorf("encode pool envelope: %w", err)
+	}
+	return data, nil
+}
+
+// DecodePoolEnvelope 解析并校验池 envelope。校验失败返回 *Error：
+// schemaVersion 未知 → POOL_CORRUPT；JSON 损坏 → POOL_CORRUPT。
+func DecodePoolEnvelope(data []byte) (*AccountPool, error) {
+	var pool AccountPool
+	if err := json.Unmarshal(data, &pool); err != nil {
+		return nil, NewErr(ReasonPoolCorrupt, "池 envelope JSON 不可解析")
+	}
+	if pool.SchemaVersion == 0 && len(pool.Accounts) == 0 && pool.Revision == 0 {
+		// 空对象视为损坏：真实空池也有 schemaVersion=1。
+		return nil, NewErr(ReasonPoolCorrupt, "池 envelope 缺少 schemaVersion")
+	}
+	if pool.SchemaVersion != PoolSchemaVersion {
+		return nil, NewErr(ReasonPoolCorrupt, "池 schema 版本未知（期望 %d，实际 %d）", PoolSchemaVersion, pool.SchemaVersion)
+	}
+	if pool.Accounts == nil {
+		pool.Accounts = map[string]*AccountSnapshot{}
+	}
+	if pool.ActiveAccountID != "" && pool.Accounts[pool.ActiveAccountID] == nil {
+		return nil, NewErr(ReasonPoolCorrupt, "活动账号指向不存在的账号")
+	}
+	if txn := pool.Transaction; txn != nil {
+		switch txn.Kind {
+		case TransactionSwap:
+			if txn.Swap == nil {
+				return nil, NewErr(ReasonPoolCorrupt, "swap 事务缺少 journal")
+			}
+		case TransactionEnrollment:
+			if txn.Enrollment == nil {
+				return nil, NewErr(ReasonPoolCorrupt, "enrollment 事务缺少 journal")
+			}
+		default:
+			return nil, NewErr(ReasonPoolCorrupt, "未知事务类型 %q", string(txn.Kind))
+		}
+	}
+	return &pool, nil
+}
+
+// verifySavedPool 是 Save 后的回读验证：解析并比对 revision 与关键身份字段
+// （design §3.3：写入结果必须回读验证 revision）。
+func verifySavedPool(reloaded *AccountPool, expected *AccountPool) error {
+	if reloaded == nil {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读为空")
+	}
+	if reloaded.Revision != expected.Revision {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读 revision 不一致（期望 %d，实际 %d）", expected.Revision, reloaded.Revision)
+	}
+	if reloaded.ActiveAccountID != expected.ActiveAccountID {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读活动账号不一致")
+	}
+	if reloaded.ActiveGeneration != expected.ActiveGeneration {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读代际不一致")
+	}
+	if len(reloaded.Accounts) != len(expected.Accounts) {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读账号数量不一致")
+	}
+	for id, want := range expected.Accounts {
+		got, ok := reloaded.Accounts[id]
+		if !ok || got == nil {
+			return NewErr(ReasonPoolCorrupt, "池保存后回读缺少账号 %s", id)
+		}
+		if got.Alias != want.Alias || !got.UpdatedAt.Equal(want.UpdatedAt) {
+			return NewErr(ReasonPoolCorrupt, "池保存后回读账号 %s 元数据不一致", id)
+		}
+	}
+	return nil
+}
diff --git a/internal/claudeaccounts/poolstore_keychain_darwin.go b/internal/claudeaccounts/poolstore_keychain_darwin.go
new file mode 100644
index 0000000..4a34aaa
--- /dev/null
+++ b/internal/claudeaccounts/poolstore_keychain_darwin.go
@@ -0,0 +1,140 @@
+//go:build darwin && cgo
+
+package claudeaccounts
+
+/*
+复用 internal/secrets 的 Security.framework 原语模式（store_darwin_cgo.go），
+但使用独立的 Keychain service：amagi-codebox.claude-accounts / desktop-app，
+与 provider 密钥表完全隔离（design §2「池存储」决策）。
+
+Claude Code 原生凭据项的定位（locator 唯一匹配查询）在 nativecc_darwin.go。
+*/
+
+/*
+#cgo LDFLAGS: -framework Security -framework CoreFoundation
+#include <Security/Security.h>
+#include <CoreFoundation/CoreFoundation.h>
+#include <stdlib.h>
+#include <string.h>
+
+// amagi_ca_find_pool 按 service+account 精确查找账号池 envelope 项。
+OSStatus amagi_ca_find_pool(const char* service, const char* account, void** data, UInt32* length) {
+	return SecKeychainFindGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, length, data, NULL);
+}
+
+void amagi_ca_free(void* data) {
+	if (data != NULL) {
+		SecKeychainItemFreeContent(NULL, data);
+	}
+}
+
+// amagi_ca_set_pool 写入（存在则原位更新，保留既有 ACL；不存在则新增）。
+// design §4.4：Keychain 使用更新现有 item 的 API，不 delete+add 绕过 ACL。
+OSStatus amagi_ca_set_pool(const char* service, const char* account, const void* data, UInt32 length) {
+	SecKeychainItemRef item = NULL;
+	UInt32 existingLength = 0;
+	void* existingData = NULL;
+	OSStatus status = SecKeychainFindGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, &existingLength, &existingData, &item);
+	if (status == errSecSuccess) {
+		if (existingData != NULL) {
+			SecKeychainItemFreeContent(NULL, existingData);
+		}
+		OSStatus updateStatus = SecKeychainItemModifyAttributesAndData(item, NULL, length, data);
+		CFRelease(item);
+		return updateStatus;
+	}
+	if (item != NULL) {
+		CFRelease(item);
+	}
+	if (status == errSecItemNotFound) {
+		return SecKeychainAddGenericPassword(NULL, (UInt32)strlen(service), service, (UInt32)strlen(account), account, length, data, NULL);
+	}
+	return status;
+}
+*/
+import "C"
+
+import (
+	"context"
+	"unsafe"
+)
+
+// 账号池专用 Keychain service（design §2：新 service amagi-codebox.claude-accounts）。
+const (
+	poolKeychainService = "amagi-codebox.claude-accounts"
+	poolKeychainAccount = "desktop-app"
+)
+
+// KeychainPoolStore 是 macOS Keychain 上的池 envelope 后端。
+type KeychainPoolStore struct{}
+
+// NewKeychainPoolStore 返回真实 Keychain 后端。仅供生产接线使用；
+// 测试一律注入 fake store，不得调用本构造器。
+func NewKeychainPoolStore() PoolStore {
+	return KeychainPoolStore{}
+}
+
+// Kind 标识后端。
+func (KeychainPoolStore) Kind() string { return "keychain" }
+
+// Load 读取池 envelope；从未创建返回 (nil, nil)。
+func (KeychainPoolStore) Load(ctx context.Context) (*AccountPool, error) {
+	_ = ctx
+	service := C.CString(poolKeychainService)
+	account := C.CString(poolKeychainAccount)
+	defer C.free(unsafe.Pointer(service))
+	defer C.free(unsafe.Pointer(account))
+
+	var data unsafe.Pointer
+	var length C.UInt32
+	status := C.amagi_ca_find_pool(service, account, (*unsafe.Pointer)(&data), &length)
+	if status == C.errSecItemNotFound {
+		return nil, nil // 从未创建过池：正常未启用（design §3.3）
+	}
+	if status != C.errSecSuccess {
+		// errSecAuthFailed / errSecInteractionNotAllowed 等访问被拒：
+		// 不自动生成空池覆盖原生认证，交由上层停用并告警。
+		return nil, NewErr(ReasonPoolLocked, "账号池 Keychain 读取被拒（osstatus=%d）", int(status))
+	}
+	defer C.amagi_ca_free(data)
+
+	payload := C.GoBytes(data, C.int(length))
+	if len(payload) == 0 {
+		return nil, NewErr(ReasonPoolCorrupt, "账号池 Keychain 项为空")
+	}
+	pool, err := DecodePoolEnvelope(payload)
+	if err != nil {
+		return nil, err
+	}
+	return pool, nil
+}
+
+// Save 写入池 envelope 并立即回读验证 revision（design §3.3）。
+func (KeychainPoolStore) Save(ctx context.Context, pool *AccountPool) error {
+	_ = ctx
+	if pool == nil {
+		return NewErr(ReasonPoolCorrupt, "拒绝写入 nil 池")
+	}
+	payload, err := encodePoolEnvelope(pool)
+	if err != nil {
+		return NewErr(ReasonPoolCorrupt, "池 envelope 序列化失败")
+	}
+	service := C.CString(poolKeychainService)
+	account := C.CString(poolKeychainAccount)
+	defer C.free(unsafe.Pointer(service))
+	defer C.free(unsafe.Pointer(account))
+
+	cPayload := C.CBytes(payload)
+	defer C.free(cPayload)
+	status := C.amagi_ca_set_pool(service, account, cPayload, C.UInt32(len(payload)))
+	if status != C.errSecSuccess {
+		return NewErr(ReasonPoolLocked, "账号池 Keychain 写入被拒（osstatus=%d）", int(status))
+	}
+
+	// 回读验证 revision：保存成功必须可被再次读到同一版本。
+	reloaded, err := KeychainPoolStore{}.Load(ctx)
+	if err != nil {
+		return NewErr(ReasonPoolCorrupt, "池保存后回读失败")
+	}
+	return verifySavedPool(reloaded, pool)
+}
diff --git a/internal/claudeaccounts/poolstore_test.go b/internal/claudeaccounts/poolstore_test.go
new file mode 100644
index 0000000..90961ee
--- /dev/null
+++ b/internal/claudeaccounts/poolstore_test.go
@@ -0,0 +1,222 @@
+package claudeaccounts
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+// PoolStore/NativeStore 组（design §10.1 矩阵第 1 行）。
+
+// TestPoolStoreRoundTrip：fake store 保存并回读完整双 grant 与身份。
+func TestPoolStoreRoundTrip(t *testing.T) {
+	store := &fakePoolStore{}
+	now := time.Now()
+	pool := NewAccountPool()
+	snap := &AccountSnapshot{
+		ID:        "id-a",
+		Alias:     "A",
+		CreatedAt: now,
+		UpdatedAt: now,
+		Identity:  AccountIdentity{AccountUUID: syntheticUUIDA, OrganizationUUID: syntheticOrgA, Email: "a@example.com"},
+		Claude: ClaudeGrantState{
+			OauthProjection:     syntheticKeychainItem("cc-a-1"),
+			RawCredentialItem:   syntheticKeychainItem("cc-a-1"),
+			StoreLocator:        &KeychainLocator{Service: ClaudeKeychainServiceName, Account: "claude"},
+			AdapterVersion:      ClaudeKeychainAdapterVersion,
+			ObservedAt:          now,
+			RevisionFingerprint: &FileRevision{SHA256Hex: "abc"},
+		},
+		ClaudeIdentity: ClaudeIdentityFields{OauthAccount: []byte(`{"accountUuid":"x"}`), UserID: "u1"},
+		Pi: PiGrantState{
+			Anthropic:      syntheticPiAuth("pi-a-1", futureExpiresMS(now)),
+			AdapterVersion: PiRefreshAdapterVersion,
+			ObservedAt:     now,
+		},
+		IdentityEvidence: &IdentityEvidence{CCAccountUUID: syntheticUUIDA, PiAccountUUID: syntheticUUIDA, CheckedAt: now},
+		Health:           AccountHealth{ClaudeGrant: HealthReady, PiGrant: HealthReady, IdentityStatus: "verified"},
+	}
+	pool.Accounts[snap.ID] = snap
+	pool.ActiveAccountID = snap.ID
+	pool.ActiveGeneration = 7
+	pool.Revision = 3
+	if err := store.Save(context.Background(), pool); err != nil {
+		t.Fatalf("save: %v", err)
+	}
+	reloaded, err := store.Load(context.Background())
+	if err != nil {
+		t.Fatalf("load: %v", err)
+	}
+	if reloaded.Revision != 3 || reloaded.ActiveAccountID != "id-a" || reloaded.ActiveGeneration != 7 {
+		t.Fatalf("回读元数据不符: %+v", reloaded)
+	}
+	got := reloaded.Account("id-a")
+	if got == nil {
+		t.Fatal("回读缺少账号")
+	}
+	if !equalJSON(got.Claude.OauthProjection, snap.Claude.OauthProjection) {
+		t.Fatal("CC OAuth 投影回读不符")
+	}
+	if !equalJSON(got.Pi.Anthropic, snap.Pi.Anthropic) {
+		t.Fatal("Pi anthropic 回读不符")
+	}
+	if got.IdentityEvidence == nil || got.IdentityEvidence.CCAccountUUID != syntheticUUIDA {
+		t.Fatal("身份证据回读不符")
+	}
+	if got.Claude.StoreLocator == nil || got.Claude.StoreLocator.Account != "claude" {
+		t.Fatal("storeLocator 回读不符")
+	}
+}
+
+// TestDecodePoolEnvelopeCorrupt：坏 JSON / schema 版本 / 活动账号悬空。
+func TestDecodePoolEnvelopeCorrupt(t *testing.T) {
+	cases := []struct {
+		name string
+		data string
+	}{
+		{"坏 JSON", "{not json"},
+		{"空对象", "{}"},
+		{"未知 schema", `{"schemaVersion":99,"accounts":{}}`},
+		{"活动账号悬空", `{"schemaVersion":1,"revision":1,"activeAccountId":"ghost","accounts":{}}`},
+		{"未知事务类型", `{"schemaVersion":1,"revision":1,"accounts":{},"transaction":{"kind":"weird"}}`},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := DecodePoolEnvelope([]byte(tc.data))
+			assertReason(t, err, ReasonPoolCorrupt)
+		})
+	}
+}
+
+// TestPoolStoreSaveFailure：注入保存失败（保存后读失败语义）。
+func TestPoolStoreSaveFailure(t *testing.T) {
+	store := &fakePoolStore{saveErrAt: 1}
+	pool := NewAccountPool()
+	err := store.Save(context.Background(), pool)
+	if err == nil {
+		t.Fatal("期望注入的保存失败")
+	}
+}
+
+// TestKeychainLocatorAmbiguity：零项报缺失、多项报歧义（design §3.1）。
+func TestKeychainLocatorAmbiguity(t *testing.T) {
+	kc := &fakeKeychain{}
+	_, err := kc.LocateItem(context.Background())
+	assertReason(t, err, ReasonNeedsLogin)
+
+	kc.items = []fakeKCItem{
+		{account: "one", data: syntheticKeychainItem("t1")},
+		{account: "two", data: syntheticKeychainItem("t2")},
+	}
+	_, err = kc.LocateItem(context.Background())
+	assertReason(t, err, ReasonUnsupportedCredentialSchema)
+}
+
+// TestKeychainStoreDenied：读取被拒分类（design §3.3 locked/denied 分开）。
+func TestKeychainStoreDenied(t *testing.T) {
+	kc := &fakeKeychain{items: []fakeKCItem{{account: "claude", data: syntheticKeychainItem("t1")}}}
+	kc.readErr = NewErr(ReasonNeedsReconcile, "注入：Keychain 访问被拒")
+	_, err := kc.ReadItem(context.Background(), &KeychainLocator{Service: ClaudeKeychainServiceName, Account: "claude"})
+	assertReason(t, err, ReasonNeedsReconcile)
+}
+
+// TestCrossProcessLockMutualExclusion：跨进程锁互斥（flock 语义）。
+func TestCrossProcessLockMutualExclusion(t *testing.T) {
+	lockPath := filepath.Join(t.TempDir(), "sub", "claude-accounts.lock")
+	first, err := acquireFileLock(lockPath)
+	if err != nil {
+		t.Fatalf("first acquire: %v", err)
+	}
+	_, err = acquireFileLock(lockPath)
+	assertReason(t, err, ReasonPoolLocked)
+	first.release()
+	second, err := acquireFileLock(lockPath)
+	if err != nil {
+		t.Fatalf("re-acquire after release: %v", err)
+	}
+	second.release()
+}
+
+// TestCrossProcessLockConcurrentSingleWinner：并发竞争只有一个赢家。
+func TestCrossProcessLockConcurrentSingleWinner(t *testing.T) {
+	lockPath := filepath.Join(t.TempDir(), "claude-accounts.lock")
+	var wg sync.WaitGroup
+	winners := make(chan int, 8)
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func(idx int) {
+			defer wg.Done()
+			lock, err := acquireFileLock(lockPath)
+			if err != nil {
+				return
+			}
+			winners <- idx
+			time.Sleep(5 * time.Millisecond)
+			lock.release()
+		}(i)
+	}
+	wg.Wait()
+	close(winners)
+	total := 0
+	for range winners {
+		total++
+	}
+	if total < 1 {
+		t.Fatal("至少应有一个持锁者成功")
+	}
+}
+
+// TestProperLockBusyAndRelease：Pi 兼容锁的占用与释放。
+func TestProperLockBusyAndRelease(t *testing.T) {
+	target := filepath.Join(t.TempDir(), "auth.json")
+	now := time.Now()
+	lock, err := AcquireProperLock(target, now)
+	if err != nil {
+		t.Fatalf("acquire: %v", err)
+	}
+	// 已持有时再次获取 → busy（不自动清理未知/过期原生锁）。
+	_, err = AcquireProperLock(target, now.Add(time.Second))
+	assertReason(t, err, ReasonNativeLockBusy)
+	if err := lock.Release(); err != nil {
+		t.Fatalf("release: %v", err)
+	}
+	// 释放后可重新获取。
+	again, err := AcquireProperLock(target, now.Add(2*time.Second))
+	if err != nil {
+		t.Fatalf("re-acquire: %v", err)
+	}
+	if err := again.Release(); err != nil {
+		t.Fatalf("re-release: %v", err)
+	}
+	// 锁被外部接管（mtime 内容变化）时不删除。
+	third, err := AcquireProperLock(target, now.Add(3*time.Second))
+	if err != nil {
+		t.Fatalf("third acquire: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(target+".lock", "mtime"), []byte("999"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := third.Release(); err == nil {
+		t.Fatal("被接管的锁不应被删除")
+	}
+}
+
+// TestPoolLockFileHasNoSecrets：锁文件不含秘密（design §3.3）。
+func TestPoolLockFileHasNoSecrets(t *testing.T) {
+	lockPath := filepath.Join(t.TempDir(), "claude-accounts.lock")
+	lock, err := acquireFileLock(lockPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer lock.release()
+	data, err := os.ReadFile(lockPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(data) != 0 {
+		t.Fatalf("锁文件应为空，实际 %d 字节", len(data))
+	}
+}
