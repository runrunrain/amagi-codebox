+// TestPiRefreshUncertainClasses：响应丢失/非 200/坏响应 → REFRESH_UNCERTAIN
+// （design §5.1：请求可能已被处理并轮换 refresh token）。
+func TestPiRefreshUncertainClasses(t *testing.T) {
