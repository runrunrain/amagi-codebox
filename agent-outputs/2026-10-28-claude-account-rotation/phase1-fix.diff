+// 状态启动）计入 external → EXTERNAL_SESSION_UNCERTAIN。
+func TestF02_QuiescenceAttributesOnlyCredentialLeaseHolders(t *testing.T) {
+	app, _, _, _ := newFacadeTestApp(t)
+
+	// 一个「已运行」的 CodeBox claude 会话（absent 时启动，无凭据 lease）。
