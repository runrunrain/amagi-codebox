+func TestF01_AbsenceCheckAndRecheckCoverBlocked(t *testing.T) {
+	app, _, _, _ := newFacadeTestApp(t)
+
+	// absent → absence check 通过；managed → 拒绝（absent 旧计划不得执行）。
+	setClaudeAccountsCache(app, nil, nil, true)
