+	pool2, _ := env.svc.LoadPool(context.Background())
+	if pool2.ActiveGeneration != pool.ActiveGeneration {
+		t.Fatalf("代际不应变化：%d → %d", pool.ActiveGeneration, pool2.ActiveGeneration)
+	}
+}
