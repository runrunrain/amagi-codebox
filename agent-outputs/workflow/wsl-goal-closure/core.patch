+// runWSLSharedFilesAtLaunch 是 SA-09（wsl-goal-closure）的共享小文件启动
+// 补漏/撤回闸门：会话启动前对已注册的 shared 作用域小文件（视觉清单导出
+// shared/vision-export、多模态学习层 shared/modality-kb）执行一次供给运行，
+// 覆盖「停机期间 Windows 侧关闭导出/删除 provider → 保存推送被停机守卫跳过
+// → 旧密钥副本无限留盘继续被会话内工具消费」的缺口。
+//
+// 边界（冻结接口，C1 接线五 CLI desktop/remote/restart）：
+//   - 只处理上述两个 shared 单元：不扫描 skills、不安装插件、不联网；
+//   - 普通启动不因「从未授权」阻断：无授权且状态面确认无受管副本的
+//     awaiting-consent/unmanaged 等预期态返回 nil；
+//   - 受管敏感副本（视觉清单）可能存在时，任何不能确认其安全/撤回完成的
+//     结果——RunUnits 错误、UnitFailed（含 withdrawal-remove-failed、staging
+//     unverified、写失败）、withdrawal-unconfirmed-frozen——返回明确 error
+//     阻断会话（未知不能推断旧副本安全）；
+//   - modality-kb 是布尔结论非敏感面：失败不阻断（状态页可见）；
+//   - ctx 已取消 → 返回 ctx.Err()（取消传播给启动链）。
+//
+// 调用时机：已解析 distro、PTY 启动之前。内部 Go API，不进 Wails 绑定。
+func runWSLSharedFilesAtLaunch(ctx context.Context, runner wslsupply.Runner, distro string) error {
+	if runner == nil || strings.TrimSpace(distro) == "" {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	units := wslSupplyUnitsFiltered(runner, wslsupply.UnitSharedVisionExport, wslsupply.UnitSharedModalityKB)
+	if len(units) == 0 {
+		return nil // 裸运行器无 shared 适配器：不阻断普通启动
+	}
+	res, runErr := runner.RunUnits(ctx, distro, wslsupply.CLICommon, wslsupply.ReasonLaunch, units)
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if runErr != nil {
+		// 供给运行不可用：仅当状态面能证明本目标从未持有受管敏感副本时放行。
+		if !visionManagedCopyPossible(runner, distro) {
+			return nil
+		}
+		return fmt.Errorf("WSL 共享视觉清单供给运行失败（%v）；无法确认 WSL 内受管密钥副本的安全状态，本次启动不消费该副本", runErr)
+	}
+	for i := range res.Results {
+		r := res.Results[i]
+		if r.Unit != wslsupply.UnitSharedVisionExport {
+			continue // 学习层非敏感：失败/阻断不阻断启动
+		}
+		switch r.Outcome {
+		case wslsupply.UnitApplied, wslsupply.UnitFresh, wslsupply.UnitWarnDegraded:
+			continue // 已落地 / 已确认无需动作
+		case wslsupply.UnitBlocked:
+			if strings.Contains(r.Detail, "withdrawal-unconfirmed") {
+				return fmt.Errorf("WSL 内视觉清单密钥副本未确认撤回（%s 目标被手动修改而宿主已撤回导出）；本次启动不消费该副本，请在 WSL 内处理 ~/.agents/amagi-media-models.json 后重试", distro)
+			}
+			// awaiting-consent / unmanaged-existing / frozen（非撤回类）：
+			// 从未授权或副本不归本目标受管——不阻断普通启动。
+			continue
+		default: // UnitFailed：写失败 / withdrawal-remove-failed / staging unverified 等
+			if !visionManagedCopyPossible(runner, distro) {
+				return nil
+			}
+			return fmt.Errorf("WSL 内视觉清单密钥副本状态未确认（unit=%s detail=%s）；本次启动不消费该副本，请检查 WSL 内 ~/.agents/amagi-media-models.json 或重试", r.Unit, r.Detail)
+		}
+	}
+	return nil
+}
+
+// visionManagedCopyPossible 报告本目标是否可能仍持有 CodeBox 受管的视觉
+// 清单密钥副本（曾授权且未确认撤回）。状态面无该单元登记（从未授权/从未
+// 发布）或已撤回（withdrawn*）时为 false——此时普通启动可安全继续。
+func visionManagedCopyPossible(runner wslsupply.Runner, distro string) bool {
+	st := runner.GetStatus(distro, wslsupply.CLICommon)
+	for _, u := range st.Units {
+		if u.Unit != wslsupply.UnitSharedVisionExport {
+			continue
+		}
+		if strings.HasPrefix(u.LastOutcome, "withdrawn") {
+			return false
+		}
+		return u.Consented
+	}
+	return false
+}
