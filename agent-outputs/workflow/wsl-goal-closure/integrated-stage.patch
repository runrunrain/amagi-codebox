+// stringSlicesEqual 报告两个过滤字段语义相等（三态严格：nil 与空切片不等
+// ——nil = 键省略全部加载，空切片 = 显式空数组一项都不加载；元素级相等）。
+func stringSlicesEqual(a, b []string) bool {
+	if (a == nil) != (b == nil) {
+		return false
+	}
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
