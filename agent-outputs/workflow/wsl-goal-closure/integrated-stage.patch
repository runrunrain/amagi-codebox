+	wsl := res.Results[1]
+	if wsl.Target != "wsl" || wsl.Outcome != "skipped" || wsl.ErrCode != "windows-anchor-missing" {
+		t.Fatalf("wsl must be skipped when anchor unreadable: %+v", wsl)
+	}
