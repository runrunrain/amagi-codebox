+	if registered == "" {
+		return out
+	}
+	for _, cfg := range configured {
+		if cfg.source == registered {
+			return EntryFilters{
+				Extensions: cfg.extensions, Skills: cfg.skills,
+				Prompts: cfg.prompts, Themes: cfg.themes,
+			}
+		}
+	}
+	return out
