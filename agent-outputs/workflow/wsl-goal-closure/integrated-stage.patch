+// 有过滤项 → 过滤对象；无过滤项 → 纯字符串源（全部加载，含从旧过滤对象归一
+// 回全量形态）。已是规范形态则零写入（幂等）。经 sjson 定点替换，packages
+// 之外的其余内容字节不动；同目录 tmp+rename 原子落盘。
+func (p *PluginScope) applyDistroFilters(target TargetRef, identity, source string, filters PluginFilters) error {
+	path := filepath.Join(target.UNCRoot, "settings.json")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return fmt.Errorf("settings.json 读取失败: %w", err)
+	}
+	items := gjson.GetBytes(data, "packages").Array()
+	idx := -1
+	for i, e := range items {
+		var src string
+		if e.Type == gjson.String {
+			src = strings.TrimSpace(e.String())
+		} else if e.IsObject() {
+			src = strings.TrimSpace(e.Get("source").String())
+		}
+		if src == "" {
