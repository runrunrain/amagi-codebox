--- /dev/null
+++ b/frontend/src/views/settings/wslSupplyMessages.ts
@@ -0,0 +1,46 @@
+/**
+ * WSL 供给 UI 决策逻辑（SA-03/SA-17 修复配套）：
+ * 从 WSLCLISettings.vue 抽出的纯逻辑——node 环境单测直接覆盖驱动模板/交互的
+ * 分支（仓库测试基建无 DOM，与 quotaModel.ts 同模式）。
+ *
+ * cliImportOutcomeMessage 决定「导入所选」点击后的诚实提示：
+ * - 零写入不报成功（修复前 UI 把 fresh 也计入成功，零导入虚报「已导入所选」）；
+ * - 空选择是显式撤回入口（托管条目按来源删除语义移除）。
+ */
+
+export type SupplyOutcomeLike = { outcome: string; detail?: string }
+
+export type ImportMessage = { kind: 'success' | 'info'; text: string }
+
+/**
+ * 根据「用户勾选数」与「后端逐单元结果」产生提示。
+ *
+ * 结果语义（wslsupply UnitOutcome）：
+ * - applied：已写入/移除（含撤回移除）；
+ * - fresh：无变化（未写入任何内容）；
+ * - blocked/failed：保持现状/失败。
+ */
+export function cliImportOutcomeMessage(selectedCount: number, outcomes: SupplyOutcomeLike[]): ImportMessage {
+  if (outcomes.length === 0) {
+    return { kind: 'info', text: '导入未返回结果（详见预览）' }
+  }
+  const applied = outcomes.filter((o) => o.outcome === 'applied')
+  const failed = outcomes.filter((o) => o.outcome === 'failed' || o.outcome === 'blocked')
+  if (selectedCount === 0) {
+    // 空选择 = 显式撤回：applied 表示托管条目已按来源删除语义移除。
+    if (applied.length > 0) {
+      return { kind: 'success', text: `已按空选择撤回导入（移除 ${applied.length} 个托管条目）` }
+    }
+    return { kind: 'info', text: '已提交空选择：无托管条目需要移除（目标内容未变化）' }
+  }
+  if (applied.length === 0) {
+    return { kind: 'info', text: '未写入任何条目：所选键无变化或不可导入（详见预览，不视为导入成功）' }
+  }
+  if (failed.length > 0) {
+    return {
+      kind: 'info',
+      text: `导入完成：${applied.length} 项写入，${failed.length} 项保持现状（冻结/未托管/不可转换，详见预览）`,
+    }
+  }
+  return { kind: 'success', text: `已写入 ${applied.length} 项（冻结/未托管/不可转换条目保持 WSL 现状）` }
+}
diff --git a/headroom_wsl_gate.go b/headroom_wsl_gate.go
new file mode 100644
index 0000000..1fe03be
--- /dev/null
+++ b/headroom_wsl_gate.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"errors"
+
+	"amagi-codebox/internal/platform"
+)
+
+// --- Headroom × WSL 网络准入（D1/D6 共用窄判定） ---
+//
+// Headroom 压缩入口（claude 会话级 8787 / codex 全局 8788）监听宿主回环
+// (127.0.0.1)。WSL2 默认 NAT 模式下 distro 内的 127.0.0.1 指向发行版自身，
+// 宿主回环不可达；mirrored（%USERPROFILE%\.wslconfig 的 [wsl2] 段
+// networkingMode=mirrored）下 localhost 双向互通。判定与
+// aiproxy.PinProxyEnvironment 同源：只读 .wslconfig，不 fork wsl.exe；
+// 空/未知按 NAT 对待（fail-safe）；mirrored 仅准入，不构成连通性声明。
+
+// headroomWSLNetworkAdmission 对「将落在 WSL distro 内的 Headroom 会话」执行
+// NAT/未知网络模式的准入判定：非 WSL 目标直接放行；mirrored 放行（遵循现有
+// 准入策略，不宣称连通）；NAT/未知返回带修复指引的中文拒绝。调用方必须在
+// Headroom.Start、admission 获取、会话预留与 PTY 启动等副作用之前调用。
+func headroomWSLNetworkAdmission(targetsWSL bool, env []string) error {
+	if !targetsWSL {
+		return nil
+	}
+	if platform.WSLNetworkingMode(env) == "mirrored" {
+		return nil
+	}
+	return errors.New(`Headroom 压缩入口监听宿主回环（127.0.0.1:8787），当前 WSL 为 NAT 网络模式，发行版内不可达，本次未启动。可在 %USERPROFILE%\.wslconfig 的 [wsl2] 段设置 networkingMode=mirrored，执行 wsl --shutdown 重启 WSL 后重试；或关闭 Headroom 后启动 WSL 会话`)
+}
+
+// headroomSpecTargetsWSL 报告已解析 spec 是否落在 WSL distro 内（planner 链
+// 的 WSL 判定输入，与桌面链 EmbeddedLaunchTargetsWSL 语义对齐）。
+func headroomSpecTargetsWSL(spec platform.ResolvedLaunchSpec) bool {
+	return spec.BootstrapMode == platform.BootstrapWSL
+}
+
+// --- Codex 全局 Headroom × WSL（D6） ---
+//
+// codex 全局压缩的路由载体是宿主侧 ~/.codex/config.toml 的 openai_base_url
+// 标记块（syncCodexGlobalHeadroomConfig）；WSL codex 会话读取发行版侧独立
+// 配置，无同步（wslsupply 的 UnitCodexConfig 不含 headroom 标记块），因此
+// 任何网络模式下压缩都不会对 WSL 会话生效。
+
+// codexHeadroomWSLIneffectiveMsg 是「codex 全局压缩对 WSL 会话不生效」的
+// advisory 文案（桌面链启动日志 + 拒绝语义共用，供单测钉文案）。
+func codexHeadroomWSLIneffectiveMsg() string {
+	return `codex 全局压缩（127.0.0.1:8788）的路由写入 Windows 侧 ~/.codex/config.toml，WSL 会话读取发行版侧配置，压缩不会生效；本次 WSL 会话将直连所选 provider 端点`
+}
+
+// errCodexHeadroomWSLUnsupported 是 remote/restart 计划链对「显式选择压缩的
+// WSL codex 会话」的拒绝：无法兑现的压缩选择按明确失败处理，不默默以直连
+// 冒充压缩生效（与 Claude D1 拒绝对称；v1 客户端收到既有 capability 失败
+// 文案，判定细节由宿主侧与桌面链日志/文案承载）。
+func errCodexHeadroomWSLUnsupported() error {
+	return errors.New("codex 压缩路由仅写入宿主侧 config.toml，对 WSL 会话不生效：" + codexHeadroomWSLIneffectiveMsg())
+}
diff --git a/headroom_wsl_gate_test.go b/headroom_wsl_gate_test.go
new file mode 100644
index 0000000..7fedf08
--- /dev/null
+++ b/headroom_wsl_gate_test.go
@@ -0,0 +1,247 @@
+package main
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+
+	"amagi-codebox/internal/config"
+	"amagi-codebox/internal/envvars"
+	"amagi-codebox/internal/headroom"
+	"amagi-codebox/internal/launchplan"
+	"amagi-codebox/internal/paths"
+	"amagi-codebox/internal/platform"
+	"amagi-codebox/internal/remote/contract"
+	"amagi-codebox/internal/secrets"
+	"amagi-codebox/internal/settings"
+)
+
+// --- headroomWSLNetworkAdmission 单测（D1 判定核心） ---
+
+// NAT / unknown（无 .wslconfig）模式：WSL 目标必须拒绝，且拒绝文案携带可
+// 操作的修复指引（与 aiproxy.PinProxyEnvironment 的 NAT 文案同构）。
+func TestHeadroomWSLNetworkAdmissionNATRejected(t *testing.T) {
+	home := t.TempDir() // no .wslconfig -> unknown -> treated as NAT
+	err := headroomWSLNetworkAdmission(true, []string{"USERPROFILE=" + home})
+	if err == nil {
+		t.Fatal("NAT WSL headroom session must be rejected")
+	}
+	msg := err.Error()
+	for _, want := range []string{"NAT", "networkingMode=mirrored", "wsl --shutdown", ".wslconfig", "8787", "未启动"} {
+		if !strings.Contains(msg, want) {
+			t.Errorf("rejection text missing %q: %s", want, msg)
+		}
+	}
+}
+
+// mirrored：遵循现有准入策略放行——放行仅是准入，文案与断言都不宣称连通。
+func TestHeadroomWSLNetworkAdmissionMirroredPasses(t *testing.T) {
+	home := t.TempDir()
+	if err := os.WriteFile(filepath.Join(home, ".wslconfig"), []byte("[wsl2]\nnetworkingMode=mirrored\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := headroomWSLNetworkAdmission(true, []string{"USERPROFILE=" + home}); err != nil {
+		t.Fatalf("mirrored WSL headroom session must be admitted (not a connectivity claim): %v", err)
+	}
+}
+
+// 非 WSL 目标（桌面/外部终端会话）：不受网络模式影响，永不拦截。
+func TestHeadroomWSLNetworkAdmissionNonWSLPasses(t *testing.T) {
+	home := t.TempDir() // NAT-shaped home on purpose
+	if err := headroomWSLNetworkAdmission(false, []string{"USERPROFILE=" + home}); err != nil {
+		t.Fatalf("non-WSL session must never hit the gate: %v", err)
+	}
+}
+
+func TestHeadroomSpecTargetsWSL(t *testing.T) {
+	if !headroomSpecTargetsWSL(platform.ResolvedLaunchSpec{BootstrapMode: platform.BootstrapWSL}) {
+		t.Fatal("BootstrapWSL spec must target WSL")
+	}
+	if headroomSpecTargetsWSL(platform.ResolvedLaunchSpec{BootstrapMode: platform.BootstrapShellAttach}) {
+		t.Fatal("non-WSL spec must not target WSL")
+	}
+}
+
+// D6：codex 全局压缩对 WSL 不生效的 advisory/拒绝文案钉（路由载体是宿主侧
+// config.toml，WSL 会话读取发行版侧独立配置）。
+func TestCodexHeadroomWSLIneffectiveMsg(t *testing.T) {
+	msg := codexHeadroomWSLIneffectiveMsg()
+	for _, want := range []string{"8788", "config.toml", "WSL", "不会生效"} {
+		if !strings.Contains(msg, want) {
+			t.Errorf("advisory text missing %q: %s", want, msg)
+		}
+	}
+	if err := errCodexHeadroomWSLUnsupported(); err == nil || !strings.Contains(err.Error(), "不生效") {
+		t.Fatalf("unsupported error must carry the ineffective semantics: %v", err)
+	}
+}
+
+// --- planner 链集成（D1/D6 的 remote/restart 面） ---
+
+// wslSpecCLIResolver 把一切请求解析为落在 WSL distro 内的 spec（env 透传，
+// 使 WSLNetworkingMode 能从 spec.Env.Variables 的 USERPROFILE 定位 .wslconfig）。
+type wslSpecCLIResolver struct{}
+
+func (wslSpecCLIResolver) Resolve(req platform.ResolveRequest) (platform.ResolvedLaunchSpec, error) {
+	return platform.ResolvedLaunchSpec{
+		AppType: req.AppType, LaunchMode: req.LaunchMode, WorkDir: req.WorkDir,
+		CLI:           platform.ResolvedCLI{Name: req.AppType, Path: "/wsl/echo"},
+		Env:           platform.ResolvedEnv{Variables: append([]string(nil), req.Env...)},
+		BootstrapMode: platform.BootstrapWSL,
+	}, nil
+}
+
+func (wslSpecCLIResolver) ResolveExecutable(command string, args []string, env []string) (platform.ResolvedCLI, platform.LaunchDiagnostics, error) {
+	return platform.ResolvedCLI{Name: "test", Path: "/wsl/echo"}, platform.LaunchDiagnostics{}, nil
+}
+
+// newHeadroomGatePlanner 构造带可注入 resolver 的 planner（isolated home，
+// .wslconfig 内容由 networkingMode 控制，"" = 无文件 → NAT fail-safe）。
+// 返回 planner 与其背后的 config/secrets 服务（供用例直接注入 provider/key）。
+func newHeadroomGatePlanner(t *testing.T, resolver platform.CLIResolver, networkingMode string) (*appLaunchPlanner, *config.ConfigService, *secrets.SecretsService) {
+	t.Helper()
+	homeDir := isolatedHome(t)
+	if networkingMode != "" {
+		if err := os.WriteFile(filepath.Join(homeDir, ".wslconfig"), []byte(networkingMode), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	dir := t.TempDir()
+	cfgSvc := config.NewConfigService(dir)
+	if err := cfgSvc.Load(); err != nil {
+		t.Fatalf("config Load: %v", err)
+	}
+	settingsSvc := settings.NewService(dir)
+	if err := settingsSvc.Load(); err != nil {
+		t.Fatalf("settings Load: %v", err)
+	}
+	defaults, err := launchplan.NewDefaultStore(settingsSvc)
+	if err != nil {
+		t.Fatalf("NewDefaultStore: %v", err)
+	}
+	secSvc := secrets.NewSecretsService(dir)
+	return newAppLaunchPlanner(cfgSvc, secSvc, defaults, resolver,
+		fakePlatformCaps(), paths.NewPathsService(dir), envvars.NewEnvVarsService(dir), homeDir), cfgSvc, secSvc
+}
+
+func saveHeadroomGateProvider(t *testing.T, cfgSvc *config.ConfigService, secSvc *secrets.SecretsService, cli contract.CLIType) {
+	t.Helper()
+	provider := config.Provider{
+		Anthropic:    &config.AnthropicFormat{Enabled: true, BaseURL: "https://api.test.com"},
+		DefaultModel: "test-model",
+	}
+	if cli == contract.CLITypeCodex {
+		provider.Anthropic = nil
+		provider.OpenAI = &config.OpenAIFormat{Enabled: true, BaseURL: "https://api.openai.com/v1", AuthKey: "OPENAI_API_KEY"}
+	}
+	if err := cfgSvc.SaveProvider("gate-provider", provider); err != nil {
+		t.Fatalf("SaveProvider: %v", err)
+	}
+	if err := secSvc.SetAPIKey("gate-provider", "sk-gate"); err != nil {
+		t.Fatalf("SetAPIKey: %v", err)
+	}
+}
+
+func headroomBuildRequest(cli contract.CLIType, useHeadroom bool) launchplan.BuildRequest {
+	on := useHeadroom
+	return launchplan.BuildRequest{
+		CLIType: cli, Origin: launchplan.OriginRemote, Mode: launchplan.ModeEmbedded,
+		Workdir: tWorkdirForGate(),
+		StableRefs: &launchplan.StableLaunchRefs{
+			ProviderRef: "gate-provider", ModelRef: "test-model", UseHeadroom: &on,
+		},
+	}
+}
+
+func tWorkdirForGate() string { return os.TempDir() }
+
+func hasEffectKind(plan *launchplan.Plan, kind launchplan.EffectKind) bool {
+	for _, e := range plan.Effects {
+		if e.Kind == kind {
+			return true
+		}
+	}
+	return false
+}
+
+// D1 remote 链：UseHeadroom + WSL spec + NAT（无 .wslconfig）→ 计划构建即拒绝
+// （FailureCapability），不产生 HeadroomStart effect、不启动 PTY——宿主侧 8787
+// 不会被启动，distro 内也不会拿到不可达的 ANTHROPIC_BASE_URL 会话。
+func TestBuildClaudePlanHeadroomWSLNATRejected(t *testing.T) {
+	p, cfgSvc, secSvc := newHeadroomGatePlanner(t, wslSpecCLIResolver{}, "")
+	saveHeadroomGateProvider(t, cfgSvc, secSvc, contract.CLITypeClaudeCode)
+	plan, failure := p.BuildPlan(context.Background(), headroomBuildRequest(contract.CLITypeClaudeCode, true))
+	if failure == nil || failure.Kind != launchplan.FailureCapability {
+		t.Fatalf("headroom + WSL + NAT must fail plan build with FailureCapability, got plan=%v failure=%+v", plan, failure)
+	}
+	if plan != nil {
+		t.Fatalf("rejected plan must not be returned: %+v", plan)
+	}
+}
+
+// D1 remote 链 mirrored：放行且计划携带 HeadroomStart effect（准入语义，
+// 不构成连通性声明——与 aiproxy 闸门同款行为）。
+func TestBuildClaudePlanHeadroomWSLMirroredAdmitted(t *testing.T) {
+	p, cfgSvc, secSvc := newHeadroomGatePlanner(t, wslSpecCLIResolver{}, "[wsl2]\nnetworkingMode=mirrored\n")
+	saveHeadroomGateProvider(t, cfgSvc, secSvc, contract.CLITypeClaudeCode)
+	plan, failure := p.BuildPlan(context.Background(), headroomBuildRequest(contract.CLITypeClaudeCode, true))
+	if failure != nil {
+		t.Fatalf("mirrored headroom WSL session must be admitted: %+v", failure)
+	}
+	if !hasEffectKind(plan, launchplan.EffectHeadroomStart) {
+		t.Fatalf("admitted plan must carry the headroom effect: %+v", plan.Effects)
+	}
+}
+
+// 非 WSL spec：UseHeadroom 会话不受闸门影响（无 .wslconfig 的 NAT 形态宿主
+// 也不拦——闸门只对 WSL 目标生效，防止误伤普通桌面/远端会话）。
+func TestBuildClaudePlanHeadroomNonWSLUnaffected(t *testing.T) {
+	p, cfgSvc, secSvc := newHeadroomGatePlanner(t, fakeCLIResolver{}, "")
+	saveHeadroomGateProvider(t, cfgSvc, secSvc, contract.CLITypeClaudeCode)
+	plan, failure := p.BuildPlan(context.Background(), headroomBuildRequest(contract.CLITypeClaudeCode, true))
+	if failure != nil {
+		t.Fatalf("non-WSL headroom session must not hit the WSL gate: %+v", failure)
+	}
+	if !hasEffectKind(plan, launchplan.EffectHeadroomStart) {
+		t.Fatalf("plan must keep the headroom effect: %+v", plan.Effects)
+	}
+}
+
+// D6 remote 链：显式选择压缩的 WSL codex 会话按「无法兑现即拒绝」处理——
+// mirrored 也不放行（路由载体是宿主侧 config.toml，网络模式无关）。
+func TestBuildCodexPlanHeadroomWSLRejected(t *testing.T) {
+	for _, mode := range []string{"", "[wsl2]\nnetworkingMode=mirrored\n", "[wsl2]\nnetworkingMode=nat\n"} {
+		p, cfgSvc, secSvc := newHeadroomGatePlanner(t, wslSpecCLIResolver{}, mode)
+		saveHeadroomGateProvider(t, cfgSvc, secSvc, contract.CLITypeCodex)
+		plan, failure := p.BuildPlan(context.Background(), headroomBuildRequest(contract.CLITypeCodex, true))
+		if failure == nil || failure.Kind != launchplan.FailureCapability {
+			t.Fatalf("codex headroom + WSL must be rejected regardless of networking mode (mode=%q), got plan=%v failure=%+v", mode, plan, failure)
+		}
+	}
+}
+
+// D6 remote 链：非 WSL codex 会话维持既有行为（UseHeadroom 照旧加
+// HeadroomStart effect，不因本闸门改变）。
+func TestBuildCodexPlanHeadroomNonWSLUnaffected(t *testing.T) {
+	p, cfgSvc, secSvc := newHeadroomGatePlanner(t, fakeCLIResolver{}, "")
+	saveHeadroomGateProvider(t, cfgSvc, secSvc, contract.CLITypeCodex)
+	plan, failure := p.BuildPlan(context.Background(), headroomBuildRequest(contract.CLITypeCodex, true))
+	if failure != nil {
+		t.Fatalf("non-WSL codex headroom session must keep existing behavior: %+v", failure)
+	}
+	if !hasEffectKind(plan, launchplan.EffectHeadroomStart) {
+		t.Fatalf("plan must keep the codex headroom effect: %+v", plan.Effects)
+	}
+}
+
+// 引用保持：headroom 包端口常量在闸门文案中被钉定（8787），防止文案与实际
+// 监听端口漂移。
+func TestHeadroomGatePortMatchesClaudeDefault(t *testing.T) {
+	if !strings.Contains(headroomWSLNetworkAdmission(true, []string{"USERPROFILE=" + t.TempDir()}).Error(),
+		"127.0.0.1:"+strconv.Itoa(headroom.DefaultPort)) {
+		t.Fatalf("gate text must pin the claude headroom port %d", headroom.DefaultPort)
+	}
+}
diff --git a/internal/launcher/wsl_supply_core_regression_test.go b/internal/launcher/wsl_supply_core_regression_test.go
new file mode 100644
index 0000000..12b5c0d
--- /dev/null
+++ b/internal/launcher/wsl_supply_core_regression_test.go
@@ -0,0 +1,169 @@
+package launcher
+
+// wsl_supply_core_regression_test.go — wsl-goal-closure 供给内核修复的
+// launcher 侧正式回归（SA-06 目标侧私有 staging / SA-07 失败不删混合配置 /
+// 零写入路径权限复核）。全部经注入接缝与合成字节运行，不触达真实 WSL、
+// 不读取真实凭据；真机取证脚本见 agent-outputs/workflow/wsl-goal-closure/。
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func mustTime(layout string) time.Time {
+	t, err := time.Parse(time.RFC3339, layout)
+	if err != nil {
+		panic(err)
+	}
+	return t
+}
+
+// 敏感 chmod 失败必须发生在 rename 之前：已有混合配置（含用户自有 provider）
+// 原样保留，绝不整文件删除（SA-07 的 launcher 对应面——旧实现 rename 后才
+// chmod，失败时删除整个 models.json，连同用户自有 provider 一起丢失）。
+func TestWriteWSLPiAgentConfigChmodFailurePreservesMixedConfig(t *testing.T) {
+	ft := installFakeWSLTarget(t)
+	agentDir := ft.uncPath("/home/wslu/.pi/agent")
+	if err := os.MkdirAll(agentDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	mixed := `{"providers":{"local-user":{"baseUrl":"https://user.example"}},"userSetting":true}`
+	if err := os.WriteFile(filepath.Join(agentDir, "models.json"), []byte(mixed), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	origChmod := wslChmodFn
+	wslChmodFn = func(string, string, ...string) error { return os.ErrPermission }
+	t.Cleanup(func() { wslChmodFn = origChmod })
+
+	cfg := map[string]any{"providers": map[string]any{"amagi-glm": map[string]any{"baseUrl": "https://x.example", "apiKey": "sk"}}}
+	if _, err := WriteWSLPiAgentConfig("Ubuntu", cfg); err == nil {
+		t.Fatal("chmod failure must fail the write (fail closed)")
+	}
+	got, readErr := os.ReadFile(filepath.Join(agentDir, "models.json"))
+	if readErr != nil || string(got) != mixed {
+		t.Fatalf("pre-existing user content must be preserved on chmod failure, got %q err=%v", got, readErr)
+	}
+	// staging 不留半提交字节（chmod 失败在 rename 前；目录可能尚未建立）。
+	if entries, readErr := os.ReadDir(filepath.Join(agentDir, ".amagi-staging")); readErr == nil && len(entries) != 0 {
+		t.Fatalf("staging must hold no partial bytes after failure: %v", entries)
+	}
+}
+
+// A2 同步 chmod 失败：distro 侧既有副本（旧凭据）原样保留并降级
+// （DistroHasCopy）——不再删除副本（SA-06 后失败发生在 rename 之前）。
+func TestSyncAuthChmodFailureKeepsOldDistroCopy(t *testing.T) {
+	fakeWindowsAuth(t, `{"newer":{"type":"oauth"}}`)
+	root, _ := fakeWSLForSync(t, os.ErrPermission)
+	writeDistroAuth(t, root, `{"old":{"type":"oauth"}}`, mustTime("2026-01-01T00:00:00Z"))
+	stubDistroMTime(t, mustTime("2025-12-01T00:00:00Z")) // distro 旧 → 前向写触发
+	outcome, err := SyncWSLPiLoginAuth("Ubuntu")
+	if err == nil {
+		t.Fatal("chmod failure must fail the sync attempt")
+	}
+	if outcome != SyncWSLPiLoginAuthDistroHasCopy {
+		t.Fatalf("outcome = %v, want DistroHasCopy (old copy intact, degraded)", outcome)
+	}
+	got, readErr := os.ReadFile(distroAuthPath(root))
+	if readErr != nil || string(got) != `{"old":{"type":"oauth"}}` {
+		t.Fatalf("old distro copy must survive: %q err=%v", got, readErr)
+	}
+}
+
+// 零写入路径（字节一致）权限被改宽 → 重收紧 600；无法收紧 → 报错
+// （SA-06：无变化路径不得绕过权限检查；steer#4）。
+func TestWriteWSLPiAgentConfigZeroWriteRetightensLooseMode(t *testing.T) {
+	ft := installFakeWSLTarget(t)
+	agentDir := ft.uncPath("/home/wslu/.pi/agent")
+	if err := os.MkdirAll(agentDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	cfg := map[string]any{"providers": map[string]any{"amagi-glm": map[string]any{"baseUrl": "https://x.example"}}}
+	if _, err := WriteWSLPiAgentConfig("Ubuntu", cfg); err != nil {
+		t.Fatal(err)
+	}
+	// 第一次写入后，最终文件在 fake modes 中无记录（chmod 落在 staging tmp 上）；
+	// 显式把最终路径置为 644 模拟「已存在但被改宽」。
+	ft.modes["/home/wslu/.pi/agent/models.json"] = "644"
+	before, _ := os.ReadFile(filepath.Join(agentDir, "models.json"))
+	chmods := len(ft.chmodCalls)
+	if _, err := WriteWSLPiAgentConfig("Ubuntu", cfg); err != nil {
+		t.Fatalf("zero-write with loose mode must retighten and succeed: %v", err)
+	}
+	if len(ft.chmodCalls) != chmods+1 {
+		t.Fatalf("loose mode must trigger one retighten chmod, %d -> %d", chmods, len(ft.chmodCalls))
+	}
+	if mode := ft.modes["/home/wslu/.pi/agent/models.json"]; mode != "600" {
+		t.Fatalf("final mode must be 600 after retighten, got %q", mode)
+	}
+	after, _ := os.ReadFile(filepath.Join(agentDir, "models.json"))
+	if string(before) != string(after) {
+		t.Fatal("zero-write must not rewrite bytes")
+	}
+
+	// 重收紧失败（chmod 报错但仅限该路径）→ 必须报错而不是静默放行。
+	origChmod := wslChmodFn
+	wslChmodFn = func(_, mode string, paths ...string) error {
+		for _, p := range paths {
+			if p == "/home/wslu/.pi/agent/models.json" && mode == "600" {
+				return os.ErrPermission
+			}
+		}
+		return nil
+	}
+	t.Cleanup(func() { wslChmodFn = origChmod })
+	ft.modes["/home/wslu/.pi/agent/models.json"] = "644"
+	if _, err := WriteWSLPiAgentConfig("Ubuntu", cfg); err == nil {
+		t.Fatal("un-re-tightenable loose secret file must fail (steer#4: repair or block)")
+	}
+}
+
+// staging 隔离无法验证（StatMode 探测失败）→ 任何秘密字节落盘前失败，
+// 且错误语义可观测（SA-06 fail-closed 验证面）。
+func TestWriteWSLPiAgentConfigFailsWhenStagingUnverifiable(t *testing.T) {
+	ft := installFakeWSLTarget(t)
+	origStatMode := wslStatModeFn
+	wslStatModeFn = func(_, _ string) (string, bool) { return "", false }
+	t.Cleanup(func() { wslStatModeFn = origStatMode })
+	cfg := map[string]any{"providers": map[string]any{"amagi-glm": map[string]any{"baseUrl": "https://x.example", "apiKey": "sk"}}}
+	_, err := WriteWSLPiAgentConfig("Ubuntu", cfg)
+	if err == nil || !strings.Contains(err.Error(), "unverified") {
+		t.Fatalf("unverifiable staging must fail closed, got %v", err)
+	}
+	if _, statErr := os.Stat(ft.uncPath("/home/wslu/.pi/agent/models.json")); !os.IsNotExist(statErr) {
+		t.Fatal("no secret bytes may land when staging isolation cannot be verified")
+	}
+}
+
+// 敏感提交序列：chmod 600 落在 staging 内文件上（rename 之前）——最终目录
+// 即使 0755（如 ~/.agents、.config 层级由其它工具建立），秘密字节也从未以
+// 宽权限可见（SA-06 的泄漏窗口闭合证明，fixture 级）。
+func TestWriteWSLAgentFileStagedTightensBeforeRename(t *testing.T) {
+	ft := installFakeWSLTarget(t)
+	cfg := map[string]any{"model": "openai/gpt-5"}
+	if _, err := WriteWSLOpenCodeAgentConfig("Ubuntu", cfg); err != nil {
+		t.Fatal(err)
+	}
+	staged600 := ""
+	for _, c := range ft.chmodCalls {
+		if strings.HasPrefix(c, "600 /home/wslu/.config/opencode/.amagi-staging/") {
+			staged600 = c
+		}
+	}
+	if staged600 == "" {
+		t.Fatalf("chmod 600 must target the staged file before rename, calls=%v", ft.chmodCalls)
+	}
+	// 最终文件（.config 层级在真实场景常为 0755）携带收紧后的 0600 宿主位。
+	if info, statErr := os.Stat(ft.uncPath("/home/wslu/.config/opencode/amagi-codebox.json")); statErr != nil || info.Mode().Perm() != 0o600 {
+		t.Fatalf("final file must be 0600, got %v err=%v", info.Mode().Perm(), statErr)
+	}
+	// 序列化内容可回读（幂等字节）。
+	b, _ := os.ReadFile(ft.uncPath("/home/wslu/.config/opencode/amagi-codebox.json"))
+	var got map[string]any
+	if json.Unmarshal(b, &got) != nil || got["model"] != "openai/gpt-5" {
+		t.Fatalf("content roundtrip failed: %s", b)
+	}
+}
