+func TestInstallPiPackageTargetedAnchorUnreadableSkipsWSL(t *testing.T) {
+	app, _, supply, _ := newPluginTargetedTestApp(t, true) // 成功，但不建实体
+	res, err := app.InstallPiPackageTargeted("npm:foo", "both")
+	if err != nil {
