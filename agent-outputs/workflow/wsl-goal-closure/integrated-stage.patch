+	if idx < 0 {
+		return errors.New("登记不存在，无法应用过滤形态")
+	}
+	want := canonicalPackageEntryJSON(source, filters)
+	if items[idx].Raw == want {
+		return nil
+	}
+	next, err := sjson.SetRawBytes(data, "packages."+strconv.Itoa(idx), []byte(want))
+	if err != nil {
+		return fmt.Errorf("settings.json 过滤对象写入失败: %w", err)
+	}
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("agent 根目录不可用: %w", err)
+	}
+	tmp, err := os.CreateTemp(dir, ".amagi-pkg-filters-*")
+	if err != nil {
+		return fmt.Errorf("临时文件创建失败: %w", err)
+	}
+	tmpPath := tmp.Name()
+	if _, werr := tmp.Write(next); werr != nil {
+		_ = tmp.Close()
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("临时文件写入失败: %w", werr)
+	}
+	if cerr := tmp.Close(); cerr != nil {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("临时文件关闭失败: %w", cerr)
+	}
