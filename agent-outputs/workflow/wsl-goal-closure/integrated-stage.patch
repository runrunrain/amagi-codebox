+		if err := defaults.RecordDesktopActivation(launchplan.StableRecipe{
+			CLIType: contract.CLITypeClaudeCode, Workdir: dir,
+			ProviderRef: "prov", PresetRef: "test-preset", ShellRef: "/bin/sh",
