diff --git a/internal/wslsupply/skills_scan.go b/internal/wslsupply/skills_scan.go
index 1dbffe1..ba81ff9 100644
--- a/internal/wslsupply/skills_scan.go
+++ b/internal/wslsupply/skills_scan.go
@@ -215,12 +215,14 @@ func isAbsoluteLikeLinkTarget(t string) bool {
 		c := t[0]
 		return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z')
 	}
-	// 宿主原生绝对形态：Windows 上单反斜杠开头的盘根相对目标（如 \abs，由
-	// CreateSymbolicLink 对 "/abs" 形目标的规范化产生）是绝对路径——此前漏判
-	// 致 resolve 落到盘根后 ENOENT，被误归为 non-regular-entry。POSIX 上同形
-	// 字符串只是普通相对文件名，filepath.IsAbs 按宿主原生语义精确区分（POSIX
-	// 的 IsAbs ⟺ "/" 前缀，已被上面覆盖，POSIX 行为零变化）。
-	return filepath.IsAbs(t)
+	// 宿主原生根起始形态：Windows 上 CreateSymbolicLink 把 "/abs" 形目标存为
+	// 盘根相对的 \abs（Windows 真机实测 Readlink 返回 `\abs\target`，且
+	// filepath.IsAbs 对其为 false——无卷名不算「绝对」，故不能用 IsAbs 判定）。
+	// 该形态逃出 skill 树、不可移植，必须归为绝对形态；否则 resolve 会把它当
+	// 相对路径拼到链接目录下 ENOENT，被误归为 non-regular-entry。
+	// os.IsPathSeparator 按宿主原生语义区分：Windows 上 '\' 为分隔符；POSIX
+	// 上 '\' 只是普通文件名字符（"/" 前缀已被上面覆盖，POSIX 行为零变化）。
+	return os.IsPathSeparator(t[0])
 }
 
