+func selectionMatchesKey(selected map[string]bool, key string, allKeys []string) bool {
+	if len(selected) == 0 {
+		return false
+	}
+	if selected[key] {
+		return true
+	}
+	leaf := keyLeafName(key)
+	if !selected[leaf] {
+		return false
+	}
+	for _, k := range allKeys {
+		if k != key && keyLeafName(k) == leaf {
+			return false // 同名叶跨作用域双义：叶名不唯一，保守不选
+		}
+	}
+	return true
+}
