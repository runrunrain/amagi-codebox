+	home, _ := os.UserHomeDir()
+	agentDir := filepath.Join(home, ".pi", "agent")
+	if err := os.Chmod(agentDir, 0o500); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(agentDir, 0o700) })
+	// chmod 永远失败 → 收紧不可复验。
+	origChmod := wslChmodFn
+	wslChmodFn = func(string, string, ...string) error { return errors.New("chmod dead") }
+	t.Cleanup(func() { wslChmodFn = origChmod })
