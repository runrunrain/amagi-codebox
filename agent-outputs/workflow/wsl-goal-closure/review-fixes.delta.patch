+		if err := os.Chmod(distroAuthPath(root), 0o644); err != nil {
+			t.Fatal(err)
+		}
+		// 使 Windows 侧 agent 目录不可写：回写失败 → 降级分支 → 副本权限复核。
+		home, _ := os.UserHomeDir()
