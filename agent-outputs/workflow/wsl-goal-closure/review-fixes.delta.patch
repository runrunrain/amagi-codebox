+}
+
+type atomicValue struct {
+	mu sync.Mutex
+	v  any
+}
+
+func (a *atomicValue) Store(v any) {
+	a.mu.Lock()
+	a.v = v
+	a.mu.Unlock()
+}
+
+func (a *atomicValue) Load() any {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	return a.v
+}
