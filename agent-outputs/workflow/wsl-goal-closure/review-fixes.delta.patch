+// TestReviewFixPR03ReadbackMismatchBoundedRecovery（反例：phase-review-restore-repro.go）：
+// 持续读回失配时恢复有界（不再递归重提交）、目标现状不被删除、前像被
+// 保全为 0600 恢复备份、错误如实报告恢复路径。
+func TestReviewFixPR03ReadbackMismatchBoundedRecovery(t *testing.T) {
+	c, fp := publishVisionForRecovery(t)
+	prevBytes, err := os.ReadFile(visionFile(fp))
+	if err != nil {
+		t.Fatal(err)
+	}
+	// 来源变化触发一次更新写入；staging 临时名内容被接缝改写 → rename 后
+	// 读回失配（目标既非本次提交也非前像）。
+	c2content := `{"version":1,"updated_at":"t2","models":[{"id":"p/m2","api_key":"sk2"}]}`
+	shared := &stubSharedSource{vision: func() ([]byte, error) { return []byte(c2content), nil }, modality: func() ([]byte, error) { return nil, nil }}
+	c.projections[UnitSharedVisionExport] = NewVisionExportAdapter(shared)
+	sab := &stagingSabotage{uncRoot: fp.uncRoot, payload: func(attempt int) []byte {
+		return []byte(fmt.Sprintf("sabotaged staging bytes %d", attempt))
+	}}
+	sab.install(t, c)
+	res := runUnit(t, c, CLICommon, UnitSharedVisionExport)
+	if res.Results[0].Outcome != UnitFailed || res.Results[0].Detail != "write-failed" {
+		t.Fatalf("persistent read-back mismatch must fail the unit, got %+v", res.Results[0])
+	}
+	if sab.writes > 2 {
+		t.Fatalf("recovery must be bounded and non-recursive, staging writes = %d", sab.writes)
+	}
+	got, err := os.ReadFile(visionFile(fp))
+	if err != nil || len(got) == 0 {
+		t.Fatalf("unknown target content must be left intact, got %q err=%v", got, err)
+	}
+	if res.Results[0].Err == nil || !strings.Contains(res.Results[0].Err.Error(), "manual recovery") {
+		t.Fatalf("error must point at manual recovery, got %v", res.Results[0].Err)
+	}
+	// 前像保全：目标目录下存在 .amagi-supply-recover-* 备份，内容等于提交前
+	// 前像且 0600（秘密备份同样私有落盘）。
+	entries, derr := os.ReadDir(filepath.Dir(visionFile(fp)))
+	if derr != nil {
+		t.Fatal(derr)
+	}
+	var backups []string
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), ".amagi-supply-recover-") {
+			backups = append(backups, filepath.Join(filepath.Dir(visionFile(fp)), e.Name()))
+		}
+	}
+	if len(backups) == 0 {
+		t.Fatalf("user preimage must be preserved as a recovery backup, dir=%v", entries)
+	}
+	b, berr := os.ReadFile(backups[0])
+	if berr != nil || string(b) != string(prevBytes) {
+		t.Fatalf("backup must hold the preimage verbatim, got %q err=%v", b, berr)
+	}
+	if info, serr := os.Stat(backups[0]); serr != nil || info.Mode().Perm() != 0o600 {
+		t.Fatalf("secret backup must be 0600, got %v err=%v", info.Mode().Perm(), serr)
+	}
+	// 注：恢复备份是设计内残留（错误链指引人工恢复）；staging 内无半提交
+	// 临时名（备份本身不在 .amagi-staging 内）。
+	if entries, serr := os.ReadDir(filepath.Join(filepath.Dir(visionFile(fp)), ".amagi-staging")); serr == nil && len(entries) != 0 {
+		t.Fatalf("staging must hold no half-committed temp names: %v", entries)
+	}
+}
