+	seedS4Generation(t, app.WSLSupply.(*wslsupply.Coordinator))
+	if err := app.SetWSLOpenCodeMCPSelection([]string{"fetch"}); err != nil {
+		t.Fatalf("save with bound generation: %v", err)
+	}
