+	if err != nil {
+		return fmt.Errorf("settings.json 过滤对象写入失败: %w", err)
+	}
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("agent 根目录不可用: %w", err)
+	}
+	tmp, err := os.CreateTemp(dir, ".amagi-pkg-filters-*")
+	if err != nil {
+		return fmt.Errorf("临时文件创建失败: %w", err)
+	}
+	tmpPath := tmp.Name()
