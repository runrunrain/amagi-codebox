+// TestPluginEmptyArrayFilterDriftNotAlreadyOK：期望显式空数组而 distro 侧
+// 仍是纯字符串（或键省略）时不得 already-ok——重放射敛为带 [] 的过滤对象。
+func TestPluginEmptyArrayFilterDriftNotAlreadyOK(t *testing.T) {
