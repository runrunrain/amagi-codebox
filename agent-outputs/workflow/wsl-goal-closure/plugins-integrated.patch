+// TestPluginFacadeCanceledBeforeResolve：协调器门面在目标解析前拦截已取消
+// 请求（SA16：不触发任何身份探测/命令面——不产生 wsl.exe 进程）。
+func TestPluginFacadeCanceledBeforeResolve(t *testing.T) {
