+			for j < len(data) {
+				switch data[j] {
+				case ' ', '\t', '\n', '\r':
+					j++
+					continue
+				}
+				break
+			}
+			if j < len(data) && (data[j] == '}' || data[j] == ']') {
+				continue // 尾逗号丢弃
+			}
+			out = append(out, c)
+		default:
+			out = append(out, c)
+		}
+	}
+	return out
+}
