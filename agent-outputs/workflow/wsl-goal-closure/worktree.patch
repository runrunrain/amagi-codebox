+	for _, id := range ids {
+		op := intents[id]
+		if op.TargetDistro != distro {
+			continue
+		}
+		if _, settled := st.SettledOperations[op.OpID]; settled {
+			continue
+		}
+		out = append(out, PendingIntentSummary{OpID: op.OpID, Kind: op.Kind, Unit: op.Unit, RelPath: op.RelPath})
+	}
+	return out
+}
