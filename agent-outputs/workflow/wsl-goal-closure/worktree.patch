+// entrySensitiveCopyPending 判定单条登记是否意味着受管敏感副本可能仍在。
+func entrySensitiveCopyPossible(e StateEntry) bool {
+	if e.Detached {
+		return false // 用户显式保留本地：副本归属用户，不再是受管副本风险
