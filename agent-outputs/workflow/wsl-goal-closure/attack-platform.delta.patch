+// countingCtx 在第 n 次 Err() 调用时取消自身（确定性钉住「候选写入后、
+// rename 前」的取消窗口）。
+type countingCtx struct {
+	context.Context
+	mu       sync.Mutex
+	cancelAt int
+	calls    int
+	canceled bool
+}
+
+func (c *countingCtx) Err() error {
+	c.mu.Lock()
+	c.calls++
+	trigger := c.calls >= c.cancelAt
+	c.mu.Unlock()
+	if trigger && !c.canceled {
+		c.canceled = true
+	}
+	if c.canceled {
+		return context.Canceled
+	}
+	return nil
+}
