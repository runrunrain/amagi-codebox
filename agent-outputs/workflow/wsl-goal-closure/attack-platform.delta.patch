+		{"linux-dir-mismatch", func(f *a2Fake, target *WSLAgentTarget) { target.LinuxDir = "/home/wslu/.pi/elsewhere" }},
+		{"unc-dir-mismatch", func(f *a2Fake, target *WSLAgentTarget) { target.UNCDir = filepath.Join(f.root, "elsewhere") }},
