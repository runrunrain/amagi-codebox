--- /dev/null
+++ b/internal/platform/ensure_private.go
@@ -0,0 +1,135 @@
+package platform
+
+// ensure_private.go — 宿主本地受管路径的私有化原语（wsl-goal-closure 攻坚 G0）。
+//
+// 用途边界：服务宿主本地配置/状态/pending 目录（如 ~/.amagi-codebox/ 下
+// wsl-config-supply-pending/）的「当前用户私有」语义——目录 0700 / 文件 0600。
+// 它不冒充 WSL POSIX 权限：distro 内文件的 mode 位必须走 WSLChmod/
+// WSLFileMode（9P 语义见 wsl_home.go 实证注释）。
+//
+// 语义（attack-contract「私有目录/文件」）：
+//   - 建立（不存在则创建）并收紧（已存在则收窄）到当前用户私有；
+//   - 验证而非只设置：设置后必须重新读回权限/ACL 证明隔离成立，验证不可
+//     证即返回错误（fail closed，调用方不得当作已私有化）；
+//   - 拒绝符号链接：入口与收尾各做一次 Lstat 符号链接检查（chmod/ACL 按
+//     名字操作会跟随链接打到别处；首尾双查把竞态窗口压到最小并如实报错）；
+//   - 仅修改传入的受管路径本身，不改系统/全局配置。
+//
+// 威胁模型（明示）：允许的访问主体只有当前用户、LOCAL SYSTEM 与内建
+// Administrators 组（SYSTEM/管理员是 Windows 上文件所有权与备份语义的
+// 标准伴生主体）；其它本机用户不得读/写。POSIX 侧以 owner-only mode 位
+// 表达同一语义。错误信息不携带 SID/ACL 原始内容（不含任何凭据性材料）。
+//
+// Windows 分文件实现真实 DACL（SetNamedSecurityInfo + 读回验证），不以
+// os.Chmod(0600) 冒充（os.Chmod 在 Windows 只拨只读属性）；Windows 实际
+// ACL 行为未真机验证，交叉编译通过只证明可编译。
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// ErrPrivatePathNotRegular / ErrPrivatePathNotDir 报告受管路径类型不符。
+var (
+	ErrPrivatePathNotDir     = errors.New("managed private path is not a directory")
+	ErrPrivatePathNotRegular = errors.New("managed private path is not a regular file")
+	ErrPrivatePathSymlink    = errors.New("managed private path is or became a symlink")
+)
+
+// validatePrivatePath 检查受管路径形态：非空、绝对路径（相对路径随进程
+// cwd 漂移，不作为受管锚点）。
+func validatePrivatePath(path string) error {
+	if strings.TrimSpace(path) == "" {
+		return fmt.Errorf("private path is empty")
+	}
+	if !filepath.IsAbs(path) {
+		return fmt.Errorf("private path must be absolute: %q", path)
+	}
+	return nil
+}
+
+// rejectPrivateSymlink 在检查点拒绝符号链接（含 junction/其它 reparse 形态：
+// os.Lstat 在 Windows 对 symlink 与 mount point 均报 ModeSymlink）。
+func rejectPrivateSymlink(path string, info os.FileInfo, err error) error {
+	if err != nil {
+		if errors.Is(err, fs.ErrNotExist) {
+			return nil // 不存在是「建立」分支的合法状态
+		}
+		return err
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("%w: %s", ErrPrivatePathSymlink, path)
+	}
+	return nil
+}
+
+// EnsurePrivateDir 建立/收紧并验证当前用户私有目录（0700 语义，Windows 为
+// 等价 owner-only DACL）。目录不存在时逐级创建（新建级按私有语义落位）；
+// 已存在时收紧并复验；任何一步验证不可证即失败，不虚报已私有化。
+func EnsurePrivateDir(path string) error {
+	if err := validatePrivatePath(path); err != nil {
+		return err
+	}
+	if info, err := os.Lstat(path); err != nil {
+		if !errors.Is(err, fs.ErrNotExist) {
+			return err
+		}
+	} else if err := rejectPrivateSymlink(path, info, nil); err != nil {
+		return err
+	} else if !info.IsDir() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotDir, path)
+	}
+	if err := ensurePrivateDirOS(path); err != nil {
+		return err
+	}
+	// 收尾复验：类型仍为目录且未被换成符号链接（类型/权限细节由 per-OS
+	// ensurePrivateDirOS 内部验证，这里只做跨竞态的类型复检）。
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("verify private dir %s: %w", path, err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("%w: %s", ErrPrivatePathSymlink, path)
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotDir, path)
+	}
+	return nil
+}
+
+// EnsurePrivateFile 建立/收紧并验证当前用户私有文件（0600 语义，Windows 为
+// 等价 owner-only DACL）。文件不存在时以私有语义创建（空文件，调用方后续
+// 以原子写填充）；已存在时收紧并复验；既有的非普通文件（目录/符号链接/
+// 设备等）一律拒绝。
+func EnsurePrivateFile(path string) error {
+	if err := validatePrivatePath(path); err != nil {
+		return err
+	}
+	if info, err := os.Lstat(path); err != nil {
+		if !errors.Is(err, fs.ErrNotExist) {
+			return err
+		}
+	} else if err := rejectPrivateSymlink(path, info, nil); err != nil {
+		return err
+	} else if !info.Mode().IsRegular() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotRegular, path)
+	}
+	if err := ensurePrivateFileOS(path); err != nil {
+		return err
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("verify private file %s: %w", path, err)
+	}
+	if info.Mode()&os.ModeSymlink != 0 {
+		return fmt.Errorf("%w: %s", ErrPrivatePathSymlink, path)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotRegular, path)
+	}
+	return nil
+}
diff --git a/internal/platform/ensure_private_unix.go b/internal/platform/ensure_private_unix.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/ensure_private_unix.go
@@ -0,0 +1,68 @@
+//go:build !windows
+
+package platform
+
+import (
+	"errors"
+	"fmt"
+	"io/fs"
+	"os"
+	"path/filepath"
+)
+
+// ensurePrivateDirOS（POSIX）：逐级创建目录（新建级 0700），随后对目标目录
+// 本身收紧 0700 并读回复验——验证而非只设置（umask 可能宽于请求位）。
+func ensurePrivateDirOS(path string) error {
+	if err := os.MkdirAll(path, 0o700); err != nil {
+		return fmt.Errorf("create private dir: %w", err)
+	}
+	if err := os.Chmod(path, 0o700); err != nil {
+		return fmt.Errorf("tighten private dir 0700: %w", err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("verify private dir: %w", err)
+	}
+	if !info.IsDir() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotDir, path)
+	}
+	if got := info.Mode().Perm(); got != 0o700 {
+		return fmt.Errorf("private dir %s mode = %o, want 700 (isolation unverified)", path, got)
+	}
+	return nil
+}
+
+// ensurePrivateFileOS（POSIX）：不存在则以 O_CREATE|O_EXCL 0600 创建（EXCL
+// 使并发创建竞争失败者拿到明确错误而非复用他人文件）；已存在则收紧 0600
+// 并读回复验。符号链接在共享入口前后双查，此处 chmod 落到的即是受管文件
+// 本体（若在窗口内被换成链接，收尾 Lstat 复检会拒绝）。
+func ensurePrivateFileOS(path string) error {
+	if _, err := os.Lstat(path); err != nil && errors.Is(err, fs.ErrNotExist) {
+		// 父目录缺失时按私有目录语义建立（0700），私有文件不落在未验证的
+		// 父级里；父级已存在则顺带收紧验证。
+		if err := ensurePrivateDirOS(filepath.Dir(path)); err != nil {
+			return err
+		}
+		f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+		if err != nil {
+			return fmt.Errorf("create private file: %w", err)
+		}
+		if err := f.Close(); err != nil {
+			return fmt.Errorf("close new private file: %w", err)
+		}
+	}
+	if err := os.Chmod(path, 0o600); err != nil {
+		return fmt.Errorf("tighten private file 0600: %w", err)
+	}
+	info, err := os.Lstat(path)
+	if err != nil {
+		return fmt.Errorf("verify private file: %w", err)
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("%w: %s", ErrPrivatePathNotRegular, path)
+	}
+	if got := info.Mode().Perm(); got != 0o600 {
+		return fmt.Errorf("private file %s mode = %o, want 600 (isolation unverified)", path, got)
+	}
+	return nil
+}
diff --git a/internal/platform/ensure_private_windows.go b/internal/platform/ensure_private_windows.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/ensure_private_windows.go
@@ -0,0 +1,206 @@
+//go:build windows
+
+package platform
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"runtime"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+// ensure_private_windows.go — Windows 受管路径私有化：真实 DACL，而非
+// os.Chmod（后者只拨只读属性，不构成访问隔离）。
+//
+// 实现：SetNamedSecurityInfo 以显式 owner-only DACL 覆盖目标
+//（PROTECTED_DACL 阻断继承混入），随后 GetNamedSecurityInfo 读回并逐 ACE
+// 验证——每个 allow-ACE 的 SID 必须属于允许集合 {当前用户, LOCAL SYSTEM,
+// 内建 Administrators}，且不含 deny/其它类型 ACE；owner 必须是当前用户。
+// 验证不可证即返回错误（fail closed）。
+//
+// 威胁模型（明示）：允许当前用户、LOCAL SYSTEM 与内建 Administrators 完全
+// 访问（SYSTEM/管理员是 Windows 文件所有权/备份语义的标准伴生主体）；其它
+// 本机用户零访问。错误信息不携带 SID 字符串或 DACL 原始内容。
+//
+// 未真机验证声明：本文件经 Windows 交叉编译覆盖编译面；真实 ACL 行为
+//（继承阻断效果、SID/ACE 形态、UNC 目标）未经 Windows 真机验证。
+
+// privateAllowedSIDs 返回允许完全访问的 SID 集合（当前用户 + LOCAL SYSTEM
+// + 内建 Administrators）。每次现取当前用户 SID（进程身份变化时保持正确）。
+func privateAllowedSIDs() ([]*windows.SID, *windows.SID, error) {
+	token := windows.GetCurrentProcessToken()
+	tu, err := token.GetTokenUser()
+	if err != nil {
+		return nil, nil, fmt.Errorf("resolve current user: %w", err)
+	}
+	user := tu.User.Sid
+	system, err := windows.CreateWellKnownSid(windows.WinLocalSystemSid)
+	if err != nil {
+		return nil, nil, fmt.Errorf("resolve LOCAL SYSTEM SID: %w", err)
+	}
+	admins, err := windows.CreateWellKnownSid(windows.WinBuiltinAdministratorsSid)
+	if err != nil {
+		return nil, nil, fmt.Errorf("resolve Administrators SID: %w", err)
+	}
+	return []*windows.SID{user, system, admins}, user, nil
+}
+
+// buildPrivateDACL 构造显式 owner-only DACL：三个允许主体各一条 SET_ACCESS
+// GENERIC_ALL 显式项（目录附子对象继承位，作用于目录内后续新建对象）。
+// runtime.Pinner 固定 SID 以满足 x/sys 的 TrusteeValueFromSID 安全契约
+// （BuildSecurityDescriptor 调用期间保持固定，函数返回即解除）。
+func buildPrivateDACL(isDir bool) (*windows.ACL, error) {
+	sids, _, err := privateAllowedSIDs()
+	if err != nil {
+		return nil, err
+	}
+	inheritance := uint32(0)
+	if isDir {
+		inheritance = windows.SUB_CONTAINERS_AND_OBJECTS_INHERIT
+	}
+	entries := make([]windows.EXPLICIT_ACCESS, 0, len(sids))
+	var pinner runtime.Pinner
+	defer pinner.Unpin()
+	for _, sid := range sids {
+		pinner.Pin(sid)
+		entries = append(entries, windows.EXPLICIT_ACCESS{
+			AccessPermissions: windows.GENERIC_ALL,
+			AccessMode:        windows.SET_ACCESS,
+			Inheritance:       inheritance,
+			Trustee: windows.TRUSTEE{
+				TrusteeForm:  windows.TRUSTEE_IS_SID,
+				TrusteeType:  windows.TRUSTEE_IS_UNKNOWN,
+				TrusteeValue: windows.TrusteeValueFromSID(sid),
+			},
+		})
+	}
+	sd, err := windows.BuildSecurityDescriptor(nil, nil, entries, nil, nil)
+	if err != nil {
+		return nil, fmt.Errorf("build private DACL: %w", err)
+	}
+	dacl, _, err := sd.DACL()
+	if err != nil {
+		return nil, fmt.Errorf("extract private DACL: %w", err)
+	}
+	return dacl, nil
+}
+
+// setPrivateACL 用显式 owner-only DACL 覆盖目标的 DACL（PROTECTED 阻断
+// 继承混入）。按名字操作会跟随符号链接，符号链接拒绝由共享入口的前后
+// 双查承担。
+func setPrivateACL(path string, isDir bool) error {
+	dacl, err := buildPrivateDACL(isDir)
+	if err != nil {
+		return err
+	}
+	var info windows.SECURITY_INFORMATION = windows.DACL_SECURITY_INFORMATION | windows.PROTECTED_DACL_SECURITY_INFORMATION
+	if err := windows.SetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, info, nil, nil, dacl, nil); err != nil {
+		return fmt.Errorf("apply private DACL: %w", err)
+	}
+	return nil
+}
+
+// verifyPrivateACL 读回目标的 owner 与 DACL 并逐 ACE 验证：
+//   - owner 必须是当前用户；
+//   - DACL 必须存在，每个 ACE 必须是 ACCESS_ALLOWED 类型且 SID ∈ 允许集合。
+//
+// 任何 deny-ACE、允许集合之外的 allow-ACE、越界/无法解析的 ACE 都判为
+// 「隔离未验证」。错误不携带 SID/DACL 内容。
+func verifyPrivateACL(path string) error {
+	allowed, currentUser, err := privateAllowedSIDs()
+	if err != nil {
+		return err
+	}
+	isAllowed := func(sid *windows.SID) bool {
+		for _, a := range allowed {
+			if windows.EqualSid(a, sid) {
+				return true
+			}
+		}
+		return false
+	}
+	sd, err := windows.GetNamedSecurityInfo(path, windows.SE_FILE_OBJECT, windows.OWNER_SECURITY_INFORMATION|windows.DACL_SECURITY_INFORMATION)
+	if err != nil {
+		return fmt.Errorf("read back security descriptor: %w", err)
+	}
+	owner, _, err := sd.Owner()
+	if err != nil {
+		return fmt.Errorf("read back owner: %w", err)
+	}
+	if !windows.EqualSid(owner, currentUser) {
+		return fmt.Errorf("private path owner is not the current user (isolation unverified)")
+	}
+	dacl, present, err := sd.DACL()
+	if err != nil {
+		return fmt.Errorf("read back DACL: %w", err)
+	}
+	if !present || dacl == nil {
+		return fmt.Errorf("private path has no DACL (isolation unverified)")
+	}
+	// 逐 ACE 手工遍历（x/sys 的 ACL 不暴露迭代器/尺寸字段）：ACL 头 8 字节
+	//（revision/sbz1/aclSize/aceCount/sbz2），其后连续 ACE 结构。aclSize 未
+	// 导出，以同构镜像头读出。
+	header := (*windowsACLHeader)(unsafe.Pointer(dacl))
+	aclSize := uintptr(header.AclSize)
+	aclBase := unsafe.Pointer(dacl)
+	offset := uintptr(8)
+	for i := uint16(0); i < dacl.AceCount; i++ {
+		if offset+uintptr(unsafe.Sizeof(windows.ACCESS_ALLOWED_ACE{})) > aclSize {
+			return fmt.Errorf("private DACL ACE #%d out of bounds (isolation unverified)", i)
+		}
+		ace := (*windows.ACCESS_ALLOWED_ACE)(unsafe.Pointer(uintptr(aclBase) + offset))
+		if ace.Header.AceType != windows.ACCESS_ALLOWED_ACE_TYPE {
+			return fmt.Errorf("private DACL ACE #%d is not an allow-ACE (isolation unverified)", i)
+		}
+		aceSID := (*windows.SID)(unsafe.Pointer(&ace.SidStart))
+		if !isAllowed(aceSID) {
+			return fmt.Errorf("private DACL ACE #%d grants an unexpected principal (isolation unverified)", i)
+		}
+		offset += uintptr(ace.Header.AceSize)
+	}
+	return nil
+}
+
+// windowsACLHeader 是 x/sys windows.ACL 头的同构镜像（读出未导出的 aclSize
+// 供 ACE 遍历起界；布局由 winnt.h ACL 定义钉住）。
+type windowsACLHeader struct {
+	Revision byte
+	Sbz1     byte
+	AclSize  uint16
+	AceCount uint16
+	Sbz2     uint16
+}
+
+func ensurePrivateDirOS(path string) error {
+	if err := os.MkdirAll(path, 0o700); err != nil {
+		return fmt.Errorf("create private dir: %w", err)
+	}
+	if err := setPrivateACL(path, true); err != nil {
+		return err
+	}
+	return verifyPrivateACL(path)
+}
+
+func ensurePrivateFileOS(path string) error {
+	if _, err := os.Lstat(path); err != nil && os.IsNotExist(err) {
+		// 父目录缺失时按私有目录语义建立（owner-only DACL），私有文件不落
+		// 在未验证的父级里；父级已存在则顺带收紧验证。
+		if perr := ensurePrivateDirOS(filepath.Dir(path)); perr != nil {
+			return perr
+		}
+		f, cerr := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+		if cerr != nil {
+			return fmt.Errorf("create private file: %w", cerr)
+		}
+		if cerr := f.Close(); cerr != nil {
+			return fmt.Errorf("close new private file: %w", cerr)
+		}
+	}
+	if err := setPrivateACL(path, false); err != nil {
+		return err
+	}
+	return verifyPrivateACL(path)
+}
