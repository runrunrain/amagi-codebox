+++ b/internal/platform/move_no_replace_darwin.go
@@ -0,0 +1,14 @@
+//go:build darwin
+
+package platform
+
+import (
+	"golang.org/x/sys/unix"
+)
+
+// moveNoReplaceOS：macOS 以 renamex_np(RENAME_EXCL) 提供同文件系统原子
+// no-replace rename（文件与目录均支持）。目标存在返回 EEXIST（syscall.Errno
+// 的 Is 面即可被 errors.Is(err, os.ErrExist) 判定）。
+func moveNoReplaceOS(source, destination string) error {
+	return unix.RenamexNp(source, destination, unix.RENAME_EXCL)
+}
diff --git a/internal/platform/move_no_replace_linux.go b/internal/platform/move_no_replace_linux.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/move_no_replace_linux.go
@@ -0,0 +1,19 @@
+//go:build linux
+
+package platform
+
+import (
+	"golang.org/x/sys/unix"
+)
+
+// moveNoReplaceOS：Linux 以 renameat2(RENAME_NOREPLACE) 提供同文件系统原子
+// no-replace rename（文件与目录均支持）。目标存在返回 EEXIST；内核不支持
+// renameat2 时返回 ENOSYS/EINVAL——按不支持错误上抛，调用方保留双方实体，
+// 不降级覆盖。
+func moveNoReplaceOS(source, destination string) error {
+	err := unix.Renameat2(unix.AT_FDCWD, source, unix.AT_FDCWD, destination, unix.RENAME_NOREPLACE)
+	if err == unix.ENOSYS || err == unix.EINVAL || err == unix.ENOTTY {
+		return fmtMoveNoReplaceUnsupported(err)
+	}
+	return err
+}
