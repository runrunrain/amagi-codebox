+	t.Run("wrapper success path", func(t *testing.T) {
+		f := &a2Fake{authModes: []string{"600"}}
+		installA2Fake(t, f)
+		now := time.Now()
+		f.writeWindowsAuth(t, `{"win":1}`, now.Add(time.Hour))
+		f.writeDistroAuth(t, `{"old":1}`, now)
+		f.mtime, f.mtimeOK = now, true // distro 旧 → 前向复制
+		outcome, err := SyncWSLPiLoginAuth("Ubuntu")
+		if err != nil || outcome != SyncWSLPiLoginAuthCopied {
+			t.Fatalf("outcome=%v err=%v, want Copied", outcome, err)
+		}
+		if got := mustReadAuth(t, f.distroAuthPath()); got != `{"win":1}` {
+			t.Fatalf("distro bytes = %q, want forward-copied windows bytes", got)
+		}
+	})
+}
diff --git a/internal/platform/wsl_context.go b/internal/platform/wsl_context.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/wsl_context.go
@@ -0,0 +1,121 @@
+package platform
+
+// wsl_context.go — WSL 探测原语的 context 变体（wsl-goal-closure 攻坚 G0）。
+//
+// 旧无 ctx 函数（WSLTargetIdentity/WSLFileMTime/WSLFileMode/WSLChmod，经
+// wslScriptRunner）保留供既有消费者兼容；本文件提供真实可取消的 Context
+// 变体，供 A2 凭据同步等需要「每个同步 I/O 后可查取消」的链路使用。
+//
+// 真实性约束：Context 变体一律经 wslScriptRunnerContext（exec.CommandContext
+// 构造），不做 goroutine 包旧函数的假取消；调用方在取消后必须按失败处理，
+// 不得把「wsl.exe 已被杀」当作「distro 内 Linux 子进程已退出」——Linux 侧
+// 后继写是否发生需 Windows 真机验证（本仓恒标注未真机验证）。
+//
+// 脚本语义与旧函数逐字一致（--exec / quoting / 输出解码 / fail-closed 解析），
+// 差异仅在：入口先查 ctx.Err()，探测经可取消 runner 执行。
+
+import (
+	"context"
+	"os/exec"
+	"runtime"
+	"strconv"
+	"strings"
+)
+
+// wslScriptRunnerContext runs `wsl.exe -d <distro> --exec sh -lc <script>` with
+// a real context (exec.CommandContext). Package var so tests can inject a fake
+// and assert the context actually flows to the runner; the default
+// implementation honors ctx cancellation at Start and kills wsl.exe when the
+// context is done while the process runs.
+var wslScriptRunnerContext = func(ctx context.Context, distro string, script string) ([]byte, error) {
+	cmd := exec.CommandContext(ctx, "wsl.exe", "-d", distro, "--exec", "sh", "-lc", script)
+	// 与无 ctx 版本同策略：GUI 父进程下抑制 console 子系统 exe 闪窗。
+	SuppressConsoleWindow(cmd)
+	return cmd.Output()
+}
+
+// WSLTargetIdentityContext 是 WSLTargetIdentity 的可取消变体：批量探测 distro
+// 默认用户 uid/$HOME/machine-id。ctx 取消时返回 OK=false；语义（不缓存、
+// 解析 fail-closed）与无 ctx 版本一致。
+func WSLTargetIdentityContext(ctx context.Context, distro string) WSLUserIdentity {
+	distro = strings.TrimSpace(distro)
+	if distro == "" {
+		return WSLUserIdentity{}
+	}
+	if err := ctx.Err(); err != nil {
+		return WSLUserIdentity{}
+	}
+	out, err := wslScriptRunnerContext(ctx, distro, wslIdentityScript)
+	if err != nil {
+		return WSLUserIdentity{}
+	}
+	return parseWSLUserIdentity(decodeWSLListOutput(out))
+}
+
+// WSLFileMTimeContext 是 WSLFileMTime 的可取消变体。osName 以参数区分宿主门
+// 的可测核心与原生入口（与 wslFileMTimeForOS 同型：非 windows 恒 (0,false)）。
+func WSLFileMTimeContext(ctx context.Context, distro, linuxPath string) (int64, bool) {
+	return wslFileMTimeContextForOS(ctx, runtime.GOOS, distro, linuxPath)
+}
+
+func wslFileMTimeContextForOS(ctx context.Context, osName, distro, linuxPath string) (int64, bool) {
+	distro = strings.TrimSpace(distro)
+	if distro == "" || osName != "windows" || !strings.HasPrefix(linuxPath, "/") {
+		return 0, false
+	}
+	if err := ctx.Err(); err != nil {
+		return 0, false
+	}
+	out, err := wslScriptRunnerContext(ctx, distro, "stat -c %Y "+wslShSingleQuote(linuxPath))
+	if err != nil {
+		return 0, false
+	}
+	sec, perr := strconv.ParseInt(strings.TrimSpace(strings.Trim(decodeWSLListOutput(out), "\r\x00 ")), 10, 64)
+	if perr != nil || sec < 0 {
+		return 0, false
+	}
+	return sec, true
+}
+
+// WSLFileModeContext 是 WSLFileMode 的可取消变体（stat -c %a 权威读法，
+// 解析与 fail-closed 语义复用 parseWSLStatModeOutput）。osName 可测核心
+// 与 WSLFileMTimeContext 同型（非 windows 恒 false，不触 runner）。
+func WSLFileModeContext(ctx context.Context, distro, linuxPath string) (string, bool) {
+	return wslFileModeContextForOS(ctx, runtime.GOOS, distro, linuxPath)
+}
+
+func wslFileModeContextForOS(ctx context.Context, osName, distro, linuxPath string) (string, bool) {
+	distro = strings.TrimSpace(distro)
+	if distro == "" || osName != "windows" || !strings.HasPrefix(linuxPath, "/") {
+		return "", false
+	}
+	if err := ctx.Err(); err != nil {
+		return "", false
+	}
+	out, err := wslScriptRunnerContext(ctx, distro, "stat -c %a "+wslShSingleQuote(linuxPath))
+	if err != nil {
+		return "", false
+	}
+	return parseWSLStatModeOutput(decodeWSLListOutput(out))
+}
+
+// WSLChmodContext 是 WSLChmod 的可取消变体（distro 内 chmod；mode 校验与
+// 路径转义复用同一 buildWSLChmodScript）。ctx 取消时返回 ctx 错误且不执行
+// 任何 chmod。
+func WSLChmodContext(ctx context.Context, distro string, mode string, linuxPaths ...string) error {
+	distro = strings.TrimSpace(distro)
+	if distro == "" || len(linuxPaths) == 0 {
+		return nil
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	script, err := buildWSLChmodScript(mode, linuxPaths)
+	if err != nil {
+		return err
+	}
+	if _, err := wslScriptRunnerContext(ctx, distro, script); err != nil {
+		return err
+	}
+	return nil
+}
diff --git a/internal/platform/wsl_context_test.go b/internal/platform/wsl_context_test.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/wsl_context_test.go
@@ -0,0 +1,173 @@
+package platform
+
+// wsl_context_test.go — WSL 探测原语 ctx 变体的语义回归（G0）：
+//   - ctx 真实贯通：默认 runner 为 exec.CommandContext，已取消的 ctx 在
+//     Start 前即失败（不执行任何 wsl.exe）；
+//   - 入口 ctx 检查：已取消的 ctx 不触发 runner（各探测面零调用）；
+//   - 解析语义与旧无 ctx 函数一致（fail-closed：输出异常 → 零值/false）。
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestWSLContextRunnerHonorsCanceledContext(t *testing.T) {
+	// 默认生产 runner 必须是 exec.CommandContext：PATH 上放一个真实可执行
+	// 的 wsl.exe 替身（LookPath 必须命中，否则 macOS 上路径错误先于 ctx 检
+	// 查，无法证明取消语义），已取消 ctx 下 Start 直接返回 ctx 错误——
+	// Go 运行时保证不会真正执行替身。
+	fakeBin := t.TempDir()
+	script := filepath.Join(fakeBin, "wsl.exe")
+	if err := os.WriteFile(script, []byte("#!/bin/sh\nsleep 30\n"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("PATH", fakeBin+string(filepath.ListSeparator)+os.Getenv("PATH"))
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	_, err := wslScriptRunnerContext(ctx, "Ubuntu", "id -u")
+	if err == nil {
+		t.Fatal("canceled context must fail the runner")
+	}
+	if !strings.Contains(err.Error(), "context canceled") {
+		t.Fatalf("err = %v, want context cancellation error", err)
+	}
+}
+
+func TestWSLContextProbesCheckCtxBeforeRunner(t *testing.T) {
+	// 已取消 ctx 下各探测入口必须在调用 runner 前短路（runner 计数为零）。
+	orig := wslScriptRunnerContext
+	runnerCalls := 0
+	wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+		runnerCalls++
+		return []byte("1000\n/home/u\nmachine\n"), nil
+	}
+	t.Cleanup(func() { wslScriptRunnerContext = orig })
+
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+
+	if id := WSLTargetIdentityContext(ctx, "Ubuntu"); id.OK {
+		t.Fatal("canceled ctx must yield not-OK identity")
+	}
+	if _, ok := wslFileMTimeContextForOS(ctx, "windows", "Ubuntu", "/home/u/x"); ok {
+		t.Fatal("canceled ctx must yield mtime ok=false")
+	}
+	if _, ok := WSLFileModeContext(ctx, "Ubuntu", "/home/u/x"); ok {
+		t.Fatal("canceled ctx must yield mode ok=false")
+	}
+	if err := WSLChmodContext(ctx, "Ubuntu", "600", "/home/u/x"); err == nil {
+		t.Fatal("canceled ctx must fail chmod")
+	}
+	if runnerCalls != 0 {
+		t.Fatalf("canceled ctx must not invoke the runner, calls=%d", runnerCalls)
+	}
+}
+
+func TestWSLContextProbesParseLikeLegacy(t *testing.T) {
+	orig := wslScriptRunnerContext
+	t.Cleanup(func() { wslScriptRunnerContext = orig })
+	ctx := context.Background()
+
+	t.Run("identity parses uid/home/machine-id", func(t *testing.T) {
+		wslScriptRunnerContext = func(_ context.Context, distro, script string) ([]byte, error) {
+			if distro != "Ubuntu" || !strings.Contains(script, "machine-id") {
+				t.Errorf("unexpected probe: distro=%q script=%q", distro, script)
+			}
+			return []byte("1000\n/home/wslu\nb0bb\n"), nil
+		}
+		id := WSLTargetIdentityContext(ctx, "Ubuntu")
+		if !id.OK || id.UID != "1000" || id.Home != "/home/wslu" || id.MachineID != "b0bb" {
+			t.Fatalf("identity = %+v", id)
+		}
+	})
+
+	t.Run("identity fails closed on malformed output", func(t *testing.T) {
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			return []byte("not-a-uid\nrelative\n"), nil
+		}
+		if id := WSLTargetIdentityContext(ctx, "Ubuntu"); id.OK {
+			t.Fatalf("malformed output must not be OK: %+v", id)
+		}
+	})
+
+	t.Run("mtime parses epoch seconds", func(t *testing.T) {
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			return []byte("1792992000\r\n"), nil
+		}
+		sec, ok := wslFileMTimeContextForOS(ctx, "windows", "Ubuntu", "/home/u/auth.json")
+		if !ok || sec != 1792992000 {
+			t.Fatalf("mtime = (%d, %v)", sec, ok)
+		}
+	})
+
+	t.Run("mtime non-windows host stays false without runner", func(t *testing.T) {
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			t.Fatal("runner must not be called for non-windows host core")
+			return nil, nil
+		}
+		if _, ok := wslFileMTimeContextForOS(ctx, "darwin", "Ubuntu", "/home/u/auth.json"); ok {
+			t.Fatal("non-windows host must yield ok=false")
+		}
+	})
+
+	t.Run("mode parses octal and fails on noise", func(t *testing.T) {
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			return []byte("600\n"), nil
+		}
+		if m, ok := wslFileModeContextForOS(ctx, "windows", "Ubuntu", "/home/u/auth.json"); !ok || m != "600" {
+			t.Fatalf("mode = (%q, %v)", m, ok)
+		}
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			return []byte("rw-r--r--"), nil
+		}
+		if _, ok := wslFileModeContextForOS(ctx, "windows", "Ubuntu", "/home/u/auth.json"); ok {
+			t.Fatal("symbolic mode noise must fail closed")
+		}
+	})
+
+	t.Run("chmod builds same script as legacy", func(t *testing.T) {
+		var gotScript string
+		wslScriptRunnerContext = func(_ context.Context, distro, script string) ([]byte, error) {
+			if distro != "Ubuntu" {
+				t.Errorf("distro = %q", distro)
+			}
+			gotScript = script
+			return nil, nil
+		}
+		if err := WSLChmodContext(ctx, "Ubuntu", "600", "/home/u/a b/'quote'.json"); err != nil {
+			t.Fatal(err)
+		}
+		if gotScript != "chmod 600 '/home/u/a b/'\\''quote'\\''.json'" {
+			t.Fatalf("script = %q, want legacy-identical quoting", gotScript)
+		}
+	})
+
+	t.Run("chmod rejects invalid mode without runner", func(t *testing.T) {
+		runnerHit := false
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			runnerHit = true
+			return nil, nil
+		}
+		if err := WSLChmodContext(ctx, "Ubuntu", "600; rm -rf /", "/home/u/x"); err == nil {
+			t.Fatal("invalid mode must error")
+		}
+		if runnerHit {
+			t.Fatal("invalid mode must not reach the runner")
+		}
+	})
+
+	t.Run("runner error propagates", func(t *testing.T) {
+		wslScriptRunnerContext = func(context.Context, string, string) ([]byte, error) {
+			return nil, context.DeadlineExceeded
+		}
+		ctxDeadline, cancel := context.WithTimeout(ctx, 50*time.Millisecond)
+		defer cancel()
+		if err := WSLChmodContext(ctxDeadline, "Ubuntu", "600", "/home/u/x"); err == nil {
+			t.Fatal("runner error must propagate")
+		}
+	})
+}
diff --git a/internal/platform/move_no_replace.go b/internal/platform/move_no_replace.go
new file mode 100644
--- /dev/null
+++ b/internal/platform/move_no_replace.go
@@ -0,0 +1,83 @@
+package platform
+
+// move_no_replace.go — 原子不替换移动原语（wsl-goal-closure 攻坚 G0）。
+//
+// 语义（attack-contract「统一文件原语/新增窄 MoveNoReplace」）：
+//   - 同文件系统内把 source 原子移动到 destination；
+//   - destination 已存在（文件/目录/空目录）绝不替换，返回 os.ErrExist；
+//     source 与 destination 双方内容/实体均不丢失；
+//   - 文件与目录均支持；不支持（跨设备、OS/文件系统无该原语）返回错误，
+//     绝不降级为「先删目标再 Rename」或「Lstat 后普通 Rename」等危险路径
+//     （Lstat+Rename 存在 TOCTOU 竞态窗口，禁止冒充 no-replace）；
+//   - 成功后 source 不存在、destination 存在——本入口做廉价的落位后验，
+//     后验不成立按错误报告，不虚报成功。
+//
+// 分 OS 实现（build tags，不用 runtime.GOOS 分支）：
+//   - darwin:  unix.RenamexNp(..., RENAME_EXCL)；
+//   - linux:   unix.Renameat2(..., RENAME_NOREPLACE)；
+//   - windows: windows.MoveFileEx 不带 MOVEFILE_REPLACE_EXISTING 标志的原生
+//     移动（目标存在 → ERROR_ALREADY_EXISTS）。
+//   - 其它 OS：显式不支持错误。
+//
+// Windows/UNC 真实行为（含 9P 共享上的目录移动与并发语义）未经真机验证；
+// 交叉编译通过只证明可编译，不证明原子性/错误码形态。
+//
+// 注意：原子 no-replace 不等于原子内容 CAS——目标在调用前后被外部进程改写
+// 不在本原语保证内；调用方须自行复验移动后的实体（契约「外部后改」流程）。
+
+import (
+	"errors"
+	"fmt"
+	"os"
+)
+
+// fmtMoveNoReplaceUnsupported 把底层「无此原语」errno 包装为不支持错误
+// （保留原始 errno 供诊断）。
+func fmtMoveNoReplaceUnsupported(err error) error {
+	return fmt.Errorf("%w: %w", ErrMoveNoReplaceUnsupported, err)
+}
+
+// ErrMoveNoReplaceUnsupported 报告当前 GOOS/文件系统不支持原子 no-replace
+// 移动。调用方必须按「能力不可用」处理：保留 source 与既有目标，不得退化
+// 为覆盖式移动。
+var ErrMoveNoReplaceUnsupported = errors.New("atomic no-replace move unsupported on this GOOS")
+
+// MoveNoReplace 把 source 原子移动到 destination（同文件系统、不替换既有
+// 目标、文件与目录均支持）。destination 已存在时返回可被 errors.Is 判定的
+// os.ErrExist，且双方实体保持原样。
+func MoveNoReplace(source, destination string) error {
+	if source == "" || destination == "" {
+		return fmt.Errorf("move-no-replace requires non-empty paths (source=%q destination=%q)", source, destination)
+	}
+	if source == destination {
+		return fmt.Errorf("move-no-replace source and destination are identical: %q", source)
+	}
+	err := moveNoReplaceOS(source, destination)
+	if err == nil {
+		// 落位后验：成功移动后 source 必须消失、destination 必须存在。
+		if _, serr := os.Lstat(source); serr == nil {
+			return fmt.Errorf("move-no-replace reported success but source still exists: %q", source)
+		} else if !errors.Is(serr, os.ErrNotExist) {
+			return fmt.Errorf("move-no-replace post-check source %q: %w", source, serr)
+		}
+		if _, derr := os.Lstat(destination); derr != nil {
+			return fmt.Errorf("move-no-replace post-check destination %q: %w", destination, derr)
+		}
+		return nil
+	}
+	if errors.Is(err, os.ErrExist) {
+		// no-replace 冲突后验：双方实体必须在场（任何一方丢失都是深度异常，
+		// 不得静默当作普通冲突）。
+		if _, serr := os.Lstat(source); serr != nil {
+			return fmt.Errorf("move-no-replace conflict post-check source %q: %w", source, serr)
+		}
+		if _, derr := os.Lstat(destination); derr != nil {
+			return fmt.Errorf("move-no-replace conflict post-check destination %q: %w", destination, derr)
+		}
+		return err
+	}
+	if errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("move-no-replace source missing: %w", err)
+	}
+	return err
+}
diff --git a/internal/platform/move_no_replace_darwin.go b/internal/platform/move_no_replace_darwin.go
new file mode 100644
