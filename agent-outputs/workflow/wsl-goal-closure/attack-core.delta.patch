+package wslsupply
+
+// intent_store.go — OperationIntent 的持久化与观察登记（攻坚契约「持久化
+// 顺序与清理」）：私有目录 → 唯一 tmp → 完整写 → Sync → Close → 权限检查 →
+// 内容读回验证 → rename 唯一 intent 名 → 最终读回验证。intent 确认可读取后
+// 才允许改变目标。pending 有界扫描本目录，格式损坏记录不自动删除。
+
+import (
+	crand "crypto/rand"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// intentVersion 是 intent 文件格式版本。
+const intentVersion = 1
+
+// pendingScanLimit 是 pending 目录的有界扫描上限（本目录 manifest；不扫
+// 工程/CLI 根）。
+const pendingScanLimit = 512
+
+// formatOpID 生成时间有序 + 随机后缀的操作 ID（并发下唯一；截断纳秒会在
+// 高并发时碰撞——两个操作会共享同一 staging/intent 名）。
+func formatOpID(t time.Time) string {
+	var rnd [4]byte
+	if _, err := crand.Read(rnd[:]); err != nil {
+		// 降级：进程内原子计数器保证唯一（crypto 不可用时）。
+		return fmt.Sprintf("op-%s-%08x-%d", t.UTC().Format("20060102T150405"), uint32(t.Nanosecond()), atomic.AddUint64(&opIDFallback, 1))
+	}
+	return fmt.Sprintf("op-%s-%08x-%x", t.UTC().Format("20060102T150405"), uint32(t.Nanosecond()), rnd[:])
+}
+
+var opIDFallback uint64
+
+// saveIntent 以不可变方式持久化一个操作 intent（全顺序见文件头注释）。
+// 已存在同名 intent 时拒绝（不可变；重试必须换新 OpID）。
+func (s *stateStore) saveIntent(op OperationIntent) error {
+	if op.OpID == "" {
+		return errors.New("intent opID is required")
+	}
+	op.Version = intentVersion
+	b, err := json.MarshalIndent(op, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshal operation intent: %w", err)
+	}
+	b = append(b, '\n')
+	dir := filepath.Join(s.configDir, pendingDirName)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return fmt.Errorf("mkdir pending intent dir: %w", err)
+	}
+	final := pendingIntentPath(s.configDir, op.OpID)
+	if _, serr := os.Lstat(final); serr == nil {
+		return fmt.Errorf("operation intent %s already exists (immutable)", op.OpID)
+	}
+	tmp, err := os.CreateTemp(dir, ".intent-*")
+	if err != nil {
+		return fmt.Errorf("create intent tmp: %w", err)
+	}
+	tmpPath := tmp.Name()
+	cleanup := func() { _ = tmp.Close(); _ = os.Remove(tmpPath) }
+	if _, err := tmp.Write(b); err != nil {
+		cleanup()
+		return fmt.Errorf("write intent tmp: %w", err)
+	}
+	if err := tmp.Sync(); err != nil {
+		cleanup()
+		return fmt.Errorf("sync intent tmp: %w", err)
+	}
+	if err := tmp.Close(); err != nil {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("close intent tmp: %w", err)
+	}
+	if err := os.Chmod(tmpPath, 0o600); err != nil {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("chmod intent tmp: %w", err)
+	}
+	// 权限检查 + 内容读回验证（tmp 层）。
+	if info, serr := os.Stat(tmpPath); serr != nil || info.Mode().Perm() != 0o600 {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("verify intent tmp perms: stat=%v mode=%v", serr, info.Mode().Perm())
+	}
+	if got, rerr := os.ReadFile(tmpPath); rerr != nil || string(got) != string(b) {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("verify intent tmp readback: err=%v equal=%v", rerr, string(got) == string(b))
+	}
+	if err := os.Rename(tmpPath, final); err != nil {
+		_ = os.Remove(tmpPath)
+		return fmt.Errorf("commit operation intent: %w", err)
+	}
+	// 最终读回验证：确认可读取且内容一致。
+	got, err := os.ReadFile(final)
+	if err != nil || string(got) != string(b) {
+		return fmt.Errorf("verify operation intent after commit: err=%v (readback failed; treat as pending)", err)
+	}
+	return nil
+}
+
+// loadIntents 有界扫描 pending 目录返回全部 intent（损坏文件记录不删）。
+func (s *stateStore) loadIntents() (map[string]OperationIntent, error) {
+	dir := filepath.Join(s.configDir, pendingDirName)
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			s.mu.Lock()
+			s.health.Pending = StoreOK
+			s.health.PendingErr = ""
+			s.mu.Unlock()
+			return map[string]OperationIntent{}, nil
+		}
+		s.mu.Lock()
+		s.health.Pending = StoreUnreadable
+		s.health.PendingErr = err.Error()
+		s.mu.Unlock()
+		return nil, fmt.Errorf("scan pending intents: %w", err)
+	}
+	out := map[string]OperationIntent{}
+	corrupt := 0
+	scanned := 0
+	for _, e := range entries {
+		if e.IsDir() || !strings.HasSuffix(e.Name(), ".json") || strings.HasPrefix(e.Name(), ".intent-") {
+			continue
+		}
+		scanned++
+		if scanned > pendingScanLimit {
+			break // 有界：超限停止（已见部分仍返回；health 标记不可判全量）
+		}
+		data, rerr := os.ReadFile(filepath.Join(dir, e.Name()))
+		if rerr != nil {
+			corrupt++
+			continue
+		}
+		var op OperationIntent
+		if jerr := json.Unmarshal(data, &op); jerr != nil || op.OpID == "" || op.Version > intentVersion {
+			corrupt++ // 格式损坏记录不自动删除（冻结处置交 reconcile）
+			continue
+		}
+		out[op.OpID] = op
+	}
+	s.mu.Lock()
+	if corrupt > 0 {
+		s.health.Pending = StoreCorrupt
+		s.health.PendingErr = fmt.Sprintf("%d unreadable/corrupt intent files kept in place", corrupt)
+	} else {
+		s.health.Pending = StoreOK
+		s.health.PendingErr = ""
+	}
+	s.mu.Unlock()
+	return out, nil
+}
+
+// readIntent 读回单个 intent（存在性/可读性判断用）。
+func (s *stateStore) readIntent(opID string) (OperationIntent, bool, error) {
+	data, err := os.ReadFile(pendingIntentPath(s.configDir, opID))
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return OperationIntent{}, false, nil
+		}
+		return OperationIntent{}, false, err
+	}
+	var op OperationIntent
+	if jerr := json.Unmarshal(data, &op); jerr != nil {
+		return OperationIntent{}, true, fmt.Errorf("parse intent %s: %w", opID, jerr)
+	}
+	return op, true, nil
+}
+
+// deleteIntent 删除一个已终结的 intent 文件（清理顺序的靠后步骤）。
+func (s *stateStore) deleteIntent(opID string) error {
+	if err := os.Remove(pendingIntentPath(s.configDir, opID)); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("delete intent %s: %w", opID, err)
+	}
+	return nil
+}
+
+// observationRegistry 是进程内操作观察的锁内注册表（独立于 durable 清单；
+// 深复制读写；重启由 intent+目标重建）。
+type observationRegistry struct {
+	mu     sync.Mutex
+	latest map[string]OperationObservation // targetKey|unit → 最新观察
+	byOp   map[string]OperationObservation // opID → 最新观察
+}
+
+func newObservationRegistry() *observationRegistry {
+	return &observationRegistry{latest: map[string]OperationObservation{}, byOp: map[string]OperationObservation{}}
+}
+
+// record 深复制写入一条观察。
+func (r *observationRegistry) record(ob OperationObservation) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.byOp[ob.OpID] = ob
+	if ob.Unit != "" && ob.TargetKey != "" {
+		key := obUnitKey(ob.TargetKey, ob.Unit)
+		if prev, ok := r.latest[key]; !ok || !prev.At.After(ob.At) {
+			r.latest[key] = ob
+		}
+	}
+}
+
+// latestForUnit 返回目标+单元的最新观察（深复制）。
+func (r *observationRegistry) latestForUnit(targetKey string, unit UnitID) (OperationObservation, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ob, ok := r.latest[obUnitKey(targetKey, unit)]
+	return ob, ok
+}
+
+// forOp 返回某操作的观察（深复制）。
+func (r *observationRegistry) forOp(opID string) (OperationObservation, bool) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	ob, ok := r.byOp[opID]
+	return ob, ok
+}
+
+// snapshot 返回全部观察的深复制（GetStatus 合并用）。
+func (r *observationRegistry) snapshot() []OperationObservation {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	out := make([]OperationObservation, 0, len(r.byOp))
+	for _, ob := range r.byOp {
+		out = append(out, ob)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].At.Before(out[j].At) })
+	return out
+}
+
+func obUnitKey(targetKey string, unit UnitID) string { return targetKey + "|" + string(unit) }
+
+// recordObservation 是协调器侧入口（同步写注册表）。
+func (c *Coordinator) recordObservation(targetKey string, opID string, unit UnitID, effect OpEffect, reg OpRegistration, recovery OpRecovery, errCode, detail string) {
+	c.observations.record(OperationObservation{
+		OpID: opID, TargetKey: targetKey, Unit: unit, Effect: effect, Registration: reg, Recovery: recovery,
+		ErrorCode: errCode, Detail: detail, At: time.Now(),
+	})
+}
diff --git a/internal/wslsupply/legacy_assess.go b/internal/wslsupply/legacy_assess.go
new file mode 100644
index 0000000..ba00d5e
--- /dev/null
+++ b/internal/wslsupply/legacy_assess.go
@@ -0,0 +1,241 @@
+package wslsupply
+
+// legacy_assess.go — PR01 攻坚重做：旧指纹与实际固定视觉文件的当次资格核验
+//（attack-contract「PR01：legacy 核验与用户解除」）。旧公式指纹
+// LegacyGeneration 与当前目标实际文件共同裁决；A 发布→只检查 B→升级时 A 阻、
+// B 不误伤；无归属/unknown 保真，不授写权、不全局误阻所有 WSL；手动处理后
+// 可经 ConfirmLegacyVisionAbsent 真实解除。
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// legacyGenerationOf 用旧公式（sha256(machine-id + "|" + uid + "|" + home)，无
+// distro）由同一次 Identity 探测导出旧代指纹；machine-id 缺失时仍 unknown。
+// 不重新走 cached Home 探测。
+func legacyGenerationOf(machineID, uid, home string) string {
+	if machineID == "" {
+		return GenerationUnknown
+	}
+	sum := sha256.Sum256([]byte(machineID + "|" + uid + "|" + home))
+	return hexEncode(sum[:])
+}
+
+// SensitiveAssessment 是一次敏感消费资格核验的结论（脱敏：无 hash/正文）。
+type SensitiveAssessment struct {
+	Unit        UnitID
+	Consumption Consumption
+	// RiskPending 表示存在需要用户处理的旧副本/未决操作事实。
+	RiskPending bool
+	// Reason 是结构化原因（状态页/闸门错误文案用，不含路径正文）。
+	Reason string
+	// Path 提示用户处理的固定文件名（不含任何内容）。
+	Path string
+}
+
+// AssessSensitiveConsumption 在 effect/启动门运行：只核验当前目标固定视觉
+// 清单路径，不扫所有 distro，不返回 hash/正文。runFacts 携带本次运行的结果
+// 事实（nil 表示尚未运行——按持久事实判定）。
+func (c *Coordinator) AssessSensitiveConsumption(ctx context.Context, target TargetRef, unit UnitID, res *UnitResult) SensitiveAssessment {
+	out := SensitiveAssessment{Unit: unit, Consumption: ConsumptionUnknown}
+	if unit != UnitSharedVisionExport {
+		// 其它敏感单元（未来）无 legacy 面；按当前登记与本次结果判定。
+		return c.assessFromFacts(target, unit, res)
+	}
+	// 1) 未决持久操作优先（真实 fact，不是 LastOutcome 字符串）。
+	if opID, pending := c.PendingSensitiveOperation(target.Distro, unit); pending {
+		out.RiskPending = true
+		out.Consumption = ConsumptionUnsafe
+		out.Reason = "pending-operation:" + opID
+		out.Path = VisionExportFile
+		return out
+	}
+	stCopy := c.state.load()
+	// 2) 本次运行结果事实（写已发生/未知/敏感资格缺失不放行）——登记面
+	//（当前代受管副本）优先裁决；无受管登记时不立即放行，先经 3/4 的持久
+	// 线索面（legacy evidence）再下结论。
+	resFailDetail := ""
+	if res != nil && (res.Outcome == UnitFailed || res.Outcome == UnitBlocked) {
+		if entrySensitiveCopyPossible(stCopy.entryFor(unit, target.Generation)) {
+			out.RiskPending = true
+			out.Consumption = ConsumptionUnsafe
+			out.Reason = "run-failed-with-managed-copy:" + res.Detail
+			return out
+		}
+		resFailDetail = res.Detail
+	}
+	visionPath := filepath.Join(target.UNCRoot, VisionExportFile)
+	data, err := os.ReadFile(visionPath)
+	_ = data
+	fileAbsent := errors.Is(err, os.ErrNotExist)
+	st := stCopy
+	entry := st.entryFor(unit, target.Generation)
+	// 3) 当前代受管登记。
+	if entrySensitiveCopyPossible(entry) {
+		switch {
+		case fileAbsent:
+			out.Consumption = ConsumptionAbsent
+			out.Reason = "managed-copy-externally-deleted"
+		case err != nil:
+			out.Consumption = ConsumptionUnsafe
+			out.RiskPending = true
+			out.Reason = "managed-copy-unreadable"
+		default:
+			// 副本在：权限可证 0600 → safe；否则 unknown（收紧复验由运行路径
+			// 完成；评估面不主动改权限）。
+			linuxPath := target.LinuxRoot + "/" + VisionExportFile
+			if mode, ok := c.probes.StatMode(ctx, target.Distro, linuxPath); ok && mode == "600" {
+				out.Consumption = ConsumptionSafe
+			} else {
+				out.Consumption = ConsumptionUnknown
+				out.RiskPending = true
+				out.Reason = "managed-copy-perms-unverified"
+			}
+			out.Path = VisionExportFile
+		}
+		return out
+	}
+	// 4) LegacyEvidence 逐目标核验（旧指纹 × 实际文件）。
+	targetKey := targetKeyOf(target)
+	legacyGen := target.LegacyGeneration
+	for _, ev := range st.LegacyEvidence {
+		if ev.Unit != unit || ev.TerminalRiskCleared() {
+			continue
+		}
+		if ev.EntryLastHash == "" && !ev.LowTrust {
+			// 单有 Consented 无写基准：不伪造已发布事实（consent-only 线索不
+			// 重建受管副本风险）。
+			continue
+		}
+		if d, resolved := ev.Resolved[targetKey]; resolved {
+			_ = d
+			continue // 该完整身份已核验处置
+		}
+		fingerprintMatch := ev.Fingerprint != "" && legacyGen != GenerationUnknown && legacyGen != "" && ev.Fingerprint == legacyGen
+		topClueMatch := ev.TopDistro != "" && ev.TopDistro == target.Distro
+		switch {
+		case fileAbsent:
+			// 本次无该消费副本：放行本目标，仍保留全局 unresolved evidence。
+			out.Consumption = ConsumptionAbsent
+			out.Reason = "legacy-clue-present-copy-absent"
+		case err != nil:
+			out.Consumption = ConsumptionUnknown
+			out.RiskPending = true
+			out.Reason = "legacy-clue-file-unreadable"
+		case fingerprintMatch:
+			out.Consumption = ConsumptionUnsafe
+			out.RiskPending = true
+			out.Reason = "legacy-fingerprint-match"
+			out.Path = VisionExportFile
+		case topClueMatch && ev.LowTrust:
+			// v2 派生低可信线索 + 文件在：要求确认，不自动写/删。
+			out.Consumption = ConsumptionUnknown
+			out.RiskPending = true
+			out.Reason = "legacy-v2-clue-file-present"
+			out.Path = VisionExportFile
+		default:
+			// 旧指纹不同、文件可读且不同、无其它关联线索：按用户自有保留，
+			// 不误标（只对当前路径成立）。
+			if out.Consumption == ConsumptionUnknown {
+				out.Consumption = ConsumptionUserOwned
+				out.Reason = "unrelated-file-user-owned"
+			}
+		}
+		return out
+	}
+	// 5) 无任何线索：普通未受管（有本次失败时归因到运行明细，普通可选失败
+	// 不误阻）。
+	if err != nil && !fileAbsent {
+		out.Consumption = ConsumptionUnknown
+		out.Reason = "file-unreadable-no-history"
+		return out
+	}
+	out.Consumption = ConsumptionAbsent
+	if resFailDetail != "" {
+		out.Reason = "no-copy-history:" + resFailDetail
+	} else {
+		out.Reason = "never-managed"
+	}
+	return out
+}
+
+// AssessWSLSensitiveConsumption 是 App/启动闸门消费的入口：解析目标后按
+// 当前目标固定路径核验（无法解析目标 → unknown，不猜默认 /home/u）。
+func (c *Coordinator) AssessWSLSensitiveConsumption(ctx context.Context, distro string, cli CLI, unit UnitID, res *UnitResult) SensitiveAssessment {
+	target, err := c.ResolveTarget(ctx, distro, cli)
+	if err != nil {
+		// 未解析可信 Home/路径：不猜默认 /home/u；逐目标文件核验不可达时退回
+		// 持久事实面（pending intent / 受管副本可能 / legacy 线索）——已知风险
+		// 不能因探测失败消失；确无线索的普通目标不误阻。
+		if opID, pending := c.PendingSensitiveOperation(distro, unit); pending {
+			return SensitiveAssessment{Unit: unit, Consumption: ConsumptionUnsafe,
+				RiskPending: true, Reason: "pending-operation:" + opID, Path: VisionExportFile}
+		}
+		if c.SensitiveCopyPending(distro, unit) || c.LegacySensitiveCopyPending(distro) {
+			return SensitiveAssessment{Unit: unit, Consumption: ConsumptionUnknown,
+				RiskPending: true, Reason: "target-unresolved-with-copy-history", Path: VisionExportFile}
+		}
+		return SensitiveAssessment{Unit: unit, Consumption: ConsumptionAbsent,
+			Reason: "target-unresolved-no-history"}
+	}
+	return c.AssessSensitiveConsumption(ctx, target, unit, res)
+}
+
+// assessFromFacts 是非视觉敏感单元的通用评估（当前只有视觉单元，预留）。
+func (c *Coordinator) assessFromFacts(target TargetRef, unit UnitID, res *UnitResult) SensitiveAssessment {
+	out := SensitiveAssessment{Unit: unit, Consumption: ConsumptionNotApplicable}
+	return out
+}
+
+// ConfirmLegacyVisionAbsent 是「手动处理后确认当前目标 absent」的真实解除
+// 入口：复用目标解析与现场核验，持久记录该完整身份/路径处置；保存失败返回
+// 未持久确认（不删除原 evidence）。
+func (c *Coordinator) ConfirmLegacyVisionAbsent(ctx context.Context, distro string) error {
+	if err := ctx.Err(); err != nil {
+		return fmt.Errorf("confirm legacy vision absent: %w", err)
+	}
+	target, err := c.ResolveTarget(ctx, distro, CLICommon)
+	if err != nil {
+		return fmt.Errorf("resolve wsl supply target: %w", err)
+	}
+	visionPath := filepath.Join(target.UNCRoot, VisionExportFile)
+	if _, serr := os.Lstat(visionPath); serr == nil {
+		return fmt.Errorf("WSL 目标 %s（Home %s）仍存在 %s：请先在 WSL 内手动处理该文件后重试；当前状态仍是未撤回", distro, target.Home, "~/.agents/"+VisionExportFile)
+	} else if !errors.Is(serr, os.ErrNotExist) {
+		return fmt.Errorf("无法确认 WSL 目标 %s 的 %s 状态（%v）；不视为已确认 absent", distro, VisionExportFile, serr)
+	}
+	targetKey := targetKeyOf(target)
+	err = c.state.mutate(func(st *StateFile) {
+		changed := false
+		for i := range st.LegacyEvidence {
+			ev := &st.LegacyEvidence[i]
+			if ev.Unit != UnitSharedVisionExport {
+				continue
+			}
+			if ev.Resolved == nil {
+				ev.Resolved = map[string]string{}
+			}
+			if _, ok := ev.Resolved[targetKey]; !ok {
+				ev.Resolved[targetKey] = "absent-confirmed"
+				changed = true
+			}
+		}
+		_ = changed
+	})
+	if err != nil {
+		// 保存失败：返回未持久确认，不删除原 evidence。
+		return fmt.Errorf("确认已核验但未持久化（原线索保留；修复存储后重试）: %w", err)
+	}
+	return nil
+}
+
+// LegacyEvidenceSnapshot 返回证据面（诊断/状态页；脱敏不含 hash 值本身——
+// Resolved/指纹存在性可展示）。
+func (c *Coordinator) LegacyEvidenceSnapshot() []LegacyEvidenceEntry {
+	return c.state.load().LegacyEvidence
+}
diff --git a/internal/wslsupply/legacy_evidence_test.go b/internal/wslsupply/legacy_evidence_test.go
new file mode 100644
index 0000000..b6e0e3e
--- /dev/null
+++ b/internal/wslsupply/legacy_evidence_test.go
@@ -0,0 +1,261 @@
+package wslsupply
+
+// legacy_evidence_test.go — 攻坚契约 PR01：v1 证据归属与逐目标核验的公开
+// 入口回归（phase-rereview-repro.go 的 LEGACY/LEGACY_MISMATCH 反例转正）：
+// A 发布→只检查 B→升级 → A 阻（指纹匹配 + 文件在）、B 不凭顶层线索继承
+// 风险；clone 同指纹都是候选、逐目标解除；unknown/无归属保真不全局误阻；
+// Detached/确切 withdrawn/consent-only 不伪造风险；手动处理后确认 absent
+// 是真实解除路线。
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"amagi-codebox/internal/platform"
+)
+
+// legacyABEnv 构造 A/B 双目标环境（同 machine-id、不同 distro 名——旧公式
+// 指纹相同=克隆候选；新代指纹含 distro 各自独立）。
+type legacyABEnv struct {
+	c        *Coordinator
+	roots    map[string]string
+	visionFn func(distro string) string
+}
+
+func newLegacyABEnv(t *testing.T) *legacyABEnv {
+	t.Helper()
+	roots := map[string]string{"A": t.TempDir(), "B": t.TempDir()}
+	e := &legacyABEnv{c: nil, roots: roots, visionFn: nil}
+	e.visionFn = func(distro string) string {
+		return filepath.Join(roots[distro], "home/u/.agents", VisionExportFile)
+	}
+	e.c = NewCoordinator(t.TempDir(), nil, Probes{
+		Identity: func(context.Context, string) platform.WSLUserIdentity {
+			return platform.WSLUserIdentity{UID: "1000", Home: "/home/u", MachineID: "m-clone", OK: true}
+		},
+		ToUNC: func(distro, linuxPath string) string {
+			return filepath.Join(roots[distro], filepath.FromSlash(trimLeadingSlash(linuxPath)))
+		},
+		Chmod: func(context.Context, string, string, ...string) error { return nil },
+		StatMode: func(_ context.Context, _, linuxPath string) (string, bool) {
+			// 真实文件权限回读（0600 副本健康）。
+			for _, root := range roots {
+				p := filepath.Join(root, filepath.FromSlash(trimLeadingSlash(linuxPath)))
+				if info, err := os.Stat(p); err == nil && info.Mode().IsRegular() {
+					return permStringOf(info), true
+				}
+			}
+			return "", false
+		},
+	})
+	return e
+}
+
+// writeLegacyV1TopB 写一份 v1 清单：entry 旧指纹 = 克隆指纹（A/B 共享），
+// 顶层线索 = B（升级前最后检查的是 B——原反例的归属陷阱）。
+func (e *legacyABEnv) writeLegacyV1TopB(t *testing.T, entryOutcome string, written bool) {
+	t.Helper()
+	gen := legacyGenerationOf("m-clone", "1000", "/home/u")
+	entry := StateEntry{
+		Unit: UnitSharedVisionExport, Policy: PolicyManagedNamespace,
+		Generation: gen, Consented: true, LastOutcome: entryOutcome,
+	}
+	if written {
+		entry.LastWrittenHash = hexHash([]byte(legacyCloneCopy))
+	}
+	b, err := json.Marshal(StateFile{
+		SchemaVersion: 1, Generation: gen, Distro: "B", Home: "/home/u",
+		Units: []StateEntry{entry},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Dir(e.c.state.path), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(e.c.state.path, b, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+const legacyCloneCopy = `{"version":1,"api_key":"CLONE-OLD-COPY"}`
+
+// TestAttackLegacyABMismatchBlocksOwnerNotChecker：A 发布→只检查 B→升级 →
+// A 待处理（指纹匹配 + 文件在）、B 放行（指纹不匹配 + 文件不在）；B 的顶层
+// 线索不得让它继承 A 的风险。
+func TestAttackLegacyABMismatchBlocksOwnerNotChecker(t *testing.T) {
+	e := newLegacyABEnv(t)
+	e.writeLegacyV1TopB(t, "written", true)
+	// A 上留有旧副本；B 干净。
+	if err := os.MkdirAll(filepath.Dir(e.visionFn("A")), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(e.visionFn("A"), []byte(legacyCloneCopy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	src := &stubSharedSource{vision: func() ([]byte, error) { return nil, os.ErrNotExist }, modality: nil}
+	e.c.RegisterProjection(NewVisionExportAdapter(src))
+	// A：指纹匹配 + 文件在 → 阻断（待处理）。
+	aAssess := e.c.AssessWSLSensitiveConsumption(context.Background(), "A", CLICommon, UnitSharedVisionExport, nil)
+	if aAssess.Consumption != ConsumptionUnsafe || !aAssess.RiskPending {
+		t.Fatalf("A must be blocked (fingerprint match + file present), got %+v", aAssess)
+	}
+	// B：指纹不匹配 + 文件不在 → 放行（本目标）；顶层线索是 B 也不继承。
+	bAssess := e.c.AssessWSLSensitiveConsumption(context.Background(), "B", CLICommon, UnitSharedVisionExport, nil)
+	if bAssess.Consumption != ConsumptionAbsent || bAssess.RiskPending {
+		t.Fatalf("B must pass (fingerprint mismatch + file absent; top-clue must not inherit), got %+v", bAssess)
+	}
+	// 公开启动面（root 包 TestWSLSharedGate* 钉 5CLI 桌面/remote/restart 面）。
+	// 手动处理 A 的文件后确认 absent → A 解除（真实解除路线）。
+	if err := os.Remove(e.visionFn("A")); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.c.ConfirmLegacyVisionAbsent(context.Background(), "A"); err != nil {
+		t.Fatalf("confirm absent must succeed after manual cleanup: %v", err)
+	}
+	aAfter := e.c.AssessWSLSensitiveConsumption(context.Background(), "A", CLICommon, UnitSharedVisionExport, nil)
+	if aAfter.Consumption != ConsumptionAbsent || aAfter.RiskPending {
+		t.Fatalf("A must be released after confirmed absent, got %+v", aAfter)
+	}
+}
+
+// TestAttackLegacyCloneBothCandidatesResolvedPerTarget：相同旧指纹的克隆
+// A/B 都是候选：A 解除后 B 证据仍在（逐目标解除，不互相解除、不授写权）。
+func TestAttackLegacyCloneBothCandidatesResolvedPerTarget(t *testing.T) {
+	e := newLegacyABEnv(t)
+	e.writeLegacyV1TopB(t, "written", true)
+	// 两个克隆目标都留有旧副本。
+	for _, d := range []string{"A", "B"} {
+		if err := os.MkdirAll(filepath.Dir(e.visionFn(d)), 0o700); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(e.visionFn(d), []byte(legacyCloneCopy), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, d := range []string{"A", "B"} {
+		assess := e.c.AssessWSLSensitiveConsumption(context.Background(), d, CLICommon, UnitSharedVisionExport, nil)
+		if assess.Consumption != ConsumptionUnsafe || !assess.RiskPending {
+			t.Fatalf("%s (clone) must be a candidate owner, got %+v", d, assess)
+		}
+	}
+	// A 手动处理 + 确认 absent → A 解除；B 风险仍在。
+	if err := os.Remove(e.visionFn("A")); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.c.ConfirmLegacyVisionAbsent(context.Background(), "A"); err != nil {
+		t.Fatal(err)
+	}
+	aAssess := e.c.AssessWSLSensitiveConsumption(context.Background(), "A", CLICommon, UnitSharedVisionExport, nil)
+	bAssess := e.c.AssessWSLSensitiveConsumption(context.Background(), "B", CLICommon, UnitSharedVisionExport, nil)
+	if aAssess.RiskPending {
+		t.Fatalf("A must be released per-target, got %+v", aAssess)
+	}
+	if !bAssess.RiskPending {
+		t.Fatalf("B evidence must survive A's resolution (per-target), got %+v", bAssess)
+	}
+}
+
+// TestAttackLegacyTerminalStatesNoFabricatedRisk：detached / 确切 withdrawn /
+// consent-only（无写基准）不重建受管风险。
+func TestAttackLegacyTerminalStatesNoFabricatedRisk(t *testing.T) {
+	cases := []struct {
+		name    string
+		outcome string
+		written bool
+	}{
+		{"detached clears risk", "detached", true},
+		{"exact withdrawn clears risk", "withdrawn", true},
+		{"withdrawn-already-absent clears risk", "withdrawn-already-absent", true},
+		{"consent-only never fabricated risk", "consented", false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			e := newLegacyABEnv(t)
+			e.writeLegacyV1TopB(t, tc.outcome, tc.written)
+			if err := os.MkdirAll(filepath.Dir(e.visionFn("A")), 0o700); err != nil {
+				t.Fatal(err)
+			}
+			if err := os.WriteFile(e.visionFn("A"), []byte(legacyCloneCopy), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			assess := e.c.AssessWSLSensitiveConsumption(context.Background(), "A", CLICommon, UnitSharedVisionExport, nil)
+			if assess.RiskPending {
+				t.Fatalf("terminal state must not fabricate managed risk, got %+v", assess)
+			}
+		})
+	}
+}
+
+// TestAttackLegacyConfirmAbsentBoundaries：文件仍在时确认失败（精确指引、
+// 状态仍是未撤回）；文件 absent 时确认成功并持久化；确认不删除原证据。
+func TestAttackLegacyConfirmAbsentBoundaries(t *testing.T) {
+	e := newLegacyABEnv(t)
+	e.writeLegacyV1TopB(t, "written", true)
+	if err := os.MkdirAll(filepath.Dir(e.visionFn("A")), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(e.visionFn("A"), []byte(legacyCloneCopy), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	// 文件仍在 → 拒绝确认，给出精确 distro/Home/文件名。
+	err := e.c.ConfirmLegacyVisionAbsent(context.Background(), "A")
+	if err == nil {
+		t.Fatal("confirm must fail while the file is present")
+	}
+	if !containsAll(err.Error(), "A", "home/u", VisionExportFile) {
+		t.Fatalf("error must carry exact distro/home/file, got %v", err)
+	}
+	// 原证据保留。
+	if ev := e.c.LegacyEvidenceSnapshot(); len(ev) == 0 {
+		t.Fatal("evidence must be retained on failed confirm")
+	}
+	// 处理后确认成功并持久化（重启后仍解除）。
+	if err := os.Remove(e.visionFn("A")); err != nil {
+		t.Fatal(err)
+	}
+	if err := e.c.ConfirmLegacyVisionAbsent(context.Background(), "A"); err != nil {
+		t.Fatal(err)
+	}
+	st := e.c.state.load()
+	if len(st.LegacyEvidence) == 0 {
+		t.Fatal("evidence entries must be kept (保真) after resolution")
+	}
+	resolvedFound := false
+	for _, ev := range st.LegacyEvidence {
+		for _, d := range ev.Resolved {
+			if d == "absent-confirmed" {
+				resolvedFound = true
+			}
+		}
+	}
+	if !resolvedFound {
+		t.Fatal("resolution must be persisted per target")
+	}
+}
+
+func containsAll(s string, subs ...string) bool {
+	for _, sub := range subs {
+		if !strings.Contains(s, sub) {
+			return false
+		}
+	}
+	return true
+}
+
+func trimLeadingSlash(p string) string {
+	for len(p) > 0 && p[0] == '/' {
+		p = p[1:]
+	}
+	return p
+}
+
+func permStringOf(info os.FileInfo) string {
+	const digits = "01234567"
+	perm := info.Mode().Perm()
+	return string([]byte{digits[perm>>6&7], digits[perm>>3&7], digits[perm&7]})
+}
