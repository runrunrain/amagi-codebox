+func (f *fakeProbes) setMode(linuxPath, mode string) {
+	f.mu.Lock()
+	if f.modes == nil {
+		f.modes = map[string]string{}
+	}
+	f.modes[linuxPath] = mode
+	f.mu.Unlock()
